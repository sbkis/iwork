_iwork() {
  local -a repos folders projects
  local cmd="${words[2]:-}"
  local folder="" word="" sub=""

  if (( CURRENT == 2 )); then
    _values 'command' \
      'add-repo[add repos to an existing worktree folder]' \
      'rm[remove worktrees from a task, or the whole task]' \
      'park[move the current repo branch into a worktree folder]' \
      'list[list worktree folders]' \
      'cd[cd into a worktree folder or switch to its tmux window]' \
      'claude[open the task tmux window and run claude]' \
      'codex[open the task tmux window and run codex]' \
      'project[manage the memory shared across a project'\''s tasks]' \
      'todo[capture something that needs doing, but not in this PR]' \
      'log[append one line to the project log]' \
      'decided[record a decision in the project log]' \
      'done[close a captured todo by id]' \
      'drop[abandon a captured todo by id]' \
      'init[create the iwork config file]' \
      'install-hooks[install Claude Code status hooks]' \
      '--no-tmux[skip tmux window handling]' \
      '--no-context[skip writing task context files]' \
      '--detach[create the task window without switching to it]' \
      '--big[give the task its own tmux session with a window per repo]' \
      '--from[start the new branches from this task or branch]' \
      '--completion[print shell integration]'
    return 0
  fi

  # -p takes a project name wherever it appears.
  if [[ "${words[CURRENT-1]:-}" == "-p" || "${words[CURRENT-1]:-}" == "--project" ]]; then
    projects=("${(@f)$("$_iwork_bin" --complete-projects "$PREFIX" 2>/dev/null)}")
    _describe -t projects 'project' projects
    return 0
  fi

  case "$cmd" in
    project)
      sub="${words[3]:-}"
      if (( CURRENT == 3 )); then
        _values 'subcommand' \
          'list[list projects]' \
          'show[print goal, open todos, recent log and live tasks]' \
          'grep[search the project memory]' \
          'cat[print one file from the project memory]' \
          'add[attach an existing task to a project]' \
          'rm[detach a task, keeping the project memory]' \
          'delete[delete a project and its memory]'
        return 0
      fi
      case "$sub" in
        show|grep|cat|delete)
          if (( CURRENT == 4 )); then
            projects=("${(@f)$("$_iwork_bin" --complete-projects "$PREFIX" 2>/dev/null)}")
            _describe -t projects 'project' projects
          fi
          ;;
        add|rm)
          if (( CURRENT == 4 )); then
            projects=("${(@f)$("$_iwork_bin" --complete-projects "$PREFIX" 2>/dev/null)}")
            _describe -t projects 'project' projects
          elif (( CURRENT == 5 )); then
            folders=("${(@f)$("$_iwork_bin" --complete-worktree-folders "$PREFIX" 2>/dev/null)}")
            _describe -t folders 'worktree folder' folders
          fi
          ;;
      esac
      return 0
      ;;
    todo|decided|done|drop)
      _values 'option' '-p[project to write to]'
      return 0
      ;;
    log)
      _values 'option' \
        '-p[project to write to]' \
        '--decision[record a decision]' \
        '--shipped[record something shipped]' \
        '--note[record a plain note]'
      return 0
      ;;
    cd|claude|codex)
      if (( CURRENT == 3 )); then
        folders=("${(@f)$("$_iwork_bin" --complete-worktree-folders "$PREFIX" 2>/dev/null)}")
        _describe -t folders 'worktree folder' folders
      fi
      return 0
      ;;
    add-repo|rm)
      if (( CURRENT == 3 )); then
        folders=("${(@f)$("$_iwork_bin" --complete-worktree-folders "$PREFIX" 2>/dev/null)}")
        _describe -t folders 'worktree folder' folders
        return 0
      fi
      ;;
    park)
      return 0
      ;;
    list)
      return 0
      ;;
    init)
      return 0
      ;;
    install-hooks)
      return 0
      ;;
  esac

  if [[ "${words[CURRENT-1]}" == "--from" ]]; then
    folders=("${(@f)$("$_iwork_bin" --complete-worktree-folders "$PREFIX" 2>/dev/null)}")
    _describe -t folders 'task to build on' folders
    return 0
  fi

  if [[ "$cmd" == "rm" ]]; then
    for word in "${words[@]:2}"; do
      case "$word" in
        -*) ;;
        *) folder="$word"; break ;;
      esac
    done

    if (( ${words[(I)-r]} > 0 )); then
      if [[ -n "$folder" ]]; then
        repos=("${(@f)$("$_iwork_bin" --complete-task-worktrees "$folder" "$PREFIX" 2>/dev/null)}")
      else
        repos=("${(@f)$("$_iwork_bin" --complete-repos "$PREFIX" 2>/dev/null)}")
      fi
      _describe -t repos 'repo' repos
    else
      _values 'option' '-r[repos whose worktrees to remove]' '-f[force removal, skip prompt]'
    fi
    return 0
  fi

  if (( CURRENT == 3 )); then
    _values 'option' \
      '-r[repos to create worktrees for]' \
      '-p[project this task is part of]'
    return 0
  fi

  if (( ${words[(I)-r]} <= CURRENT )); then
    repos=("${(@f)$("$_iwork_bin" --complete-repos "$PREFIX" 2>/dev/null)}")
    _describe -t repos 'repo' repos
  fi
}

