      "$cmd" "$@"
      ;;
    *)
      command "$_iwork_bin" ${notmux:+--no-tmux} "$@"
      ;;
  esac
}

_iwork() {
  local cur prev seen_r i repos folders folder cmd projects sub
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev=""
  cmd="${COMP_WORDS[1]:-}"

  if (( COMP_CWORD > 0 )); then
    prev="${COMP_WORDS[COMP_CWORD-1]}"
  fi

  # -p takes a project name wherever it appears.
  if [[ "$prev" == "-p" || "$prev" == "--project" ]]; then
    projects="$("$_iwork_bin" --complete-projects "$cur" 2>/dev/null)" || return 0
    COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
    return 0
  fi

  case "$cmd" in
    project)
      sub="${COMP_WORDS[2]:-}"
      if (( COMP_CWORD == 2 )); then
        COMPREPLY=( $(compgen -W "list show grep cat add rm delete" -- "$cur") )
        return 0
      fi
      case "$sub" in
        show|grep|cat|delete)
          if (( COMP_CWORD == 3 )); then
            projects="$("$_iwork_bin" --complete-projects "$cur" 2>/dev/null)" || return 0
            COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
          fi
          ;;
        add|rm)
          if (( COMP_CWORD == 3 )); then
            projects="$("$_iwork_bin" --complete-projects "$cur" 2>/dev/null)" || return 0
            COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
          elif (( COMP_CWORD == 4 )); then
            folders="$("$_iwork_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
            COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
          fi
          ;;
      esac
      return 0
      ;;
    todo|log|decided|done|drop)
      if [[ "$cur" == -* ]]; then
        if [[ "$cmd" == "log" ]]; then
          COMPREPLY=( $(compgen -W "-p --project --decision --shipped --note" -- "$cur") )
        else
          COMPREPLY=( $(compgen -W "-p --project" -- "$cur") )
        fi
      fi
      return 0
      ;;
    cd|claude|codex)
      if (( COMP_CWORD == 2 )); then
        folders="$("$_iwork_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
        COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
      fi
      return 0
      ;;
    add-repo|rm)
      if (( COMP_CWORD == 2 )); then
        folders="$("$_iwork_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
        COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
        return 0
      fi
      ;;
    park)
      return 0
      ;;
    list)
      return 0
      ;;
    init)
      return 0
      ;;
    install-hooks)
      return 0
      ;;
  esac

  # --from takes an existing task (or a branch, which we cannot complete)
  if [[ "$prev" == "--from" ]]; then
    folders="$("$_iwork_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
    COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
    return 0
  fi

  seen_r=""
  for ((i = 1; i < COMP_CWORD; i++)); do
    if [[ "${COMP_WORDS[i]}" == "-r" ]]; then
      seen_r=1
      break
    fi
  done

  if [[ "$prev" == "-r" || -n "$seen_r" ]]; then
    # For rm, only the repos that actually have a worktree in the task.
    if [[ "$cmd" == "rm" ]]; then
      folder=""
      for ((i = 2; i < COMP_CWORD; i++)); do
        case "${COMP_WORDS[i]}" in
          -*) ;;
          *) folder="${COMP_WORDS[i]}"; break ;;
        esac
      done
    fi

    if [[ "$cmd" == "rm" && -n "$folder" ]]; then
      repos="$("$_iwork_bin" --complete-task-worktrees "$folder" "$cur" 2>/dev/null)" || return 0
    else
      repos="$("$_iwork_bin" --complete-repos "$cur" 2>/dev/null)" || return 0
    fi
    COMPREPLY=( $(compgen -W "$repos" -- "$cur") )
    return 0
  fi

  if (( COMP_CWORD == 1 )); then
    COMPREPLY=( $(compgen -W "add-repo rm park list cd claude codex project todo log decided done drop init install-hooks --no-tmux --no-context --detach --big --from -h --help --completion" -- "$cur") )
    return 0
  fi

  if [[ "$cur" == -* ]]; then
    if [[ "$cmd" == "rm" ]]; then
      COMPREPLY=( $(compgen -W "-r -f" -- "$cur") )
    elif [[ "$cmd" == "park" ]]; then
      COMPREPLY=( $(compgen -W "-p --project" -- "$cur") )
    else
      COMPREPLY=( $(compgen -W "-r -p --project --from -h --help --completion --no-tmux --no-context --detach --big" -- "$cur") )
    fi
    return 0
  fi

  if (( COMP_CWORD >= 2 )); then
    COMPREPLY=( $(compgen -W "-r -p" -- "$cur") )
  fi
}

complete -o nospace -F _iwork iwork
EOF
}

