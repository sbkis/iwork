#!/usr/bin/env bash
set -euo pipefail

SELF_PATH="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/$(basename "${BASH_SOURCE[0]:-$0}")"
IWORK_CONFIG_FILE="${IWORK_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/iwork/config}"
IWORK_CONFIG_VARS=(IWORK_REPO_DIR IWORK_TASKS_DIR IWORK_TMUX_SESSION IWORK_CONTEXT_TEMPLATE IWORK_EDITOR IWORK_NO_TMUX IWORK_NO_CONTEXT IWORK_DETACH IWORK_BIG IWORK_ASSUME_YES)

load_config() {
  local var="" restore=""

  [[ -f "$IWORK_CONFIG_FILE" ]] || return 0

  # Environment variables win over the config file: remember what came from
  # the environment, source the config, then put those values back.
  for var in "${IWORK_CONFIG_VARS[@]}"; do
    if [[ -n "${!var+x}" ]]; then
      restore="$restore $var=$(printf '%q' "${!var}");"
    fi
  done

  # shellcheck source=/dev/null
  . "$IWORK_CONFIG_FILE"

  eval "$restore"
}

load_config

REPO_DIR="${IWORK_REPO_DIR:-}"
TASKS_DIR="${IWORK_TASKS_DIR:-${REPO_DIR:+$REPO_DIR/tasks}}"
TASKS_SESSION="${IWORK_TMUX_SESSION:-tasks}"
IWORK_NO_TMUX="${IWORK_NO_TMUX:-}"
IWORK_NO_CONTEXT="${IWORK_NO_CONTEXT:-}"
IWORK_DETACH="${IWORK_DETACH:-}"
IWORK_BIG="${IWORK_BIG:-}"
IWORK_EDITOR="${IWORK_EDITOR:-nvim}"
CONTEXT_TEMPLATE="${IWORK_CONTEXT_TEMPLATE:-$HOME/.config/iwork/task-context.md.tmpl}"

require_config() {
  if [[ -z "$REPO_DIR" ]]; then
    die "IWORK_REPO_DIR is not set. Run 'iwork init', or add it to $IWORK_CONFIG_FILE:
  IWORK_REPO_DIR=\"\$HOME/dev/projects\""
  fi
  [[ -d "$REPO_DIR" ]] || die "IWORK_REPO_DIR is not a directory: $REPO_DIR"
}

usage() {
  cat <<'EOF'
Usage: iwork [flags] <branch-name> -r <repo1> [repo2 ...]
       iwork add-repo <task> -r <repo1> [repo2 ...]
       iwork [--no-tmux] rm [-f] <task> [-r <repo1> [repo2 ...]]
       iwork [flags] park <task>
       iwork [--no-tmux] list
       iwork [--no-tmux] cd <task>
       iwork [flags] claude <task> [claude-args...]
       iwork [flags] codex <task> [codex-args...]
       iwork init
       iwork install-hooks [settings-path]
       iwork --completion <bash|zsh>

       flags: [--no-tmux] [--no-context] [--detach] [--big]

Create a task folder in the tasks directory and set up git worktrees for
the specified repos, all on the given branch. Each worktree lives in a
subdirectory named after the repo it comes from.

Configuration lives in ~/.config/iwork/config (run 'iwork init' to create
it). IWORK_REPO_DIR must point at the directory whose direct children are
your git repositories; task folders go in IWORK_TASKS_DIR (default:
$IWORK_REPO_DIR/tasks). Environment variables override the config file.

Inside tmux, each task maps to a window in a dedicated 'tasks' session
(override the name with IWORK_TMUX_SESSION). Creation and park open the
window (claude starts in the left pane, a shell in the right);
claude/codex/cd switch to it if it exists. Claude Code hooks (see
install-hooks) mark the window name with the agent state:
*task = busy, !task = waiting for you.

With --detach the window is still created and the agent still starts in it,
but your client stays where it is — nothing switches session or window. It
also works from outside tmux (the tasks session is created in the
background), so you can spin up a task without leaving what you are doing.
Use 'iwork cd <task>' or 'iwork list' to pick it up later.

With --big the task gets a whole tmux session of its own, named
'<tmux-session>-<task>' (so 'tasks-feat-bla' by default), for work that
spans several repos:

  window '<task>'  the agent, plus a shell, at the task root
  window '<repo>'  one per worktree: IWORK_EDITOR (default nvim) on the
                   left, a shell on the right, both inside that worktree

The agent window keeps the task name so the status hooks still apply. Repo
windows are only added if missing, so 'add-repo' extends a live session.
list/cd/claude/codex/rm all find a task in its own session or in the shared
one, and rm kills the whole session. Combine with --detach to build the
session without being moved into it.

On creation and park, iwork writes CLAUDE.md and AGENTS.md into the task
folder from a template (~/.config/iwork/task-context.md.tmpl, override with
IWORK_CONTEXT_TEMPLATE), seeding a default template on first use. Existing
files are never overwritten.

Subcommands:
  init           Interactively create the config file
  add-repo       Add one or more repos to an existing task folder
  rm             Remove worktrees from a task; without -r, remove every
                 worktree, the generated context files (CLAUDE.md,
                 AGENTS.md, .claude/), the task folder and its tmux
                 window/session. Branches are always left intact. A
                 directory whose worktree registration is gone is reported
                 as orphaned and needs -f, since git can no longer say
                 whether it holds uncommitted work.
  park           Move the current repo/branch into a task folder
  list           List task folders (with window status in tmux)
  cd             Switch to the task window, or cd into the task folder
                 Requires sourced shell integration from --completion
  claude         Open/switch to the task window and run claude there
  codex          Open/switch to the task window and run codex there
  install-hooks  Add Claude Code hooks to ~/.claude/settings.json that keep
                 tmux window names in sync with agent status

Examples:
  iwork feat/bla -r backend-api frontend
  iwork fix/login-bug -r auth-service web-app
  iwork add-repo feat-bla -r shared-lib
  iwork rm feat-bla
  iwork rm feat-bla -r shared-lib
  iwork rm -f feat-bla
  iwork park task-billing-followup
  iwork list
  iwork cd feat-bla
  iwork claude feat-bla
  iwork --detach feat/bla -r backend-api frontend
  iwork --detach claude feat-bla
  iwork --big feat/huge-thing -r backend-api frontend shared-lib admin
  iwork --big --detach feat/huge-thing -r backend-api frontend
  iwork --no-tmux claude feat-bla
  iwork install-hooks

Options:
  --no-tmux     Skip all tmux window handling (leading flag)
  --no-context  Skip writing CLAUDE.md/AGENTS.md task context (leading flag)
  --detach      Create the task window and start the agent without switching
                to it (leading flag)
  --big         Give the task its own tmux session, with a window per repo
                (editor + shell) alongside the agent window (leading flag)
  -r            Repos to create worktrees for (required, at least one)
  -f            rm only: remove worktrees with uncommitted changes or
                orphaned directories, and skip the confirmation prompt
  -h            Show this help

Completion:
  source <(iwork --completion bash)
  source <(iwork --completion zsh)
EOF
  exit "${1:-0}"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

warn() {
  echo "Warning: $*" >&2
}

is_git_repo() {
  local repo_path="$1"
  git -C "$repo_path" rev-parse --git-dir >/dev/null 2>&1
}

current_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

validate_branch() {
  local branch_name="$1"

  if ! git check-ref-format --branch "$branch_name" >/dev/null 2>&1; then
    die "invalid branch name '$branch_name'"
  fi
}

validate_repo_name() {
  local repo="$1"

  case "$repo" in
    ""|.|..|*/*|*\\*|*:* )
      die "repo '$repo' must be a repo name directly under $REPO_DIR"
      ;;
  esac

  if [[ ! "$repo" =~ ^[A-Za-z0-9._-]+$ ]]; then
    die "repo '$repo' contains unsupported characters"
  fi
}

validate_worktree_folder_name() {
  local folder="$1"

  case "$folder" in
    ""|.|..|*/*|*\\* )
      die "folder '$folder' must be a direct child of $TASKS_DIR"
      ;;
    \**|!* )
      die "folder '$folder' must not start with '*' or '!'"
      ;;
  esac
}

list_repos() {
  local prefix="${1:-}"
  local path=""
  local name=""

  for path in "$REPO_DIR"/*; do
    [[ -d "$path" ]] || continue
    name="${path##*/}"
    [[ -n "$TASKS_DIR" && "$path" -ef "$TASKS_DIR" ]] && continue

    if is_git_repo "$path" && [[ "$name" == "$prefix"* ]]; then
      printf '%s\n' "$name"
    fi
  done | sort
}

list_worktree_folders() {
  local prefix="${1:-}"
  local path=""
  local name=""

  [[ -d "$TASKS_DIR" ]] || return 0

  for path in "$TASKS_DIR"/*; do
    [[ -d "$path" ]] || continue
    name="${path##*/}"

    if [[ "$name" == "$prefix"* ]]; then
      printf '%s\n' "$name"
    fi
  done | sort
}

list_task_worktree_names() {
  local folder="${1:-}"
  local prefix="${2:-}"
  local folder_path=""
  local wt=""
  local name=""

  validate_worktree_folder_name "$folder"
  folder_path="$TASKS_DIR/$folder"
  [[ -d "$folder_path" ]] || return 0

  while IFS= read -r wt; do
    [[ -n "$wt" ]] || continue
    name="${wt##*/}"
    if [[ "$name" == "$prefix"* ]]; then
      printf '%s\n' "$name"
    fi
  done < <(list_task_worktrees "$folder_path")
}

# Agent state for one task, from its window name in whichever session holds it.
# Tasks with their own session are flagged, since that is where they live.
task_status() {
  local folder="$1"
  local line=""
  local window_name=""
  local suffix=""

  if line="$(find_window_in_session "$(task_session_name "$folder")" "$folder")"; then
    suffix=" (session)"
  elif line="$(find_window_in_session "$TASKS_SESSION" "$folder")"; then
    suffix=""
  else
    return 0
  fi

  window_name="${line#* }"

  case "$window_name" in
    '*'*) printf '*running%s\n' "$suffix" ;;
    '!'*) printf '!waiting%s\n' "$suffix" ;;
    *) printf 'open%s\n' "$suffix" ;;
  esac
}

list_worktree_folders_with_status() {
  local folders=""
  local folder=""
  local status=""
  local width=0

  folders="$(list_worktree_folders)"
  [[ -n "$folders" ]] || return 0

  while IFS= read -r folder; do
    if (( ${#folder} > width )); then
      width=${#folder}
    fi
  done <<< "$folders"

  while IFS= read -r folder; do
    status="$(task_status "$folder")"

    if [[ -n "$status" ]]; then
      printf '%-*s  %s\n' "$width" "$folder" "$status"
    else
      printf '%s\n' "$folder"
    fi
  done <<< "$folders"
}

resolve_worktree_folder() {
  local folder="$1"
  local folder_path=""

  validate_worktree_folder_name "$folder"

  folder_path="$TASKS_DIR/$folder"
  [[ -d "$folder_path" ]] || die "worktree folder not found: $folder"

  printf '%s\n' "$folder_path"
}

run_tool_in_worktree() {
  local tool="$1"
  local folder="$2"
  local folder_path=""

  shift 2
  require_config
  folder_path="$(resolve_worktree_folder "$folder")"

  if tmux_enabled; then
    open_task "$folder" "$tool" "$@"
    exit 0
  fi

  cd "$folder_path"
  exec "$tool" "$@"
}

validate_primary_repo_root() {
  local repo_root="$1"
  local expected_prefix="$REPO_DIR/"

  case "$repo_root" in
    "$TASKS_DIR"|"$TASKS_DIR"/*)
      die "park must be run from a primary repo under $REPO_DIR, not from the tasks directory"
      ;;
    "$expected_prefix"*)
      ;;
    *)
      die "repo '$repo_root' must live directly under $REPO_DIR"
      ;;
  esac

  if [[ "$(dirname "$repo_root")" != "$REPO_DIR" ]]; then
    die "repo '$repo_root' must be a direct child of $REPO_DIR"
  fi
}

current_repo_name() {
  local repo_root="$1"
  local repo_name="${repo_root##*/}"

  validate_repo_name "$repo_name"
  printf '%s\n' "$repo_name"
}

current_branch_name() {
  local repo_root="$1"
  local branch=""

  branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
  [[ -n "$branch" ]] || die "repository is in detached HEAD state"
  validate_branch "$branch"
  printf '%s\n' "$branch"
}

switch_repo_to_base_branch() {
  local repo_root="$1"
  local base_ref=""
  local base_branch=""

  base_ref="$(resolve_base_ref "$repo_root")" || die "could not determine a base branch for $(basename "$repo_root")"
  base_branch="${base_ref#origin/}"

  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$base_branch" 2>/dev/null; then
    git -C "$repo_root" switch "$base_branch" >/dev/null
  else
    git -C "$repo_root" switch -c "$base_branch" --track "$base_ref" >/dev/null
  fi
}

resolve_park_target_path() {
  local folder_name="$1"
  local repo_root=""
  local repo_name=""

  validate_worktree_folder_name "$folder_name"

  repo_root="$(current_repo_root)"
  validate_primary_repo_root "$repo_root"

  repo_name="$(current_repo_name "$repo_root")"
  # The branch no longer shapes the path, but park still refuses a detached
  # HEAD, so keep failing here before the caller cds anywhere.
  current_branch_name "$repo_root" >/dev/null

  printf '%s\n' "$TASKS_DIR/$folder_name/$repo_name"
}

park_current_repo() {
  local folder_name="$1"
  local repo_root=""
  local repo_name=""
  local branch=""
  local wt_path=""
  local folder_path=""
  local status_output=""
  local stash_created=""
  local stash_ref=""

  validate_worktree_folder_name "$folder_name"

  repo_root="$(current_repo_root)"
  validate_primary_repo_root "$repo_root"
  repo_name="$(current_repo_name "$repo_root")"
  branch="$(current_branch_name "$repo_root")"
  folder_path="$TASKS_DIR/$folder_name"
  wt_path="$folder_path/$repo_name"

  case "$branch" in
    main|master|trunk)
      die "refusing to park base branch '$branch'"
      ;;
  esac

  if [[ -e "$wt_path" ]]; then
    die "destination already exists: $wt_path"
  fi

  status_output="$(git -C "$repo_root" status --porcelain --untracked-files=all)"
  if [[ -n "$status_output" ]]; then
    stash_created=1
    git -C "$repo_root" stash push --include-untracked --message "iwork park: $repo_name $branch" >/dev/null
    stash_ref="stash@{0}"
  fi

  switch_repo_to_base_branch "$repo_root"

  mkdir -p "$folder_path"
  echo "Using $folder_path"
  git -C "$repo_root" worktree add "$wt_path" "$branch"
  echo "  -> $repo_name (branch: $branch)"

  if [[ -n "$stash_created" ]]; then
    if git -C "$wt_path" stash apply --index "$stash_ref" >/dev/null 2>&1; then
      git -C "$wt_path" stash drop "$stash_ref" >/dev/null 2>&1 || true
      echo "  -> restored stashed changes into parked worktree"
    else
      die "parked worktree created at $wt_path, but applying stashed changes failed; stash was kept as $stash_ref"
    fi
  fi

  echo ""
  echo "Done! Worktree parked at:"
  echo "  $wt_path"

  write_task_context "$folder_name" "$branch"
  open_task "$folder_name" claude
}

detect_branch_from_worktree_folder() {
  local folder="$1"
  local folder_path=""
  local child_path=""
  local branch=""
  local detected_branch=""

  folder_path="$(resolve_worktree_folder "$folder")"

  for child_path in "$folder_path"/*; do
    [[ -d "$child_path" ]] || continue

    if ! is_git_repo "$child_path"; then
      continue
    fi

    branch="$(git -C "$child_path" branch --show-current 2>/dev/null || true)"
    [[ -n "$branch" ]] || continue

    validate_branch "$branch"

    if [[ -z "$detected_branch" ]]; then
      detected_branch="$branch"
      continue
    fi

    if [[ "$detected_branch" != "$branch" ]]; then
      die "worktree folder '$folder' contains multiple branches ('$detected_branch' and '$branch')"
    fi
  done

  [[ -n "$detected_branch" ]] || die "could not determine a branch from existing worktrees in $folder"
  printf '%s\n' "$detected_branch"
}

is_worktree_root() {
  local path="$1"
  local top=""

  top="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ -n "$top" && "$top" -ef "$path" ]]
}

# The repository a worktree belongs to, derived from its git common dir rather
# than from the folder name, so worktrees created by older versions of iwork
# (repo--branch-slug) still resolve.
worktree_main_repo_dir() {
  local wt_path="$1"
  local common_dir=""

  common_dir="$(git -C "$wt_path" rev-parse --git-common-dir 2>/dev/null)" || return 1
  [[ -n "$common_dir" ]] || return 1

  case "$common_dir" in
    /*) ;;
    *) common_dir="$wt_path/$common_dir" ;;
  esac

  (cd "$common_dir/.." && pwd) 2>/dev/null
}

list_task_worktrees() {
  local folder_path="$1"
  local child=""

  for child in "$folder_path"/*; do
    [[ -d "$child" ]] || continue
    is_worktree_root "$child" || continue
    printf '%s\n' "$child"
  done
}

# Directories that were worktrees but whose registration is gone: they still
# carry a .git that no longer resolves, usually because the directory was
# renamed with plain mv and git later pruned the missing path. git can tell us
# nothing about these, so removing one is a plain directory delete.
list_task_orphans() {
  local folder_path="$1"
  local child=""

  for child in "$folder_path"/*; do
    [[ -d "$child" ]] || continue
    [[ -e "$child/.git" ]] || continue
    is_worktree_root "$child" && continue
    printf '%s\n' "$child"
  done
}

confirm() {
  local prompt="$1"
  local answer=""

  [[ "${IWORK_ASSUME_YES:-}" == "1" ]] && return 0

  if ! { : </dev/tty; } 2>/dev/null; then
    die "no TTY available for confirmation; re-run with -f or IWORK_ASSUME_YES=1"
  fi

  printf '%s [y/N] ' "$prompt"
  IFS= read -r answer </dev/tty
  case "$answer" in
    y|Y) return 0 ;;
    *) return 1 ;;
  esac
}

kill_task_tmux() {
  local folder="$1"
  local session=""
  local current_session=""
  local line=""
  local window_id=""
  local current_id=""

  tmux_enabled || return 0

  # A --big task owns its session, so the whole session goes.
  session="$(task_session_name "$folder")"
  if tmux has-session -t "=$session" 2>/dev/null; then
    current_session="$(tmux display-message -p '#{session_name}' 2>/dev/null || true)"
    if [[ -n "$current_session" && "$current_session" == "$session" ]]; then
      warn "you are attached to tmux session '$session'; close it yourself"
      return 0
    fi
    tmux kill-session -t "=$session" 2>/dev/null || warn "could not kill tmux session '$session'"
    return 0
  fi

  line="$(find_window_in_session "$TASKS_SESSION" "$folder")" || return 0
  window_id="${line%% *}"

  current_id="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
  if [[ -n "$current_id" && "$current_id" == "$window_id" ]]; then
    warn "tmux window '$folder' is the current window; close it yourself"
    return 0
  fi

  tmux kill-window -t "$window_id" 2>/dev/null || warn "could not kill tmux window '$folder'"
}

remove_worktrees() {
  local folder="$1"
  local force="$2"
  shift 2
  local repos=("$@")
  local folder_path=""
  local worktrees=()
  local orphans=()
  local targets=()
  local orphan_targets=()
  local dirty=()
  local repo=""
  local wt=""
  local name=""
  local matched=""
  local repo_root=""
  local failed=""
  local remove_all=""
  local target=""
  local session=""

  folder_path="$(resolve_worktree_folder "$folder")"
  (( ${#repos[@]} == 0 )) && remove_all=1

  while IFS= read -r wt; do
    [[ -n "$wt" ]] && worktrees+=("$wt")
  done < <(list_task_worktrees "$folder_path")

  while IFS= read -r wt; do
    [[ -n "$wt" ]] && orphans+=("$wt")
  done < <(list_task_orphans "$folder_path")

  if (( ${#worktrees[@]} == 0 && ${#orphans[@]} == 0 )); then
    if [[ -z "$remove_all" ]]; then
      die "no git worktrees found in $folder_path"
    fi
    warn "no git worktrees found in $folder_path"
  fi

  if [[ -n "$remove_all" ]]; then
    targets=("${worktrees[@]+${worktrees[@]}}")
    orphan_targets=("${orphans[@]+${orphans[@]}}")
  else
    for repo in "${repos[@]}"; do
      validate_repo_name "$repo"
      matched=""
      # Current layout names the worktree after the repo; older ones used
      # repo--branch-slug.
      for wt in "${worktrees[@]+${worktrees[@]}}"; do
        name="${wt##*/}"
        if [[ "$name" == "$repo" || "$name" == "$repo"--* ]]; then
          targets+=("$wt")
          matched=1
        fi
      done
      for wt in "${orphans[@]+${orphans[@]}}"; do
        name="${wt##*/}"
        if [[ "$name" == "$repo" || "$name" == "$repo"--* ]]; then
          orphan_targets+=("$wt")
          matched=1
        fi
      done
      [[ -n "$matched" ]] || die "repo '$repo' has no worktree in task '$folder'"
    done
  fi

  for wt in "${targets[@]+${targets[@]}}"; do
    if [[ -n "$(git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null || true)" ]]; then
      dirty+=("${wt##*/}")
    fi
  done

  echo "Removing from $folder_path:"
  for wt in "${targets[@]+${targets[@]}}"; do
    echo "  - ${wt##*/}"
  done
  for wt in "${orphan_targets[@]+${orphan_targets[@]}}"; do
    echo "  - ${wt##*/}  (orphaned: registration gone, deleted as a plain directory)"
  done

  if [[ -n "$remove_all" ]]; then
    echo "  - the task folder itself"

    # Worth spelling out: killing the session takes any editors with it.
    session="$(task_session_name "$folder")"
    if tmux_enabled && tmux has-session -t "=$session" 2>/dev/null; then
      echo "  - tmux session '$session' and everything running in it"
    fi
  fi

  if (( ${#dirty[@]} > 0 )); then
    echo ""
    echo "Uncommitted changes in: ${dirty[*]}"
    [[ -n "$force" ]] || die "refusing to remove worktrees with uncommitted changes; re-run with -f"
  fi

  if (( ${#orphan_targets[@]} > 0 )) && [[ -z "$force" ]]; then
    echo ""
    die "orphaned directories cannot be checked for uncommitted work; re-run with -f to delete them"
  fi

  echo ""
  if [[ -z "$force" ]]; then
    confirm "Proceed?" || die "aborted"
  fi

  for wt in "${targets[@]+${targets[@]}}"; do
    name="${wt##*/}"

    if ! repo_root="$(worktree_main_repo_dir "$wt")" || [[ -z "$repo_root" ]]; then
      warn "could not determine the repository for $wt; left in place"
      failed=1
      continue
    fi

    if git -C "$repo_root" worktree remove ${force:+--force} "$wt" 2>/dev/null; then
      echo "  -> removed $name"
    else
      warn "git worktree remove failed for $wt; left in place"
      failed=1
      continue
    fi

    git -C "$repo_root" worktree prune 2>/dev/null || true
  done

  # Only reachable with -f, which the orphan check above enforces.
  for wt in "${orphan_targets[@]+${orphan_targets[@]}}"; do
    name="${wt##*/}"

    if rm -rf "$wt"; then
      echo "  -> deleted orphaned $name"
    else
      warn "could not delete $wt; left in place"
      failed=1
    fi
  done

  if [[ -z "$remove_all" ]]; then
    echo ""
    echo "Done! Branches were left untouched."
    return 0
  fi

  # The task is gone either way, so its window/session goes too — and killing
  # it first stops any editor from writing the folder back up under us.
  kill_task_tmux "$folder"

  if [[ -n "$failed" ]]; then
    die "some worktrees could not be removed; kept $folder_path"
  fi

  # Generated for the agent that ran here, so they go with the task.
  for target in "$folder_path/CLAUDE.md" "$folder_path/AGENTS.md" "$folder_path/.claude"; do
    [[ -e "$target" ]] || continue
    rm -rf "$target" || warn "could not remove $target"
  done

  if rmdir "$folder_path" 2>/dev/null; then
    echo "  -> removed ${folder_path##*/}"
  else
    warn "$folder_path is not empty; kept it (worktrees are gone)"
    warn "  remaining: $(ls -A "$folder_path" 2>/dev/null | tr '\n' ' ')"
  fi

  echo ""
  echo "Done! Branches were left untouched."
}

parse_repos_flag() {
  local missing_flag_message="$1"
  shift

  repos=()

  if [[ "${1:-}" != "-r" ]]; then
    die "$missing_flag_message"
  fi
  shift

  while [[ $# -gt 0 ]]; do
    repos+=("$1")
    shift
  done

  if [[ ${#repos[@]} -eq 0 ]]; then
    die "specify at least one repo after -r"
  fi
}

create_worktrees() {
  local branch="$1"
  local folder_name="$2"
  local folder_path="$TASKS_DIR/$folder_name"
  local seen_repos=""
  local base_refs=()
  local repo=""
  local repo_path=""
  local wt_path=""
  local base_ref=""
  local i=""

  shift 2
  local repos=("$@")

  for repo in "${repos[@]}"; do
    repo_path=""
    wt_path=""
    base_ref=""

    validate_repo_name "$repo"

    case " $seen_repos " in
      *" $repo "*) die "repo '$repo' was provided more than once" ;;
    esac
    seen_repos="$seen_repos $repo"

    repo_path="$REPO_DIR/$repo"
    if ! is_git_repo "$repo_path"; then
      die "$repo_path is not a git repository"
    fi

    wt_path="$folder_path/$repo"

    if [[ -e "$wt_path" ]] && ! is_registered_worktree_path "$repo_path" "$wt_path"; then
      die "destination already exists and is not a registered git worktree: $wt_path"
    fi

    if git -C "$repo_path" remote get-url origin >/dev/null 2>&1; then
      if ! git -C "$repo_path" fetch origin --quiet 2>/dev/null; then
        warn "could not fetch origin for $repo; using local refs"
      fi
    fi

    if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
      base_refs+=("")
      continue
    fi

    if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null; then
      die "branch '$branch' already exists on origin for $repo"
    fi

    base_ref="$(resolve_base_ref "$repo_path")" || die "could not determine a base branch for $repo"
    base_refs+=("$base_ref")
  done

  mkdir -p "$folder_path"
  echo "Using $folder_path"

  for i in "${!repos[@]}"; do
    repo="${repos[$i]}"
    repo_path="$REPO_DIR/$repo"
    wt_path="$folder_path/$repo"
    base_ref="${base_refs[$i]}"

    if [[ -e "$wt_path" ]]; then
      echo "Skipping $repo (already exists)"
      continue
    fi

    if [[ -n "$base_ref" ]]; then
      git -C "$repo_path" worktree add -b "$branch" "$wt_path" "$base_ref"
    else
      git -C "$repo_path" worktree add "$wt_path" "$branch"
    fi

    echo "  -> $repo (branch: $branch)"
  done

  echo ""
  echo "Done! Worktrees ready at:"
  echo "  $folder_path"
}

