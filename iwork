#!/usr/bin/env bash
set -euo pipefail

SELF_PATH="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/$(basename "${BASH_SOURCE[0]:-$0}")"
IWORK_CONFIG_FILE="${IWORK_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/iwork/config}"
IWORK_CONFIG_VARS=(IWORK_REPO_DIR IWORK_TASKS_DIR IWORK_PROJECTS_DIR IWORK_TMUX_SESSION IWORK_PROJECTS_TMUX_SESSION IWORK_CONTEXT_TEMPLATE IWORK_PROJECT_TEMPLATE IWORK_EDITOR IWORK_NO_TMUX IWORK_NO_CONTEXT IWORK_DETACH IWORK_BIG IWORK_ASSUME_YES IWORK_PROJECT IWORK_SHOW_LOG_LINES)

load_config() {
  local var="" restore=""

  [[ -f "$IWORK_CONFIG_FILE" ]] || return 0

  # Environment variables win over the config file: remember what came from
  # the environment, source the config, then put those values back.
  for var in "${IWORK_CONFIG_VARS[@]}"; do
    if [[ -n "${!var+x}" ]]; then
      restore="$restore $var=$(printf '%q' "${!var}");"
    fi
  done

  # shellcheck source=/dev/null
  . "$IWORK_CONFIG_FILE"

  eval "$restore"
}

load_config

REPO_DIR="${IWORK_REPO_DIR:-}"
TASKS_DIR="${IWORK_TASKS_DIR:-${REPO_DIR:+$REPO_DIR/tasks}}"
PROJECTS_DIR="${IWORK_PROJECTS_DIR:-${REPO_DIR:+$REPO_DIR/projects}}"
TASKS_SESSION="${IWORK_TMUX_SESSION:-tasks}"
PROJECTS_SESSION="${IWORK_PROJECTS_TMUX_SESSION:-projects}"
IWORK_NO_TMUX="${IWORK_NO_TMUX:-}"
IWORK_NO_CONTEXT="${IWORK_NO_CONTEXT:-}"
IWORK_DETACH="${IWORK_DETACH:-}"
IWORK_BIG="${IWORK_BIG:-}"
IWORK_EDITOR="${IWORK_EDITOR:-nvim}"
# Per-invocation only (--from): the task or branch new branches start from.
BASE_SPEC=""
# Per-invocation only (-m): the agent's first prompt, and the argv tail that
# hands it over (see agent_message_args).
INITIAL_MESSAGE=""
AGENT_ARGS=()
CONTEXT_TEMPLATE="${IWORK_CONTEXT_TEMPLATE:-$HOME/.config/iwork/task-context.md.tmpl}"
PROJECT_TEMPLATE="${IWORK_PROJECT_TEMPLATE:-$HOME/.config/iwork/project-context.md.tmpl}"
SHOW_LOG_LINES="${IWORK_SHOW_LOG_LINES:-12}"
CHECKPOINT_NUDGE_AFTER=40

# Validated here rather than at the point of use: it is evaluated inside (( ))
# and by tail -n, so a non-numeric value under 'set -u' aborts project_show
# halfway through — which the SessionStart hook then reports as a broken hook
# after emitting half a project brief.
# Masters and tasks are looked up by window name in their own session, so one
# session holding both means a task lookup can answer with a master.
if [[ "$PROJECTS_SESSION" == "$TASKS_SESSION" ]]; then
  echo "Warning: IWORK_PROJECTS_TMUX_SESSION must differ from IWORK_TMUX_SESSION (both '$TASKS_SESSION'); using '$TASKS_SESSION-projects'" >&2
  PROJECTS_SESSION="$TASKS_SESSION-projects"
fi

if [[ ! "$SHOW_LOG_LINES" =~ ^[1-9][0-9]*$ ]]; then
  # Not warn(): this runs at load time, before the helpers are defined.
  echo "Warning: IWORK_SHOW_LOG_LINES must be a positive integer, got '$SHOW_LOG_LINES'; using 12" >&2
  SHOW_LOG_LINES=12
fi

require_config() {
  if [[ -z "$REPO_DIR" ]]; then
    die "IWORK_REPO_DIR is not set. Run 'iwork init', or add it to $IWORK_CONFIG_FILE:
  IWORK_REPO_DIR=\"\$HOME/dev/projects\""
  fi
  [[ -d "$REPO_DIR" ]] || die "IWORK_REPO_DIR is not a directory: $REPO_DIR"
}

usage() {
  cat <<'EOF'
Usage: iwork [flags] <branch-name> [--from <task|branch>] -r <repo1> [repo2 ...]
                                   [-p <project>]
       iwork add-repo [<task>] [--from <task|branch>] -r <repo1> [repo2 ...]
       iwork [--no-tmux] rm [-f] <task|--current> [-r <repo1> [repo2 ...]]
       iwork [flags] park <task> [-p <project>]
       iwork [--no-tmux] list
       iwork [--no-tmux] cd <task>
       iwork [flags] claude <task> [claude-args...]
       iwork [flags] codex <task> [codex-args...]
       iwork [flags] master [<project>]
       iwork init
       iwork install-hooks [settings-path]
       iwork --completion <bash|zsh>

       iwork project list
       iwork project show [-n <count>] [-p <project> | <project>]
       iwork project agents [--json|--tsv] [-p <project> | <project>]
       iwork project grep [-p <project>] <pattern> [ripgrep-args...]
       iwork project cat [-p <project>] <path-inside-the-project>
       iwork project add <project> [<task>]
       iwork project rm [<project>] [<task>]
       iwork project delete [-f] <project>

       iwork todo "<what needs doing>" [-p <project>]
       iwork log [--decision|--shipped|--note] "<what>" [-p <project>]
       iwork decided "<what and why>" [-p <project>]
       iwork done <todo-id> [--nth <n>] [-p <project>]
       iwork drop <todo-id> [--nth <n>] [-p <project>]

       flags: [--no-tmux] [--no-context] [--detach|-d] [--big]
              [--message|-m <message>]

Create a task folder in the tasks directory and set up git worktrees for
the specified repos, all on the given branch. Each worktree lives in a
subdirectory named after the repo it comes from.

New branches start from the base branch but get no upstream, so status and
prompts do not report them as ahead of/behind origin/main before they are
pushed. Use 'git push -u origin HEAD' to set a real upstream.

--from <task|branch> stacks a task on earlier work instead of starting from
origin/main. Per repo, iwork uses the first of these that exists, and says
which base each repo got:

  1. the branch checked out in that repo's worktree in the named task
  2. a local branch of that name
  3. origin/<name>
  4. anything else git resolves there: origin/x spelled out, a tag, a SHA

So the base needs no worktree and no live task — 'rm' keeps branches, so a
task you have already torn down still works as a base, as does any ordinary
branch you never made a task for. Repos the base does not cover fall back to
their own base branch with a warning, so a task can be wider than the one it
builds on.

Configuration lives in ~/.config/iwork/config (run 'iwork init' to create
it). IWORK_REPO_DIR must point at the directory whose direct children are
your git repositories; task folders go in IWORK_TASKS_DIR (default:
$IWORK_REPO_DIR/tasks). Environment variables override the config file.

Inside tmux, each task maps to a window in a dedicated 'tasks' session
(override the name with IWORK_TMUX_SESSION); each project master maps to a
window in a separate 'projects' session (IWORK_PROJECTS_TMUX_SESSION). Creation and park open the
window (claude starts in the left pane, a shell in the right);
claude/codex/cd switch to it if it exists. Claude Code hooks (see
install-hooks) mark the window name with the agent state:
*task = busy, !task = waiting for you. Session names carry the same
marker, taken from the windows in them: '!tasks' means one of the tasks
in there wants you, '*tasks' that one is working and none is waiting, and
a plain 'tasks' that neither is true. A --big task's own session and the
projects session are marked the same way. The marker is part of the name,
so a marked session does not answer to 'tmux attach -t tasks': pick it out
of the session list (prefix + s), or match it by pattern -- the README has
the keybinding.

-m <message> hands the agent the message as its first prompt, so a new task
starts working the moment it comes up instead of waiting for you to type it.
It applies wherever iwork starts an agent itself: creation, park, and
claude/codex on a task whose window is not already open. Pair it with --detach
to kick a task off and carry on with what you were doing. -m never types into
an agent that is already running, since that pane may have been left at a
shell; when there is nothing to start, iwork says the message was not
delivered rather than dropping it silently.

With --detach the window is still created and the agent still starts in it,
but your client stays where it is — nothing switches session or window. It
also works from outside tmux (the tasks session is created in the
background), so you can spin up a task without leaving what you are doing.
Use 'iwork cd <task>' or 'iwork list' to pick it up later.

With --big the task gets a whole tmux session of its own, named
'<tmux-session>-<task>' (so 'tasks-feat-bla' by default), for work that
spans several repos:

  window '<task>'  the agent, plus a shell, at the task root
  window '<repo>'  one per worktree: IWORK_EDITOR (default nvim) on the
                   left, a shell on the right, both inside that worktree

The agent window keeps the task name so the status hooks still apply, and
they mark the session name with it ('*tasks-feat-bla' busy, '!tasks-feat-bla'
waiting) so the state shows up in the session list as well. Repo windows are
never marked: they hold an editor, not an agent. Repo windows are only added
if missing, so 'add-repo' extends a live session.
list/cd/claude/codex/rm all find a task in its own session or in the shared
one, and rm kills the whole session. Combine with --detach to build the
session without being moved into it.

On creation and park, iwork writes CLAUDE.md and AGENTS.md into the task
folder from a template (~/.config/iwork/task-context.md.tmpl, override with
IWORK_CONTEXT_TEMPLATE), seeding a default template on first use. Existing
files are never overwritten.

A task created with --from records what it was branched from, so the agent
knows that work is already in its history: the template can place it with a
{{BASE}} placeholder, and without one iwork appends a short '## Base'
section instead.

Subcommands:
  init           Interactively create the config file
  add-repo       Add one or more repos to an existing task folder
  rm             Remove worktrees from a task; without -r, remove every
                 worktree, the generated context files (CLAUDE.md,
                 AGENTS.md, .claude/), the task folder and its tmux
                 window/session. Branches are always left intact. A
                 directory whose worktree registration is gone is reported
                 as orphaned and needs -f, since git can no longer say
                 whether it holds uncommitted work.
  park           Move the current repo/branch into a task folder
  list           List task folders (with window status in tmux)
  cd             Switch to the task window, or cd into the task folder
                 Requires sourced shell integration from --completion
  claude         Open/switch to the task window and run claude there
  codex          Open/switch to the task window and run codex there
  master         Open/switch to the project's master session: one agent per
                 project whose job is the project rather than any task in it
                 (see Master below)
  install-hooks  Add Claude Code hooks to ~/.claude/settings.json: keep tmux
                 window and session names in sync with agent status, inject the
                 project brief at session start, log PRs, and prompt for a
                 flush before a compaction. Safe to re-run; it only adds what
                 is missing
  project        Manage projects: the memory shared by the tasks of one
                 longer-horizon effort (see Projects below)
  todo           Capture something that needs doing but not in this PR
  log            Append one line to the project log (--decision, --shipped,
                 --note; default --note)
  decided        Shorthand for 'log --decision'
  done / drop    Close or abandon a captured todo by id

Projects:
  A project is a directory of markdown outside the tasks tree that outlives any
  one task, so an effort spanning weeks and many PRs does not have to be
  re-explained to a fresh agent every time.

      iwork feat/token-api -r auth-service -p auth-rewrite

  creates the project on first use (after confirming) and, in the task folder,
  a '.project' symlink pointing at it. The symlink is deliberate: it puts the
  shared memory inside the task directory, so the agent's usual "stay in this
  directory" scope still holds. Project memory is never touched by 'iwork rm' —
  the same guarantee branches get.

  Projects live in IWORK_PROJECTS_DIR (default: $IWORK_REPO_DIR/projects), which
  must not be inside the tasks directory — anything there is treated as a task.

      <project>/PROJECT.md     curated brief: goal, where we are, constraints
      <project>/LOG.md         append-only, one timestamped line per entry
      <project>/TODO.md        captured-not-now, with the task it surfaced in
      <project>/history.tsv    append-only task events (opened, detached,
                               closed)
      <project>/agents.tsv     append-only session events; 'project agents'
                               reduces it to who is live right now
      <project>/notes/         anything that outlives one task

  Live state is never cached: which tasks exist and what they are doing is read
  from the filesystem and tmux on every call, exactly as 'iwork list' does.
  history.tsv only records what cannot be derived once a task folder is gone.

  The memory is reachable through the symlink, but the agent is told to go
  through the CLI. For reads that is a preference: 'project show' is assembled
  and bounded, while LOG.md grows without limit. For writes it is a hard rule,
  because tasks run in parallel — 'todo' / 'log' / 'decided' append one line
  atomically, whereas an agent editing LOG.md does read-modify-write and drops
  whatever a sibling appended in between.

  With the hooks installed (see install-hooks) most of it happens unprompted:
  the project brief is injected at session start, PRs are logged when 'gh pr
  create' runs, and a compaction prompts the agent to record what it worked out
  before the context is dropped. Nothing forces a log entry — a padded log is
  worse than a short one.

  'iwork project -h' lists just the project commands, grouped by whether they
  read, record, or manage — that is the help an agent is pointed at.

  'iwork project add <project> [<task>]' attaches a task that already exists,
  so work already in flight can join a project. The task name may be left out
  anywhere it is positional — add-repo and 'project add|rm' then act on the task
  whose directory you are standing in, the same inference 'iwork todo' uses. rm
  is the exception: it destroys worktrees, so it wants an explicit --current. A task belongs to exactly one
  project; attach again with a different name and it refuses rather than
  silently relinking.

Master:
  'iwork master [<project>]' opens one long-lived agent per project, in a window
  of its own named after the project, in the 'projects' tmux session. Its cwd is
  the project directory, so every project verb works there with no arguments.

  It is the session for the shape of the work rather than the work: split a
  large feature into tasks, decide what stacks on what, spawn them, watch them,
  redirect one that has gone the wrong way. Stacked PRs are the case it earns
  its keep on — '--from' builds the chain, and the master is the only thing that
  knows the chain exists.

  A separate session because it is what you want in front of you while the tasks
  are not: attach to it from a second terminal or a second client with
  'tmux attach -t projects' (or '!projects' / '*projects' while the status
  hooks have it marked). Started from outside tmux it builds that session in
  the background and tells you how to reach it, marker and all.

  Standing in the project directory changes three things, so the master does not
  have to spell them out: a task created there joins that project, it is created
  detached so spawning one does not drag your client into the tasks session, and
  'rm' and 'project delete' refuse to run — they destroy worktrees and memory,
  and that stays the operator's.

  The master's instructions come from the SessionStart hook, so 'install-hooks'
  is not optional for it: without the hooks it starts as an ordinary agent in a
  directory of markdown, and says so.

Examples:
  iwork feat/bla -r backend-api frontend
  iwork fix/login-bug -r auth-service web-app
  iwork add-repo feat-bla -r shared-lib
  iwork feat/step-two --from feat-step-one -r backend-api frontend
  iwork feat/step-two --from feat/step-one -r backend-api
  iwork add-repo feat-step-two --from feat-step-one -r shared-lib
  iwork rm feat-bla
  iwork rm feat-bla -r shared-lib
  iwork rm -f feat-bla
  iwork park task-billing-followup
  iwork list
  iwork cd feat-bla
  iwork claude feat-bla
  iwork --detach feat/bla -r backend-api frontend
  iwork --detach claude feat-bla
  iwork fix/login-bug -r auth-service -m 'Sentry AUTH-42: why does login 500?'
  iwork fix/login-bug -r auth-service -m 'Look at Sentry AUTH-42' -d
  iwork --big feat/huge-thing -r backend-api frontend shared-lib admin
  iwork --big --detach feat/huge-thing -r backend-api frontend
  iwork --no-tmux claude feat-bla
  iwork master auth-rewrite
  iwork master -m 'split the token work into stacked PRs'
  iwork install-hooks

Options (all accepted before the branch name or after the repo list):
  --no-tmux     Skip all tmux window handling
  --no-context  Skip writing CLAUDE.md/AGENTS.md task context
  --detach, -d  Create the task window and start the agent without switching
                to it
  --big         Give the task its own tmux session, with a window per repo
                (editor + shell) alongside the agent window
  --from        Start the new branches from this task or branch instead of
                origin/main
  --message, -m The agent's first prompt, so it starts work on its own
  -r            Repos to create worktrees for (required, at least one)
  -p            Project this task is part of, created on first use. Also
                selects the project for todo/log/decided/done/drop and for
                'project show|grep|cat'. It always wins over both the task's
                own .project link and IWORK_PROJECT
  -f            rm only: remove worktrees with uncommitted changes or
                orphaned directories, and skip the confirmation prompt
  --current     rm only: act on the task whose directory you are in. Every
                other command that takes a task name infers it without a flag;
                rm destroys worktrees, so it wants this spelled out
  --nth         done/drop only: pick one of several todos sharing an id
  -h            Show this help

Completion:
  source <(iwork --completion bash)
  source <(iwork --completion zsh)
EOF
  exit "${1:-0}"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

warn() {
  echo "Warning: $*" >&2
}

# The prompt goes last, behind '--'. claude and codex both take it positionally,
# and the separator is load-bearing twice over: it stops a message that starts
# with a dash from being read as an option, and it ends a variadic option like
# claude's --add-dir, which otherwise swallows a trailing prompt as one more
# directory. AGENT_ARGS is empty when no message was given.
# -m after the subcommand is forwarded to the agent as one of its own flags.
# claude rejects it, so the pane is left at a shell and the window reads as
# 'open' in the listing — the same as a task you opened by hand. Nothing says
# the agent never started, and the message goes nowhere.
reject_trailing_message_flag() {
  local tool="$1"
  local arg=""

  shift
  for arg in "$@"; do
    case "$arg" in
      -m|--message)
        die "-m is an iwork flag, not a $tool one, so it has to come first:
  iwork -m \"<message>\" $tool <task>"
        ;;
    esac
  done
}

agent_message_args() {
  AGENT_ARGS=()
  [[ -z "$INITIAL_MESSAGE" ]] || AGENT_ARGS=(-- "$INITIAL_MESSAGE")
}

# -m only reaches an agent that this invocation starts itself. Everywhere else
# say so rather than dropping the prompt on the floor.
warn_message_undelivered() {
  [[ -n "$INITIAL_MESSAGE" ]] || return 0
  warn "-m was not delivered: $1"
}

is_git_repo() {
  local repo_path="$1"
  git -C "$repo_path" rev-parse --git-dir >/dev/null 2>&1
}

current_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

validate_branch() {
  local branch_name="$1"

  if ! git check-ref-format --branch "$branch_name" >/dev/null 2>&1; then
    die "invalid branch name '$branch_name'"
  fi
}

validate_repo_name() {
  local repo="$1"

  case "$repo" in
    ""|.|..|*/*|*\\*|*:* )
      die "repo '$repo' must be a repo name directly under $REPO_DIR"
      ;;
  esac

  if [[ ! "$repo" =~ ^[A-Za-z0-9._-]+$ ]]; then
    die "repo '$repo' contains unsupported characters"
  fi
}

validate_worktree_folder_name() {
  local folder="$1"

  case "$folder" in
    ""|.|..|*/*|*\\* )
      die "folder '$folder' must be a direct child of $TASKS_DIR"
      ;;
    \**|!* )
      die "folder '$folder' must not start with '*' or '!'"
      ;;
  esac
}

list_repos() {
  local prefix="${1:-}"
  local path=""
  local name=""

  for path in "$REPO_DIR"/*; do
    [[ -d "$path" ]] || continue
    name="${path##*/}"
    [[ -n "$TASKS_DIR" && "$path" -ef "$TASKS_DIR" ]] && continue
    # Phase 3 gives project dirs a git repo of their own, which would otherwise
    # make them selectable with -r.
    [[ -n "$PROJECTS_DIR" && "$path" -ef "$PROJECTS_DIR" ]] && continue

    if is_git_repo "$path" && [[ "$name" == "$prefix"* ]]; then
      printf '%s\n' "$name"
    fi
  done | sort
}

list_worktree_folders() {
  local prefix="${1:-}"
  local path=""
  local name=""

  [[ -d "$TASKS_DIR" ]] || return 0

  for path in "$TASKS_DIR"/*; do
    [[ -d "$path" ]] || continue
    name="${path##*/}"

    if [[ "$name" == "$prefix"* ]]; then
      printf '%s\n' "$name"
    fi
  done | sort
}

list_task_worktree_names() {
  local folder="${1:-}"
  local prefix="${2:-}"
  local folder_path=""
  local wt=""
  local name=""

  validate_worktree_folder_name "$folder"
  folder_path="$TASKS_DIR/$folder"
  [[ -d "$folder_path" ]] || return 0

  while IFS= read -r wt; do
    [[ -n "$wt" ]] || continue
    name="${wt##*/}"
    if [[ "$name" == "$prefix"* ]]; then
      printf '%s\n' "$name"
    fi
  done < <(list_task_worktrees "$folder_path")
}

# Agent state for one task, from its window name in whichever session holds it.
# Tasks with their own session are flagged, since that is where they live.
task_status() {
  local folder="$1"
  local line=""
  local window_name=""
  local suffix=""

  if line="$(find_window_in_session "$(task_session_name "$folder")" "$folder")"; then
    suffix=" (session)"
  elif line="$(find_window_in_session "$TASKS_SESSION" "$folder")"; then
    suffix=""
  else
    return 0
  fi

  window_name="${line#* }"

  case "$window_name" in
    '*'*) printf '*running%s\n' "$suffix" ;;
    '!'*) printf '!waiting%s\n' "$suffix" ;;
    *) printf 'open%s\n' "$suffix" ;;
  esac
}

list_worktree_folders_with_status() {
  local folders=""
  local folder=""
  local status=""
  local width=0

  folders="$(list_worktree_folders)"
  [[ -n "$folders" ]] || return 0

  while IFS= read -r folder; do
    if (( ${#folder} > width )); then
      width=${#folder}
    fi
  done <<< "$folders"

  while IFS= read -r folder; do
    status="$(task_status "$folder")"

    if [[ -n "$status" ]]; then
      printf '%-*s  %s\n' "$width" "$folder" "$status"
    else
      printf '%s\n' "$folder"
    fi
  done <<< "$folders"
}

resolve_worktree_folder() {
  local folder="$1"
  local folder_path=""

  validate_worktree_folder_name "$folder"

  folder_path="$TASKS_DIR/$folder"
  [[ -d "$folder_path" ]] || die "worktree folder not found: $folder"

  printf '%s\n' "$folder_path"
}

# Anything a master starts belongs in the tasks session rather than in front of
# it: open_task_window ends in switch_to_window, which calls switch-client, so
# without this a master spawning a task drags the operator's client out of the
# projects session and into the tasks one.
master_default_detach() {
  in_master_context || return 0
  IWORK_DETACH="${IWORK_DETACH:-1}"
}

run_tool_in_worktree() {
  local tool="$1"
  local folder="$2"
  local folder_path=""

  shift 2
  require_config
  folder_path="$(resolve_worktree_folder "$folder")"
  master_default_detach

  if tmux_enabled; then
    open_task "$folder" "$tool" "$@"
    exit 0
  fi

  cd "$folder_path"
  exec "$tool" "$@"
}

validate_primary_repo_root() {
  local repo_root="$1"
  local parent=""

  parent="$(dirname "$repo_root")"

  if [[ -n "$TASKS_DIR" && -d "$TASKS_DIR" && -d "$parent" ]] && [[ "$parent" -ef "$TASKS_DIR" ]]; then
    die "park must be run from a primary repo under $REPO_DIR, not from the tasks directory"
  fi

  case "$repo_root" in
    "$TASKS_DIR"|"$TASKS_DIR"/*)
      die "park must be run from a primary repo under $REPO_DIR, not from the tasks directory"
      ;;
  esac

  # -ef rather than a string compare: git reports the physical path, so any
  # symlink in IWORK_REPO_DIR (/var -> /private/var on macOS, or a symlinked
  # dev directory) would otherwise fail a prefix match that is actually correct.
  if [[ ! -d "$parent" ]] || [[ ! "$parent" -ef "$REPO_DIR" ]]; then
    die "repo '$repo_root' must be a direct child of $REPO_DIR"
  fi
}

current_repo_name() {
  local repo_root="$1"
  local repo_name="${repo_root##*/}"

  validate_repo_name "$repo_name"
  printf '%s\n' "$repo_name"
}

current_branch_name() {
  local repo_root="$1"
  local branch=""

  branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
  [[ -n "$branch" ]] || die "repository is in detached HEAD state"
  validate_branch "$branch"
  printf '%s\n' "$branch"
}

switch_repo_to_base_branch() {
  local repo_root="$1"
  local base_ref=""
  local base_branch=""

  base_ref="$(resolve_base_ref "$repo_root")" || die "could not determine a base branch for $(basename "$repo_root")"
  base_branch="${base_ref#origin/}"

  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$base_branch" 2>/dev/null; then
    git -C "$repo_root" switch "$base_branch" >/dev/null
  else
    git -C "$repo_root" switch -c "$base_branch" --track "$base_ref" >/dev/null
  fi
}

resolve_park_target_path() {
  local folder_name="$1"
  local repo_root=""
  local repo_name=""

  validate_worktree_folder_name "$folder_name"

  repo_root="$(current_repo_root)"
  validate_primary_repo_root "$repo_root"

  repo_name="$(current_repo_name "$repo_root")"
  # The branch no longer shapes the path, but park still refuses a detached
  # HEAD, so keep failing here before the caller cds anywhere.
  current_branch_name "$repo_root" >/dev/null

  printf '%s\n' "$TASKS_DIR/$folder_name/$repo_name"
}

park_current_repo() {
  local folder_name="$1"
  local project="${2:-}"
  local repo_root=""
  local repo_name=""
  local branch=""
  local wt_path=""
  local folder_path=""
  local status_output=""
  local stash_created=""
  local stash_ref=""

  validate_worktree_folder_name "$folder_name"

  repo_root="$(current_repo_root)"
  validate_primary_repo_root "$repo_root"
  repo_name="$(current_repo_name "$repo_root")"
  branch="$(current_branch_name "$repo_root")"
  folder_path="$TASKS_DIR/$folder_name"
  wt_path="$folder_path/$repo_name"

  case "$branch" in
    main|master|trunk)
      die "refusing to park base branch '$branch'"
      ;;
  esac

  if [[ -e "$wt_path" ]]; then
    die "destination already exists: $wt_path"
  fi

  status_output="$(git -C "$repo_root" status --porcelain --untracked-files=all)"
  if [[ -n "$status_output" ]]; then
    stash_created=1
    git -C "$repo_root" stash push --include-untracked --message "iwork park: $repo_name $branch" >/dev/null
    stash_ref="stash@{0}"
  fi

  switch_repo_to_base_branch "$repo_root"

  mkdir -p "$folder_path"
  echo "Using $folder_path"
  git -C "$repo_root" worktree add "$wt_path" "$branch"
  echo "  -> $repo_name (branch: $branch)"

  if [[ -n "$stash_created" ]]; then
    if git -C "$wt_path" stash apply --index "$stash_ref" >/dev/null 2>&1; then
      git -C "$wt_path" stash drop "$stash_ref" >/dev/null 2>&1 || true
      echo "  -> restored stashed changes into parked worktree"
    else
      die "parked worktree created at $wt_path, but applying stashed changes failed; stash was kept as $stash_ref"
    fi
  fi

  echo ""
  echo "Done! Worktree parked at:"
  echo "  $wt_path"

  write_task_context "$folder_name" "$branch"

  if [[ -n "$project" ]]; then
    attach_task_to_project "$folder_name" "$project" "$branch"
  fi

  agent_message_args
  open_task "$folder_name" claude ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"}
}

detect_branch_from_worktree_folder() {
  local folder="$1"
  local folder_path=""
  local child_path=""
  local branch=""
  local detected_branch=""

  folder_path="$(resolve_worktree_folder "$folder")"

  for child_path in "$folder_path"/*; do
    [[ -d "$child_path" ]] || continue

    if ! is_git_repo "$child_path"; then
      continue
    fi

    branch="$(git -C "$child_path" branch --show-current 2>/dev/null || true)"
    [[ -n "$branch" ]] || continue

    validate_branch "$branch"

    if [[ -z "$detected_branch" ]]; then
      detected_branch="$branch"
      continue
    fi

    if [[ "$detected_branch" != "$branch" ]]; then
      die "worktree folder '$folder' contains multiple branches ('$detected_branch' and '$branch')"
    fi
  done

  [[ -n "$detected_branch" ]] || die "could not determine a branch from existing worktrees in $folder"
  printf '%s\n' "$detected_branch"
}

is_worktree_root() {
  local path="$1"
  local top=""

  top="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ -n "$top" && "$top" -ef "$path" ]]
}

# The repository a worktree belongs to, derived from its git common dir rather
# than from the folder name, so worktrees created by older versions of iwork
# (repo--branch-slug) still resolve.
worktree_main_repo_dir() {
  local wt_path="$1"
  local common_dir=""

  common_dir="$(git -C "$wt_path" rev-parse --git-common-dir 2>/dev/null)" || return 1
  [[ -n "$common_dir" ]] || return 1

  case "$common_dir" in
    /*) ;;
    *) common_dir="$wt_path/$common_dir" ;;
  esac

  (cd "$common_dir/.." && pwd) 2>/dev/null
}

list_task_worktrees() {
  local folder_path="$1"
  local child=""

  for child in "$folder_path"/*; do
    [[ -d "$child" ]] || continue
    is_worktree_root "$child" || continue
    printf '%s\n' "$child"
  done
}

# Directories that were worktrees but whose registration is gone: they still
# carry a .git that no longer resolves, usually because the directory was
# renamed with plain mv and git later pruned the missing path. git can tell us
# nothing about these, so removing one is a plain directory delete.
list_task_orphans() {
  local folder_path="$1"
  local child=""

  for child in "$folder_path"/*; do
    [[ -d "$child" ]] || continue
    [[ -e "$child/.git" ]] || continue
    is_worktree_root "$child" && continue
    printf '%s\n' "$child"
  done
}

confirm() {
  local prompt="$1"
  local answer=""

  [[ "${IWORK_ASSUME_YES:-}" == "1" ]] && return 0

  if ! { : </dev/tty; } 2>/dev/null; then
    die "no TTY available for confirmation; re-run with -f or IWORK_ASSUME_YES=1"
  fi

  printf '%s [y/N] ' "$prompt"
  IFS= read -r answer </dev/tty
  case "$answer" in
    y|Y) return 0 ;;
    *) return 1 ;;
  esac
}

kill_task_tmux() {
  local folder="$1"
  local session=""
  local current_session=""
  local line=""
  local window_id=""
  local current_id=""

  # Not tmux_enabled: killing a window or session needs tmux installed, not tmux
  # attached. Gating on in_tmux meant 'iwork rm' run from a plain shell left the
  # task's session (and any editors in it) orphaned, contrary to what rm says it
  # does.
  [[ -z "$IWORK_NO_TMUX" ]] || return 0
  command -v tmux >/dev/null 2>&1 || return 0

  # A --big task owns its session, so the whole session goes.
  if session="$(resolve_session_name "$(task_session_name "$folder")")"; then
    # Only meaningful when a client is actually attached: with none, tmux still
    # reports *a* current session, which made this refuse to kill anything.
    current_session=""
    in_tmux && current_session="$(tmux display-message -p '#{session_name}' 2>/dev/null || true)"
    if [[ -n "$current_session" && "$current_session" == "$session" ]]; then
      warn "you are attached to tmux session '$session'; close it yourself"
      return 0
    fi
    tmux kill-session -t "=$session" 2>/dev/null || warn "could not kill tmux session '$session'"
    return 0
  fi

  line="$(find_window_in_session "$TASKS_SESSION" "$folder")" || return 0
  window_id="${line%% *}"

  current_id=""
  in_tmux && current_id="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
  if [[ -n "$current_id" && "$current_id" == "$window_id" ]]; then
    warn "tmux window '$folder' is the current window; close it yourself"
    return 0
  fi

  tmux kill-window -t "$window_id" 2>/dev/null || warn "could not kill tmux window '$folder'"

  # That window may have been the one thing the session's marker was reporting.
  refresh_session_marker "$TASKS_SESSION"
}

remove_worktrees() {
  local folder="$1"
  local force="$2"
  shift 2
  local repos=("$@")
  local folder_path=""
  local worktrees=()
  local orphans=()
  local targets=()
  local orphan_targets=()
  local dirty=()
  local repo=""
  local wt=""
  local name=""
  local matched=""
  local repo_root=""
  local failed=""
  local remove_all=""
  local target=""
  local session=""
  local project=""
  local project_branch=""
  local project_repos=""

  folder_path="$(resolve_worktree_folder "$folder")"
  (( ${#repos[@]} == 0 )) && remove_all=1

  # Read the task's shape before anything is deleted: this is the last moment
  # the branch and repo list can still be recovered.
  project="$(task_project_name "$folder" || true)"
  if [[ -n "$project" ]] && project_exists "$project"; then
    project_branch="$(detect_branch_from_worktree_folder "$folder" 2>/dev/null || true)"
    project_repos="$(task_repos_csv "$folder")"
  else
    project=""
  fi

  while IFS= read -r wt; do
    [[ -n "$wt" ]] && worktrees+=("$wt")
  done < <(list_task_worktrees "$folder_path")

  while IFS= read -r wt; do
    [[ -n "$wt" ]] && orphans+=("$wt")
  done < <(list_task_orphans "$folder_path")

  if (( ${#worktrees[@]} == 0 && ${#orphans[@]} == 0 )); then
    if [[ -z "$remove_all" ]]; then
      die "no git worktrees found in $folder_path"
    fi
    warn "no git worktrees found in $folder_path"
  fi

  if [[ -n "$remove_all" ]]; then
    targets=("${worktrees[@]+${worktrees[@]}}")
    orphan_targets=("${orphans[@]+${orphans[@]}}")
  else
    for repo in "${repos[@]}"; do
      validate_repo_name "$repo"
      matched=""
      # Current layout names the worktree after the repo; older ones used
      # repo--branch-slug.
      for wt in "${worktrees[@]+${worktrees[@]}}"; do
        name="${wt##*/}"
        if [[ "$name" == "$repo" || "$name" == "$repo"--* ]]; then
          targets+=("$wt")
          matched=1
        fi
      done
      for wt in "${orphans[@]+${orphans[@]}}"; do
        name="${wt##*/}"
        if [[ "$name" == "$repo" || "$name" == "$repo"--* ]]; then
          orphan_targets+=("$wt")
          matched=1
        fi
      done
      [[ -n "$matched" ]] || die "repo '$repo' has no worktree in task '$folder'"
    done
  fi

  for wt in "${targets[@]+${targets[@]}}"; do
    if [[ -n "$(git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null || true)" ]]; then
      dirty+=("${wt##*/}")
    fi
  done

  echo "Removing from $folder_path:"
  for wt in "${targets[@]+${targets[@]}}"; do
    echo "  - ${wt##*/}"
  done
  for wt in "${orphan_targets[@]+${orphan_targets[@]}}"; do
    echo "  - ${wt##*/}  (orphaned: registration gone, deleted as a plain directory)"
  done

  if [[ -n "$remove_all" ]]; then
    echo "  - the task folder itself"

    # Worth spelling out: killing the session takes any editors with it.
    if tmux_enabled && session="$(resolve_session_name "$(task_session_name "$folder")")"; then
      echo "  - tmux session '$session' and everything running in it"
    fi
  fi

  if (( ${#dirty[@]} > 0 )); then
    echo ""
    echo "Uncommitted changes in: ${dirty[*]}"
    [[ -n "$force" ]] || die "refusing to remove worktrees with uncommitted changes; re-run with -f"
  fi

  if (( ${#orphan_targets[@]} > 0 )) && [[ -z "$force" ]]; then
    echo ""
    die "orphaned directories cannot be checked for uncommitted work; re-run with -f to delete them"
  fi

  echo ""
  if [[ -z "$force" ]]; then
    confirm "Proceed?" || die "aborted"
  fi

  for wt in "${targets[@]+${targets[@]}}"; do
    name="${wt##*/}"

    if ! repo_root="$(worktree_main_repo_dir "$wt")" || [[ -z "$repo_root" ]]; then
      warn "could not determine the repository for $wt; left in place"
      failed=1
      continue
    fi

    if git -C "$repo_root" worktree remove ${force:+--force} "$wt" 2>/dev/null; then
      echo "  -> removed $name"
    else
      warn "git worktree remove failed for $wt; left in place"
      failed=1
      continue
    fi

    git -C "$repo_root" worktree prune 2>/dev/null || true
  done

  # Only reachable with -f, which the orphan check above enforces.
  for wt in "${orphan_targets[@]+${orphan_targets[@]}}"; do
    name="${wt##*/}"

    if rm -rf "$wt"; then
      echo "  -> deleted orphaned $name"
    else
      warn "could not delete $wt; left in place"
      failed=1
    fi
  done

  if [[ -z "$remove_all" ]]; then
    # The task survives with fewer repos, so its context files need to say so.
    refresh_task_blocks "$folder" "$project_branch"
    echo ""
    echo "Done! Branches were left untouched."
    return 0
  fi

  # The task is gone either way, so its window/session goes too — and killing
  # it first stops any editor from writing the folder back up under us.
  kill_task_tmux "$folder"

  if [[ -n "$failed" ]]; then
    die "some worktrees could not be removed; kept $folder_path"
  fi

  # rm is the one moment iwork is guaranteed to be called and the knowledge is
  # guaranteed to be destroyed, so the record gets written here.
  if [[ -n "$project" ]]; then
    append_history "$project" closed "$folder" "$project_repos" "$project_branch" ""
    echo "  -> recorded in project '$project'"
  fi

  # Generated for the agent that ran here, so they go with the task. No trailing
  # slash on .project: it is a symlink into the project dir, and 'rm -rf link/'
  # would delete the project memory instead of the link.
  for target in "$folder_path/CLAUDE.md" "$folder_path/AGENTS.md" "$folder_path/.claude" "$folder_path/.project"; do
    [[ -e "$target" || -L "$target" ]] || continue
    rm -rf "$target" || warn "could not remove $target"
  done

  if rmdir "$folder_path" 2>/dev/null; then
    echo "  -> removed ${folder_path##*/}"
  else
    warn "$folder_path is not empty; kept it (worktrees are gone)"
    warn "  remaining: $(ls -A "$folder_path" 2>/dev/null | tr '\n' ' ')"
  fi

  echo ""
  echo "Done! Branches were left untouched."
}

parse_repos_flag() {
  local missing_flag_message="$1"
  shift

  repos=()

  if [[ "${1:-}" != "-r" ]]; then
    die "$missing_flag_message"
  fi
  shift

  while [[ $# -gt 0 ]]; do
    # Everything after -r used to become a repo name, so a misplaced flag was
    # reported as a missing repository ('.../-p is not a git repository').
    case "$1" in
      -*) die "unexpected option '$1' after -r; it must come before the repo list" ;;
    esac
    repos+=("$1")
    shift
  done

  if [[ ${#repos[@]} -eq 0 ]]; then
    die "specify at least one repo after -r"
  fi
}

# Consumes one flag from the front of "$@" and reports how many arguments it
# took in FLAG_SHIFT, or 0 when $1 is not a flag of ours. Shared by the leading
# flag loop and parse_task_args so both accept exactly the same spellings.
take_task_flag() {
  FLAG_SHIFT=0

  case "${1:-}" in
    --no-tmux) IWORK_NO_TMUX=1; FLAG_SHIFT=1 ;;
    --no-context) IWORK_NO_CONTEXT=1; FLAG_SHIFT=1 ;;
    -d|--detach) IWORK_DETACH=1; FLAG_SHIFT=1 ;;
    --big) IWORK_BIG=1; FLAG_SHIFT=1 ;;
    --from)
      [[ $# -gt 1 ]] || die "--from needs a task or branch name"
      BASE_SPEC="$2"
      validate_base_spec "$BASE_SPEC"
      FLAG_SHIFT=2
      ;;
    -m|--message)
      [[ $# -gt 1 ]] || die "-m needs a message"
      INITIAL_MESSAGE="$2"
      validate_initial_message "$INITIAL_MESSAGE"
      FLAG_SHIFT=2
      ;;
  esac
}

# Flags and '-r <repos>' in any order, so a message or --detach reads naturally
# at the end of the line. Repo names never start with '-', so the first flag
# after -r ends the repo list.
parse_task_args() {
  local missing_flag_message="$1"
  shift

  repos=()

  while [[ $# -gt 0 ]]; do
    take_task_flag "$@"
    if (( FLAG_SHIFT > 0 )); then
      shift "$FLAG_SHIFT"
      continue
    fi

    case "$1" in
      -h|--help)
        usage 0
        ;;
      -p|--project)
        [[ $# -gt 1 ]] || die "expected a project name after $1"
        PROJECT_FLAG="$2"
        validate_project_name "$PROJECT_FLAG"
        shift 2
        ;;
      -r)
        [[ ${#repos[@]} -eq 0 ]] || die "-r was given more than once"
        shift
        while [[ $# -gt 0 && "$1" != -* ]]; do
          repos+=("$1")
          shift
        done
        [[ ${#repos[@]} -gt 0 ]] || die "specify at least one repo after -r"
        ;;
      *)
        die "unexpected argument '$1'"
        ;;
    esac
  done

  [[ ${#repos[@]} -gt 0 ]] || die "$missing_flag_message"
}

create_worktrees() {
  local branch="$1"
  local folder_name="$2"
  local folder_path="$TASKS_DIR/$folder_name"
  local seen_repos=""
  local base_refs=()
  local repo=""
  local repo_path=""
  local wt_path=""
  local base_ref=""
  local i=""

  shift 2
  local repos=("$@")

  if [[ -n "$BASE_SPEC" ]]; then
    [[ "$BASE_SPEC" != "$folder_name" ]] || die "a task cannot be based on itself"
    base_spec_is_resolvable "${repos[@]}" ||
      die "no task folder or branch named '$BASE_SPEC' to build on"
  fi

  for repo in "${repos[@]}"; do
    repo_path=""
    wt_path=""
    base_ref=""

    validate_repo_name "$repo"

    case " $seen_repos " in
      *" $repo "*) die "repo '$repo' was provided more than once" ;;
    esac
    seen_repos="$seen_repos $repo"

    repo_path="$REPO_DIR/$repo"
    if ! is_git_repo "$repo_path"; then
      die "$repo_path is not a git repository"
    fi

    wt_path="$folder_path/$repo"

    if [[ -e "$wt_path" ]] && ! is_registered_worktree_path "$repo_path" "$wt_path"; then
      die "destination already exists and is not a registered git worktree: $wt_path"
    fi

    if git -C "$repo_path" remote get-url origin >/dev/null 2>&1; then
      if ! git -C "$repo_path" fetch origin --quiet 2>/dev/null; then
        warn "could not fetch origin for $repo; using local refs"
      fi
    fi

    if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
      base_refs+=("")
      continue
    fi

    if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null; then
      die "branch '$branch' already exists on origin for $repo"
    fi

    base_ref="$(resolve_task_base_ref "$repo" "$repo_path")" || die "could not determine a base branch for $repo"
    base_refs+=("$base_ref")
  done

  mkdir -p "$folder_path"
  echo "Using $folder_path"

  for i in "${!repos[@]}"; do
    repo="${repos[$i]}"
    repo_path="$REPO_DIR/$repo"
    wt_path="$folder_path/$repo"
    base_ref="${base_refs[$i]}"

    if [[ -e "$wt_path" ]]; then
      echo "Skipping $repo (already exists)"
      continue
    fi

    if [[ -n "$base_ref" ]]; then
      # --no-track: branching from origin/main would otherwise make it the
      # upstream, so status and prompts would report the fresh branch as
      # ahead/behind a branch it has nothing to do with. Push with
      # 'git push -u origin HEAD' to set a real upstream.
      git -C "$repo_path" worktree add --no-track -b "$branch" "$wt_path" "$base_ref"
      echo "  -> $repo (branch: $branch, from $base_ref)"
      continue
    fi

    git -C "$repo_path" worktree add "$wt_path" "$branch"
    echo "  -> $repo (branch: $branch)"
  done

  echo ""
  echo "Done! Worktrees ready at:"
  echo "  $folder_path"
}

print_bash_completion() {
  local self_path_q=""

  printf -v self_path_q '%q' "$SELF_PATH"

  printf '_iwork_bin=%s\n\n' "$self_path_q"
  cat <<'EOF'
iwork() {
  local cmd=""
  local folder=""
  local target=""
  local arg=""
  local notmux=""
  local msg=""
  local lead=()
  local _bin="${_iwork_bin:-}"

  # A shell snapshot — how a non-interactive shell such as an agent's Bash tool
  # inherits these functions — captures the function but not the _iwork_bin
  # assignment emitted beside it. Without this the wrapper tried to execute the
  # empty string ("permission denied: ") and nothing was reachable.
  [[ -n "$_bin" ]] || _bin="$(type -P iwork 2>/dev/null)"
  if [[ -z "$_bin" ]]; then
    echo "iwork: cannot locate the iwork binary on PATH; re-source the shell integration" >&2
    return 127
  fi

  # Flags can precede the subcommand, so skip them to find it -- otherwise
  # 'iwork -m msg park x' misses the park branch and its cd. -m and --from
  # take a value; the guard keeps 'iwork -m' from looping forever.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-tmux) notmux=1; lead+=("$1"); shift ;;
      --no-context|--detach|-d|--big) lead+=("$1"); shift ;;
      -m|--message)
        [[ $# -ge 2 ]] || break
        msg="$2"; lead+=("$1" "$2"); shift 2 ;;
      --from)
        [[ $# -ge 2 ]] || break
        lead+=("$1" "$2"); shift 2 ;;
      *) break ;;
    esac
  done

  cmd="${1:-}"

  case "$cmd" in
    rm)
      if [[ $# -lt 2 ]]; then
        command "$_bin" rm
        return $?
      fi

      shift
      target=""
      for arg in "$@"; do
        case "$arg" in
          -*) ;;
          *)
            target="$(command "$_bin" --resolve-worktree-folder "$arg" 2>/dev/null)"
            break
            ;;
        esac
      done

      command "$_bin" ${lead[@]+"${lead[@]}"} rm "$@" || return $?

      # The folder we were standing in may be gone now.
      if [[ -n "$target" && ! -d "$target" && "$PWD" == "$target"* ]]; then
        builtin cd "${target%/*}" || return $?
      fi
      ;;
    park)
      if [[ $# -lt 2 ]]; then
        command "$_bin" park
        return $?
      fi

      # The task name is not necessarily $2: 'park -p proj task' is accepted.
      shift
      folder=""
      for arg in "$@"; do
        case "$arg" in
          -p|--project) skip_next=1 ;;
          -*) ;;
          *)
            if [[ -n "${skip_next:-}" ]]; then
              skip_next=""
            else
              folder="$arg"
              break
            fi
            ;;
        esac
      done
      unset skip_next
      [[ -n "$folder" ]] || { command "$_bin" park; return $?; }
      target="$(command "$_bin" --resolve-park-target-path "$folder")" || return $?
      command "$_bin" ${lead[@]+"${lead[@]}"} park "$@" || return $?
      if [[ -z "${TMUX:-}" || -n "$notmux" ]]; then
        builtin cd "$target" || return $?
      fi
      ;;
    cd)
      if [[ $# -lt 2 ]]; then
        command "$_bin" cd
        return $?
      fi

      folder="$2"
      shift 2
      if [[ -n "${TMUX:-}" && -z "$notmux" ]] && command "$_bin" --switch-task-window "$folder" 2>/dev/null; then
        return 0
      fi
      target="$(command "$_bin" --resolve-worktree-folder "$folder")" || return $?
      builtin cd "$target" || return $?
      ;;
    claude|codex)
      if [[ $# -lt 2 ]]; then
        command "$_bin" "$cmd"
        return $?
      fi

      folder="$2"
      shift 2
      if [[ -n "${TMUX:-}" && -z "$notmux" ]]; then
        command "$_bin" ${lead[@]+"${lead[@]}"} "$cmd" "$folder" "$@"
        return $?
      fi
      target="$(command "$_bin" --resolve-worktree-folder "$folder")" || return $?
      builtin cd "$target" || return $?
      if [[ -n "$msg" ]]; then
        "$cmd" "$@" -- "$msg"
      else
        "$cmd" "$@"
      fi
      ;;
    *)
      command "$_bin" ${lead[@]+"${lead[@]}"} "$@"
      ;;
  esac
}

_iwork() {
  local cur prev seen_r i repos folders folder cmd cmd_i projects sub
  local _bin="${_iwork_bin:-}"

  # A shell snapshot — how a non-interactive shell such as an agent's Bash tool
  # inherits these functions — captures the function but not the _iwork_bin
  # assignment emitted beside it. Without this the wrapper tried to execute the
  # empty string ("permission denied: ") and nothing was reachable.
  [[ -n "$_bin" ]] || _bin="$(type -P iwork 2>/dev/null)"

  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev=""

  if (( COMP_CWORD > 0 )); then
    prev="${COMP_WORDS[COMP_CWORD-1]}"
  fi

  # Flags may precede the subcommand, so find the first word that is not one
  # (or a flag's value) rather than assuming index 1.
  cmd=""
  cmd_i=0
  for ((i = 1; i < COMP_CWORD; i++)); do
    case "${COMP_WORDS[i]}" in
      -m|--message|--from) (( i++ )) ;;
      -*) ;;
      *) cmd="${COMP_WORDS[i]}"; cmd_i=$i; break ;;
    esac
  done

  # -p takes a project name wherever it appears.
  if [[ "$prev" == "-p" || "$prev" == "--project" ]]; then
    projects="$("$_bin" --complete-projects "$cur" 2>/dev/null)" || return 0
    COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
    return 0
  fi

  case "$cmd" in
    project)
      sub="${COMP_WORDS[2]:-}"
      if (( COMP_CWORD == 2 )); then
        COMPREPLY=( $(compgen -W "list show agents grep cat add rm delete" -- "$cur") )
        return 0
      fi
      case "$sub" in
        show|agents|grep|cat|delete)
          if [[ "$sub" == "agents" && "$cur" == -* ]]; then
            COMPREPLY=( $(compgen -W "--json --tsv -p --project" -- "$cur") )
            return 0
          fi
          if (( COMP_CWORD == 3 )); then
            projects="$("$_bin" --complete-projects "$cur" 2>/dev/null)" || return 0
            COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
          fi
          ;;
        add|rm)
          if (( COMP_CWORD == 3 )); then
            projects="$("$_bin" --complete-projects "$cur" 2>/dev/null)" || return 0
            COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
          elif (( COMP_CWORD == 4 )); then
            folders="$("$_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
            COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
          fi
          ;;
      esac
      return 0
      ;;
    todo|log|decided|done|drop)
      if [[ "$cur" == -* ]]; then
        if [[ "$cmd" == "log" ]]; then
          COMPREPLY=( $(compgen -W "-p --project --decision --shipped --note" -- "$cur") )
        else
          COMPREPLY=( $(compgen -W "-p --project" -- "$cur") )
        fi
      fi
      return 0
      ;;
    cd|claude|codex)
      if (( COMP_CWORD == cmd_i + 1 )); then
        folders="$("$_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
        COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
      fi
      return 0
      ;;
    add-repo|rm)
      if (( COMP_CWORD == cmd_i + 1 )); then
        folders="$("$_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
        COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
        return 0
      fi
      ;;
    master)
      if (( COMP_CWORD == cmd_i + 1 )); then
        projects="$("$_bin" --complete-projects "$cur" 2>/dev/null)" || return 0
        COMPREPLY=( $(compgen -W "$projects" -- "$cur") )
      fi
      return 0
      ;;
    park)
      return 0
      ;;
    list)
      return 0
      ;;
    init)
      return 0
      ;;
    install-hooks)
      return 0
      ;;
  esac

  # A message is free text, so offering repo or task names there is only noise.
  if [[ "$prev" == "-m" || "$prev" == "--message" ]]; then
    return 0
  fi

  # --from takes an existing task (or a branch, which we cannot complete)
  if [[ "$prev" == "--from" ]]; then
    folders="$("$_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
    COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
    return 0
  fi

  seen_r=""
  for ((i = 1; i < COMP_CWORD; i++)); do
    if [[ "${COMP_WORDS[i]}" == "-r" ]]; then
      seen_r=1
      break
    fi
  done

  if [[ "$prev" == "-r" || -n "$seen_r" ]]; then
    if [[ "$cur" == -* && "$cmd" != "rm" ]]; then
      COMPREPLY=( $(compgen -W "--message -m --detach -d --big --from --no-tmux --no-context" -- "$cur") )
      return 0
    fi

    # For rm, only the repos that actually have a worktree in the task.
    if [[ "$cmd" == "rm" ]]; then
      folder=""
      for ((i = cmd_i + 1; i < COMP_CWORD; i++)); do
        case "${COMP_WORDS[i]}" in
          -*) ;;
          *) folder="${COMP_WORDS[i]}"; break ;;
        esac
      done
    fi

    if [[ "$cmd" == "rm" && -n "$folder" ]]; then
      repos="$("$_bin" --complete-task-worktrees "$folder" "$cur" 2>/dev/null)" || return 0
    else
      repos="$("$_bin" --complete-repos "$cur" 2>/dev/null)" || return 0
    fi
    COMPREPLY=( $(compgen -W "$repos" -- "$cur") )
    return 0
  fi

  if [[ -z "$cmd" ]]; then
    COMPREPLY=( $(compgen -W "add-repo rm park list cd claude codex master project todo log decided done drop init install-hooks --no-tmux --no-context --detach -d --big --from --message -m -h --help --completion" -- "$cur") )
    return 0
  fi

  if [[ "$cur" == -* ]]; then
    if [[ "$cmd" == "rm" ]]; then
      COMPREPLY=( $(compgen -W "-r -f" -- "$cur") )
    elif [[ "$cmd" == "park" ]]; then
      COMPREPLY=( $(compgen -W "-p --project" -- "$cur") )
    else
      COMPREPLY=( $(compgen -W "-r -p --project --from --message -m -h --help --completion --no-tmux --no-context --detach -d --big" -- "$cur") )
    fi
    return 0
  fi

  if (( COMP_CWORD >= 2 )); then
    COMPREPLY=( $(compgen -W "-r -p" -- "$cur") )
  fi
}

complete -o nospace -F _iwork iwork
EOF
}

print_zsh_completion() {
  local self_path_q=""

  printf -v self_path_q '%q' "$SELF_PATH"

  printf '_iwork_bin=%s\n\n' "$self_path_q"
  cat <<'EOF'
iwork() {
  local cmd=""
  local folder=""
  local target=""
  local arg=""
  local notmux=""
  local msg=""
  local lead=()
  local _bin="${_iwork_bin:-}"

  # A shell snapshot — how a non-interactive shell such as an agent's Bash tool
  # inherits these functions — captures the function but not the _iwork_bin
  # assignment emitted beside it. Without this the wrapper tried to execute the
  # empty string ("permission denied: ") and nothing was reachable.
  [[ -n "$_bin" ]] || _bin="$(whence -p iwork 2>/dev/null)"
  if [[ -z "$_bin" ]]; then
    echo "iwork: cannot locate the iwork binary on PATH; re-source the shell integration" >&2
    return 127
  fi

  # Flags can precede the subcommand, so skip them to find it -- otherwise
  # 'iwork -m msg park x' misses the park branch and its cd. -m and --from
  # take a value; the guard keeps 'iwork -m' from looping forever.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-tmux) notmux=1; lead+=("$1"); shift ;;
      --no-context|--detach|-d|--big) lead+=("$1"); shift ;;
      -m|--message)
        [[ $# -ge 2 ]] || break
        msg="$2"; lead+=("$1" "$2"); shift 2 ;;
      --from)
        [[ $# -ge 2 ]] || break
        lead+=("$1" "$2"); shift 2 ;;
      *) break ;;
    esac
  done

  cmd="${1:-}"

  case "$cmd" in
    rm)
      if [[ $# -lt 2 ]]; then
        command "$_bin" rm
        return $?
      fi

      shift
      target=""
      for arg in "$@"; do
        case "$arg" in
          -*) ;;
          *)
            target="$(command "$_bin" --resolve-worktree-folder "$arg" 2>/dev/null)"
            break
            ;;
        esac
      done

      command "$_bin" ${lead[@]+"${lead[@]}"} rm "$@" || return $?

      # The folder we were standing in may be gone now.
      if [[ -n "$target" && ! -d "$target" && "$PWD" == "$target"* ]]; then
        builtin cd "${target%/*}" || return $?
      fi
      ;;
    park)
      if [[ $# -lt 2 ]]; then
        command "$_bin" park
        return $?
      fi

      # The task name is not necessarily $2: 'park -p proj task' is accepted.
      shift
      folder=""
      for arg in "$@"; do
        case "$arg" in
          -p|--project) skip_next=1 ;;
          -*) ;;
          *)
            if [[ -n "${skip_next:-}" ]]; then
              skip_next=""
            else
              folder="$arg"
              break
            fi
            ;;
        esac
      done
      unset skip_next
      [[ -n "$folder" ]] || { command "$_bin" park; return $?; }
      target="$(command "$_bin" --resolve-park-target-path "$folder")" || return $?
      command "$_bin" ${lead[@]+"${lead[@]}"} park "$@" || return $?
      if [[ -z "${TMUX:-}" || -n "$notmux" ]]; then
        builtin cd "$target" || return $?
      fi
      ;;
    cd)
      if [[ $# -lt 2 ]]; then
        command "$_bin" cd
        return $?
      fi

      folder="$2"
      shift 2
      if [[ -n "${TMUX:-}" && -z "$notmux" ]] && command "$_bin" --switch-task-window "$folder" 2>/dev/null; then
        return 0
      fi
      target="$(command "$_bin" --resolve-worktree-folder "$folder")" || return $?
      builtin cd "$target" || return $?
      ;;
    claude|codex)
      if [[ $# -lt 2 ]]; then
        command "$_bin" "$cmd"
        return $?
      fi

      folder="$2"
      shift 2
      if [[ -n "${TMUX:-}" && -z "$notmux" ]]; then
        command "$_bin" ${lead[@]+"${lead[@]}"} "$cmd" "$folder" "$@"
        return $?
      fi
      target="$(command "$_bin" --resolve-worktree-folder "$folder")" || return $?
      builtin cd "$target" || return $?
      if [[ -n "$msg" ]]; then
        "$cmd" "$@" -- "$msg"
      else
        "$cmd" "$@"
      fi
      ;;
    *)
      command "$_bin" ${lead[@]+"${lead[@]}"} "$@"
      ;;
  esac
}

