      ;;
  esac
}

#compdef iwork

_iwork() {
  local -a repos folders
  local cmd="${words[2]:-}"

  if (( CURRENT == 2 )); then
    _values 'command' \
      'add-repo[add repos to an existing worktree folder]' \
      'park[move the current repo branch into a worktree folder]' \
      'list[list worktree folders]' \
      'cd[cd into a worktree folder]' \
      'claude[cd into a worktree folder and run claude]' \
      'codex[cd into a worktree folder and run codex]' \
      '--completion[print shell integration]'
    return 0
  fi

  case "$cmd" in
    cd|claude|codex|add-repo)
      if (( CURRENT == 3 )); then
        folders=("${(@f)$("$_iwork_bin" --complete-worktree-folders "$PREFIX" 2>/dev/null)}")
        _describe -t folders 'worktree folder' folders
      fi
      return 0
      ;;
    park)
      return 0
      ;;
    list)
      return 0
      ;;
  esac

  if (( CURRENT == 3 )); then
    _values 'option' '-r[repos to create worktrees for]'
    return 0
  fi

  if (( ${words[(I)-r]} <= CURRENT )); then
    repos=("${(@f)$("$_iwork_bin" --complete-repos "$PREFIX" 2>/dev/null)}")
    _describe -t repos 'repo' repos
  fi
}

if typeset -f compdef >/dev/null 2>&1; then
  compdef _iwork iwork
fi
EOF
}

resolve_base_ref() {
  local repo_path="$1"
  local ref=""
  local candidate=""

  if ref=$(git -C "$repo_path" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "$ref"
    return 0
  fi

  for candidate in main master trunk; do
    if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$candidate" 2>/dev/null; then
      printf 'origin/%s\n' "$candidate"
      return 0
    fi
  done

  for candidate in main master trunk; do
    if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$candidate" 2>/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

is_registered_worktree_path() {
  local repo_path="$1"
  local wt_path="$2"

  git -C "$repo_path" worktree list --porcelain 2>/dev/null | grep -F -x "worktree $wt_path" >/dev/null 2>&1
}

in_tmux() {
  [[ -n "${TMUX:-}" ]]
}

tmux_enabled() {
  in_tmux && [[ -z "$IWORK_NO_TMUX" ]]
}

find_task_window() {
  local folder="$1"
  local window_id=""
  local window_name=""

  while IFS=' ' read -r window_id window_name; do
    if [[ "${window_name#[*!]}" == "$folder" ]]; then
      printf '%s\n' "$window_id"
      return 0
    fi
  done < <(tmux list-windows -t "=$TASKS_SESSION" -F '#{window_id} #{window_name}' 2>/dev/null)

  return 1
}

open_task_window() {
  local folder="$1"
  local tool="$2"
  shift 2
  local folder_path="$WORKTREES_DIR/$folder"
  local window_id=""
  local pane_id=""
  local tool_cmd=""

  tmux_enabled || return 0
  [[ -d "$folder_path" ]] || return 0

  if window_id="$(find_task_window "$folder")"; then
    tmux select-window -t "$window_id" 2>/dev/null || warn "could not select tmux window '$folder'"
    tmux switch-client -t "=$TASKS_SESSION" 2>/dev/null || true
    return 0
  fi

  if tmux has-session -t "=$TASKS_SESSION" 2>/dev/null; then
    if ! IFS=' ' read -r window_id pane_id < <(tmux new-window -t "=$TASKS_SESSION" -n "$folder" -c "$folder_path" -P -F '#{window_id} #{pane_id}' 2>/dev/null); then
      warn "could not create tmux window '$folder'"
      return 0
    fi
  else
    if ! IFS=' ' read -r window_id pane_id < <(tmux new-session -d -s "$TASKS_SESSION" -n "$folder" -c "$folder_path" -P -F '#{window_id} #{pane_id}' 2>/dev/null); then
      warn "could not create tmux session '$TASKS_SESSION'"
      return 0
    fi
  fi

  tmux split-window -h -t "$pane_id" -c "$folder_path" 2>/dev/null || warn "could not split tmux window '$folder'"
  tmux select-pane -t "$pane_id" 2>/dev/null || true

  printf -v tool_cmd '%q ' "$tool" "$@"
  tmux send-keys -t "$pane_id" "$tool_cmd" Enter 2>/dev/null || warn "could not start $tool in tmux window '$folder'"

  tmux select-window -t "$window_id" 2>/dev/null || true
  tmux switch-client -t "=$TASKS_SESSION" 2>/dev/null || true
}

if [[ $# -eq 0 ]]; then
  usage 0
fi

if [[ "${1:-}" == "--no-tmux" ]]; then
  IWORK_NO_TMUX=1
  shift
  if [[ $# -eq 0 ]]; then
    usage 1
  fi
fi

case "${1:-}" in
  -h|--help)
    usage 0
    ;;
  --completion)
    case "${2:-}" in
      bash)
        print_bash_completion
        exit 0
        ;;
      zsh)
        print_zsh_completion
        exit 0
        ;;
      *)
        die "expected 'bash' or 'zsh' after --completion"
        ;;
    esac
    ;;
  --complete-repos)
    list_repos "${2:-}"
    exit 0
    ;;
  --complete-worktree-folders)
    list_worktree_folders "${2:-}"
    exit 0
    ;;
  --resolve-worktree-folder)
    resolve_worktree_folder "${2:-}"
    exit 0
    ;;
  --resolve-park-target-path)
    resolve_park_target_path "${2:-}"
    exit 0
    ;;
  --switch-task-window)
    tmux_enabled || exit 1
    validate_worktree_folder_name "${2:-}"
    switch_window_id="$(find_task_window "${2:-}")" || exit 1
    tmux select-window -t "$switch_window_id" 2>/dev/null || exit 1
    tmux switch-client -t "=$TASKS_SESSION" 2>/dev/null || true
    exit 0
    ;;
esac

if [[ "${1:-}" == "list" && $# -eq 1 ]]; then
  list_worktree_folders
  exit 0
fi

if [[ "${1:-}" == "park" ]]; then
  if [[ $# -ne 2 ]]; then
    die "usage: iwork park <folder-name-in-AAWORKTREES>"
  fi

  park_current_repo "$2"
  exit 0
fi

if [[ "${1:-}" == "add-repo" ]]; then
  if [[ $# -lt 4 ]]; then
    die "usage: iwork add-repo <folder-name-in-AAWORKTREES> -r <repo1> [repo2 ...]"
  fi

  folder_name="$2"
  validate_worktree_folder_name "$folder_name"

  parse_repos_flag "expected -r <repos> after folder name" "${@:3}"

  branch="$(detect_branch_from_worktree_folder "$folder_name")"
  branch_slug="${branch//\//-}"

  create_worktrees "$branch" "$folder_name" "$branch_slug" "${repos[@]}"
  exit 0
fi

if [[ "${1:-}" == "cd" && "${2:-}" != "-r" ]]; then
  if [[ $# -ne 2 ]]; then
    die "usage: iwork cd <folder-name-in-AAWORKTREES>"
  fi

  die "'iwork cd' must be run through sourced shell integration. Run: source <(iwork --completion bash) or source <(iwork --completion zsh)"
fi

if [[ "${1:-}" == "claude" && "${2:-}" != "-r" ]]; then
  if [[ $# -lt 2 ]]; then
    die "usage: iwork claude <folder-name-in-AAWORKTREES> [claude-args...]"
  fi

  run_tool_in_worktree claude "$2" "${@:3}"
fi

if [[ "${1:-}" == "codex" && "${2:-}" != "-r" ]]; then
  if [[ $# -lt 2 ]]; then
    die "usage: iwork codex <folder-name-in-AAWORKTREES> [codex-args...]"
  fi

  run_tool_in_worktree codex "$2" "${@:3}"
fi

branch="$1"
shift

validate_branch "$branch"

parse_repos_flag "expected -r <repos> after branch name" "$@"

# Folder name: replace / with -
folder_name="${branch//\//-}"
branch_slug="$folder_name"

create_worktrees "$branch" "$folder_name" "$branch_slug" "${repos[@]}"
