_iwork() {
  local cur prev seen_r i repos folders folder cmd
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev=""
  cmd="${COMP_WORDS[1]:-}"

  if (( COMP_CWORD > 0 )); then
    prev="${COMP_WORDS[COMP_CWORD-1]}"
  fi

  case "$cmd" in
    cd|claude|codex)
      if (( COMP_CWORD == 2 )); then
        folders="$("$_iwork_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
        COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
      fi
      return 0
      ;;
    add-repo|rm)
      if (( COMP_CWORD == 2 )); then
        folders="$("$_iwork_bin" --complete-worktree-folders "$cur" 2>/dev/null)" || return 0
        COMPREPLY=( $(compgen -W "$folders" -- "$cur") )
        return 0
      fi
      ;;
    park)
      return 0
      ;;
    list)
      return 0
      ;;
    init)
      return 0
      ;;
    install-hooks)
      return 0
      ;;
  esac

  seen_r=""
  for ((i = 1; i < COMP_CWORD; i++)); do
    if [[ "${COMP_WORDS[i]}" == "-r" ]]; then
      seen_r=1
      break
    fi
  done

  if [[ "$prev" == "-r" || -n "$seen_r" ]]; then
    # For rm, only the repos that actually have a worktree in the task.
    if [[ "$cmd" == "rm" ]]; then
      folder=""
      for ((i = 2; i < COMP_CWORD; i++)); do
        case "${COMP_WORDS[i]}" in
          -*) ;;
          *) folder="${COMP_WORDS[i]}"; break ;;
        esac
      done
    fi

    if [[ "$cmd" == "rm" && -n "$folder" ]]; then
      repos="$("$_iwork_bin" --complete-task-worktrees "$folder" "$cur" 2>/dev/null)" || return 0
    else
      repos="$("$_iwork_bin" --complete-repos "$cur" 2>/dev/null)" || return 0
    fi
    COMPREPLY=( $(compgen -W "$repos" -- "$cur") )
    return 0
  fi

  if (( COMP_CWORD == 1 )); then
    COMPREPLY=( $(compgen -W "add-repo rm park list cd claude codex init install-hooks --no-tmux --no-context --detach --big -h --help --completion" -- "$cur") )
    return 0
  fi

  if [[ "$cur" == -* ]]; then
    if [[ "$cmd" == "rm" ]]; then
      COMPREPLY=( $(compgen -W "-r -f" -- "$cur") )
    else
      COMPREPLY=( $(compgen -W "-r -h --help --completion --no-tmux --no-context --detach --big" -- "$cur") )
    fi
    return 0
  fi

  if (( COMP_CWORD >= 2 )); then
    COMPREPLY=( $(compgen -W "-r" -- "$cur") )
  fi
}

complete -o nospace -F _iwork iwork
EOF
}

