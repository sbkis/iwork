resolve_base_ref() {
  local repo_path="$1"
  local ref=""
  local candidate=""

  if ref=$(git -C "$repo_path" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "$ref"
    return 0
  fi

  for candidate in main master trunk; do
    if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$candidate" 2>/dev/null; then
      printf 'origin/%s\n' "$candidate"
      return 0
    fi
  done

  for candidate in main master trunk; do
    if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$candidate" 2>/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

is_registered_worktree_path() {
  local repo_path="$1"
  local wt_path="$2"

  git -C "$repo_path" worktree list --porcelain 2>/dev/null | grep -F -x "worktree $wt_path" >/dev/null 2>&1
}

in_tmux() {
  [[ -n "${TMUX:-}" ]]
}

tmux_enabled() {
  [[ -z "$IWORK_NO_TMUX" ]] || return 1

  # Detached and dedicated-session work can both be done without an attached
  # client, so they only need tmux to be installed, not to be running us.
  if [[ -n "$IWORK_DETACH" || -n "$IWORK_BIG" ]]; then
    command -v tmux >/dev/null 2>&1
    return
  fi

  in_tmux
}

# tmux rejects ':' and '.' in session names.
task_session_name() {
  local folder="$1"
  local safe="${folder//:/-}"

  safe="${safe//./-}"
  printf '%s-%s\n' "$TASKS_SESSION" "$safe"
}

# Prints "<window-id> <window-name>" for the window called $name in $session,
# ignoring any leading '*' / '!' status marker.
find_window_in_session() {
  local session="$1"
  local name="$2"
  local window_id=""
  local window_name=""

  while IFS=' ' read -r window_id window_name; do
    if [[ "${window_name#[*!]}" == "$name" ]]; then
      printf '%s %s\n' "$window_id" "$window_name"
      return 0
    fi
  done < <(tmux list-windows -t "=$session" -F '#{window_id} #{window_name}' 2>/dev/null)

  return 1
}

# A task's agent window lives either in its own session (--big) or in the
# shared one; check the dedicated session first.
find_task_window() {
  local folder="$1"
  local line=""

  if line="$(find_window_in_session "$(task_session_name "$folder")" "$folder")" ||
     line="$(find_window_in_session "$TASKS_SESSION" "$folder")"; then
    printf '%s\n' "${line%% *}"
    return 0
  fi

  return 1
}

# Returns non-zero when the window cannot be selected, so callers that have a
# fallback (the 'cd' shell wrapper) can take it.
switch_to_window() {
  local window_id="$1"
  local session=""

  session="$(tmux display-message -p -t "$window_id" '#{session_name}' 2>/dev/null || true)"

  if ! tmux select-window -t "$window_id" 2>/dev/null; then
    warn "could not select tmux window"
    return 1
  fi

  if [[ -n "$session" ]]; then
    tmux switch-client -t "=$session" 2>/dev/null || true
  fi
}

DEFAULT_CONTEXT_TEMPLATE='# Task: {{TASK}}

You are working in an iwork task directory. It contains git worktrees of
the repositories relevant to this task, all on branch `{{BRANCH}}`:

{{REPOS}}

## Scope

- Stay within this task directory. Do not read, edit, or run commands in
  repositories outside the worktrees listed above — they are scoped here
  deliberately.
- Each subdirectory is a real git worktree; commit within it as normal.
- Each repo may have its own CLAUDE.md / AGENTS.md — read it before working
  in that repo and follow its conventions.'

seed_context_template() {
  local template_dir=""

  [[ -f "$CONTEXT_TEMPLATE" ]] && return 0

  template_dir="$(dirname "$CONTEXT_TEMPLATE")"
  if ! mkdir -p "$template_dir" 2>/dev/null; then
    warn "could not create template directory $template_dir"
    return 1
  fi
  if ! printf '%s\n' "$DEFAULT_CONTEXT_TEMPLATE" > "$CONTEXT_TEMPLATE" 2>/dev/null; then
    warn "could not write default template $CONTEXT_TEMPLATE"
    return 1
  fi
  return 0
}

write_task_context() {
  local folder="$1"
  local branch="$2"
  local folder_path="$TASKS_DIR/$folder"
  local template=""
  local repos_list=""
  local rendered=""
  local child=""
  local target=""

  [[ -n "$IWORK_NO_CONTEXT" ]] && return 0
  [[ -d "$folder_path" ]] || return 0

  seed_context_template || return 0

  template="$(cat "$CONTEXT_TEMPLATE" 2>/dev/null || true)"
  [[ -n "$template" ]] || { warn "task context template is empty: $CONTEXT_TEMPLATE"; return 0; }

  for child in "$folder_path"/*; do
    [[ -d "$child" ]] || continue
    if [[ -n "$repos_list" ]]; then
      repos_list="$repos_list
${child##*/}"
    else
      repos_list="${child##*/}"
    fi
  done

  rendered="$template"
  rendered="${rendered//\{\{TASK\}\}/$folder}"
  rendered="${rendered//\{\{BRANCH\}\}/$branch}"
  rendered="${rendered//\{\{REPOS\}\}/$repos_list}"

  for target in "$folder_path/CLAUDE.md" "$folder_path/AGENTS.md"; do
    [[ -e "$target" ]] && continue
    printf '%s\n' "$rendered" > "$target" 2>/dev/null || warn "could not write $target"
  done
}

open_task_window() {
  local folder="$1"
  local tool="$2"
  shift 2
  local folder_path="$TASKS_DIR/$folder"
  local window_id=""
  local pane_id=""
  local tool_cmd=""

  tmux_enabled || return 0
  [[ -d "$folder_path" ]] || return 0

  if window_id="$(find_task_window "$folder")"; then
    if [[ -n "$IWORK_DETACH" ]]; then
      echo "tmux window '$folder' is already open (not switching)"
      return 0
    fi
    switch_to_window "$window_id" || true
    return 0
  fi

  if tmux has-session -t "=$TASKS_SESSION" 2>/dev/null; then
    # -d keeps the new window from becoming the session's active window, which
    # would move the client if it is already viewing the tasks session.
    if ! IFS=' ' read -r window_id pane_id < <(tmux new-window ${IWORK_DETACH:+-d} -t "=$TASKS_SESSION" -n "$folder" -c "$folder_path" -P -F '#{window_id} #{pane_id}' 2>/dev/null); then
      warn "could not create tmux window '$folder'"
      return 0
    fi
  else
    if ! IFS=' ' read -r window_id pane_id < <(tmux new-session -d -s "$TASKS_SESSION" -n "$folder" -c "$folder_path" -P -F '#{window_id} #{pane_id}' 2>/dev/null); then
      warn "could not create tmux session '$TASKS_SESSION'"
      return 0
    fi
  fi

  tmux split-window -h -t "$pane_id" -c "$folder_path" 2>/dev/null || warn "could not split tmux window '$folder'"
  tmux select-pane -t "$pane_id" 2>/dev/null || true

  printf -v tool_cmd '%q ' "$tool" "$@"
  tmux send-keys -t "$pane_id" "$tool_cmd" Enter 2>/dev/null || warn "could not start $tool in tmux window '$folder'"

  if [[ -n "$IWORK_DETACH" ]]; then
    echo "Started $tool in detached tmux window '$folder' (session '$TASKS_SESSION')"
    echo "  attach with: iwork cd $folder"
    return 0
  fi

  switch_to_window "$window_id" || true
}

# One window per repo worktree: editor on the left, shell on the right, both
# rooted in the worktree. Idempotent, so add-repo can extend a live session.
add_repo_windows() {
  local folder="$1"
  local session="$2"
  local folder_path="$TASKS_DIR/$folder"
  local wt=""
  local name=""
  local pane_id=""
  local added=0

  while IFS= read -r wt; do
    [[ -n "$wt" ]] || continue
    name="${wt##*/}"

    find_window_in_session "$session" "$name" >/dev/null && continue

    if ! pane_id="$(tmux new-window -d -t "=$session" -n "$name" -c "$wt" -P -F '#{pane_id}' 2>/dev/null)"; then
      warn "could not create tmux window '$name'"
      continue
    fi

    tmux split-window -h -t "$pane_id" -c "$wt" 2>/dev/null || warn "could not split tmux window '$name'"
    tmux select-pane -t "$pane_id" 2>/dev/null || true
    # IWORK_EDITOR is a command line from the user's own config, so run it as
    # written with the worktree appended.
    tmux send-keys -t "$pane_id" "$IWORK_EDITOR ." Enter 2>/dev/null ||
      warn "could not start $IWORK_EDITOR in tmux window '$name'"
    added=$((added + 1))
  done < <(list_task_worktrees "$folder_path")

  printf '%s\n' "$added"
}

open_task_session() {
  local folder="$1"
  local tool="$2"
  shift 2
  local folder_path="$TASKS_DIR/$folder"
  local session=""
  local window_id=""
  local pane_id=""
  local tool_cmd=""
  local created=""
  local added=0
  local shared_line=""

  tmux_enabled || return 0
  [[ -d "$folder_path" ]] || return 0

  session="$(task_session_name "$folder")"

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    # The task may already be open as a plain window in the shared session;
    # starting a second agent for it in a new session would be a surprise.
    if shared_line="$(find_window_in_session "$TASKS_SESSION" "$folder")"; then
      warn "task '$folder' is already open in session '$TASKS_SESSION'; not starting a second agent there"
      warn "close that window first if you want '$folder' to have its own session"
      if [[ -z "$IWORK_DETACH" ]] && in_tmux; then
        switch_to_window "${shared_line%% *}" || true
      fi
      return 0
    fi

    # The agent window keeps the task name so the Claude status hooks still
    # recognise it (*task busy, !task waiting).
    if ! IFS=' ' read -r window_id pane_id < <(tmux new-session -d -s "$session" -n "$folder" -c "$folder_path" -P -F '#{window_id} #{pane_id}' 2>/dev/null); then
      warn "could not create tmux session '$session'"
      return 0
    fi
    created=1

    tmux split-window -h -t "$pane_id" -c "$folder_path" 2>/dev/null || warn "could not split tmux window '$folder'"
    tmux select-pane -t "$pane_id" 2>/dev/null || true

    printf -v tool_cmd '%q ' "$tool" "$@"
    tmux send-keys -t "$pane_id" "$tool_cmd" Enter 2>/dev/null || warn "could not start $tool in tmux window '$folder'"
  fi

  added="$(add_repo_windows "$folder" "$session")"

  if [[ -z "$created" ]]; then
    echo "tmux session '$session' already exists (added $added repo window(s))"
  else
    echo "tmux session '$session': '$folder' running $tool, plus $added repo window(s)"
  fi

  if [[ -n "$IWORK_DETACH" ]]; then
    echo "  attach with: tmux switch-client -t $session   (or: tmux attach -t $session)"
    return 0
  fi

  if ! in_tmux; then
    echo "  attach with: tmux attach -t $session"
    return 0
  fi

  if ! window_id="$(find_task_window "$folder")"; then
    return 0
  fi
  switch_to_window "$window_id" || true
}

open_task() {
  if [[ -n "$IWORK_BIG" ]]; then
    open_task_session "$@"
  else
    open_task_window "$@"
  fi
}

# add-repo into a task that already owns a session should get a window too.
extend_task_session() {
  local folder="$1"
  local session=""
  local added=0

  tmux_enabled || return 0
  session="$(task_session_name "$folder")"
  tmux has-session -t "=$session" 2>/dev/null || return 0

  added="$(add_repo_windows "$folder" "$session")"
  (( added > 0 )) && echo "Added $added window(s) to tmux session '$session'"
  return 0
}

handle_claude_hook() {
  local input=""
  local event=""
  local window_name=""
  local base=""
  local marker=""

  [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || exit 0
  [[ -n "$TASKS_DIR" ]] || exit 0

  input="$(cat 2>/dev/null || true)"
  event="$(printf '%s' "$input" | sed -n 's/.*"hook_event_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' || true)"
  [[ -n "$event" ]] || exit 0

  window_name="$(tmux display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null)" || exit 0
  base="${window_name#[*!]}"
  [[ -n "$base" && -d "$TASKS_DIR/$base" ]] || exit 0

  case "$event" in
    UserPromptSubmit)
      marker='*'
      ;;
    Stop|Notification)
      marker='!'
      ;;
    *)
      exit 0
      ;;
  esac

  if [[ "$window_name" != "${marker}${base}" ]]; then
    tmux rename-window -t "$TMUX_PANE" "${marker}${base}" 2>/dev/null || true
  fi

  exit 0
}

run_init() {
  local repo_dir="" tasks_dir="" answer="" config_dir=""

  if ! { : </dev/tty; } 2>/dev/null; then
    die "iwork init needs an interactive terminal"
  fi

  if [[ -f "$IWORK_CONFIG_FILE" ]]; then
    printf 'Config already exists: %s\nOverwrite? [y/N] ' "$IWORK_CONFIG_FILE"
    IFS= read -r answer </dev/tty
    case "$answer" in
      y|Y) ;;
      *) die "aborted" ;;
    esac
  fi

  printf 'Directory that holds your repos (e.g. ~/dev/projects): '
  IFS= read -r repo_dir </dev/tty
  repo_dir="${repo_dir/#\~/$HOME}"
  [[ -n "$repo_dir" ]] || die "a repo directory is required"
  [[ -d "$repo_dir" ]] || die "not a directory: $repo_dir"
  repo_dir="$(cd "$repo_dir" && pwd)"

  printf 'Directory for task folders [%s/tasks]: ' "$repo_dir"
  IFS= read -r tasks_dir </dev/tty
  if [[ -n "$tasks_dir" ]]; then
    tasks_dir="${tasks_dir/#\~/$HOME}"
  fi

  config_dir="$(dirname "$IWORK_CONFIG_FILE")"
  mkdir -p "$config_dir" || die "could not create $config_dir"

  {
    echo '# iwork configuration. Plain shell, sourced by iwork.'
    echo '# Environment variables override values set here.'
    printf 'IWORK_REPO_DIR=%q\n' "$repo_dir"
    if [[ -n "$tasks_dir" ]]; then
      printf 'IWORK_TASKS_DIR=%q\n' "$tasks_dir"
    else
      echo '# IWORK_TASKS_DIR="$IWORK_REPO_DIR/tasks"'
    fi
    echo '# IWORK_TMUX_SESSION=tasks'
    echo '# IWORK_CONTEXT_TEMPLATE="$HOME/.config/iwork/task-context.md.tmpl"'
  } > "$IWORK_CONFIG_FILE" || die "could not write $IWORK_CONFIG_FILE"

  echo "Wrote $IWORK_CONFIG_FILE"
  echo "  repo dir:  $repo_dir"
  echo "  tasks dir: ${tasks_dir:-$repo_dir/tasks}"
}

install_claude_hooks() {
  local settings_path="$1"
  local hook_cmd="$SELF_PATH --hook"

  command -v python3 >/dev/null 2>&1 || die "install-hooks requires python3"

  python3 - "$settings_path" "$hook_cmd" <<'PY'
import json
import os
import sys

settings_path = sys.argv[1]
cmd = sys.argv[2]
events = ["UserPromptSubmit", "Stop", "Notification"]

data = {}
if os.path.exists(settings_path):
    with open(settings_path) as f:
        data = json.load(f)

hooks = data.setdefault("hooks", {})
to_add = []
for ev in events:
    entries = hooks.setdefault(ev, [])
    present = any(
        h.get("command") == cmd
        for entry in entries
        for h in entry.get("hooks", [])
    )
    if not present:
        to_add.append(ev)

if not to_add:
    print(f"iwork hook already installed for all events in {settings_path}")
    sys.exit(0)

print(f"Will add to {settings_path}:")
for ev in to_add:
    print(f'  {ev}: {{"type": "command", "command": "{cmd}"}}')

if os.environ.get("IWORK_ASSUME_YES") != "1":
    try:
        with open("/dev/tty") as tty:
            print("Proceed? [y/N] ", end="", flush=True)
            answer = tty.readline().strip().lower()
    except OSError:
        sys.exit("no TTY available for confirmation; aborting")
    if answer != "y":
        sys.exit("aborted")

for ev in to_add:
    hooks[ev].append({"hooks": [{"type": "command", "command": cmd}]})

settings_dir = os.path.dirname(settings_path)
if settings_dir:
    os.makedirs(settings_dir, exist_ok=True)
tmp_path = settings_path + ".tmp"
with open(tmp_path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
if os.path.exists(settings_path):
    os.chmod(tmp_path, os.stat(settings_path).st_mode & 0o777)
else:
    os.chmod(tmp_path, 0o600)
os.replace(tmp_path, settings_path)
print(f"Updated {settings_path}")
PY
}

if [[ $# -eq 0 ]]; then
  usage 0
fi

while [[ "${1:-}" == "--no-tmux" || "${1:-}" == "--no-context" || "${1:-}" == "--detach" || "${1:-}" == "--big" ]]; do
  case "$1" in
    --no-tmux) IWORK_NO_TMUX=1 ;;
    --no-context) IWORK_NO_CONTEXT=1 ;;
    --detach) IWORK_DETACH=1 ;;
    --big) IWORK_BIG=1 ;;
  esac
  shift
  if [[ $# -eq 0 ]]; then
    usage 1
  fi
done

case "${1:-}" in
  -h|--help)
    usage 0
    ;;
  --completion)
    case "${2:-}" in
      bash)
        print_bash_completion
        exit 0
        ;;
      zsh)
        print_zsh_completion
        exit 0
        ;;
      *)
        die "expected 'bash' or 'zsh' after --completion"
        ;;
    esac
    ;;
  --complete-repos)
    require_config
    list_repos "${2:-}"
    exit 0
    ;;
  --complete-worktree-folders)
    require_config
    list_worktree_folders "${2:-}"
    exit 0
    ;;
  --complete-task-worktrees)
    require_config
    list_task_worktree_names "${2:-}" "${3:-}"
    exit 0
    ;;
  --resolve-worktree-folder)
    require_config
    resolve_worktree_folder "${2:-}"
    exit 0
    ;;
  --resolve-park-target-path)
    require_config
    resolve_park_target_path "${2:-}"
    exit 0
    ;;
  --switch-task-window)
    tmux_enabled || exit 1
    validate_worktree_folder_name "${2:-}"
    switch_window_id="$(find_task_window "${2:-}")" || exit 1
    switch_to_window "$switch_window_id" || exit 1
    exit 0
    ;;
  --hook)
    handle_claude_hook
    ;;
esac

if [[ "${1:-}" == "init" ]]; then
  if [[ $# -ne 1 ]]; then
    die "usage: iwork init"
  fi

  run_init
  exit 0
fi

if [[ "${1:-}" == "list" && $# -eq 1 ]]; then
  require_config
  if tmux_enabled; then
    list_worktree_folders_with_status
  else
    list_worktree_folders
  fi
  exit 0
fi

if [[ "${1:-}" == "park" ]]; then
  if [[ $# -ne 2 ]]; then
    die "usage: iwork park <task>"
  fi

  require_config
  park_current_repo "$2"
  exit 0
fi

if [[ "${1:-}" == "install-hooks" ]]; then
  if [[ $# -gt 2 ]]; then
    die "usage: iwork install-hooks [settings-path]"
  fi

  install_claude_hooks "${2:-$HOME/.claude/settings.json}"
  exit 0
fi

if [[ "${1:-}" == "rm" ]]; then
  shift
  rm_force=""
  rm_positional=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force)
        rm_force=1
        shift
        ;;
      -r)
        break
        ;;
      *)
        rm_positional+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#rm_positional[@]} -ne 1 ]]; then
    die "usage: iwork rm [-f] <task> [-r <repo1> [repo2 ...]]"
  fi

  require_config
  folder_name="${rm_positional[0]}"
  validate_worktree_folder_name "$folder_name"

  repos=()
  if [[ $# -gt 0 ]]; then
    parse_repos_flag "expected -r <repos> after task name" "$@"
  fi

  remove_worktrees "$folder_name" "$rm_force" "${repos[@]+${repos[@]}}"
  exit 0
fi

if [[ "${1:-}" == "add-repo" ]]; then
  if [[ $# -lt 4 ]]; then
    die "usage: iwork add-repo <task> -r <repo1> [repo2 ...]"
  fi

  require_config
  folder_name="$2"
  validate_worktree_folder_name "$folder_name"

  parse_repos_flag "expected -r <repos> after folder name" "${@:3}"

  branch="$(detect_branch_from_worktree_folder "$folder_name")"

  create_worktrees "$branch" "$folder_name" "${repos[@]}"
  extend_task_session "$folder_name"
  exit 0
fi

if [[ "${1:-}" == "cd" && "${2:-}" != "-r" ]]; then
  if [[ $# -ne 2 ]]; then
    die "usage: iwork cd <task>"
  fi

  die "'iwork cd' must be run through sourced shell integration. Run: source <(iwork --completion bash) or source <(iwork --completion zsh)"
fi

if [[ "${1:-}" == "claude" && "${2:-}" != "-r" ]]; then
  if [[ $# -lt 2 ]]; then
    die "usage: iwork claude <task> [claude-args...]"
  fi

  run_tool_in_worktree claude "$2" "${@:3}"
fi

if [[ "${1:-}" == "codex" && "${2:-}" != "-r" ]]; then
  if [[ $# -lt 2 ]]; then
    die "usage: iwork codex <task> [codex-args...]"
  fi

  run_tool_in_worktree codex "$2" "${@:3}"
fi

branch="$1"
shift

require_config
validate_branch "$branch"

parse_repos_flag "expected -r <repos> after branch name" "$@"

# Folder name: replace / with -
folder_name="${branch//\//-}"

create_worktrees "$branch" "$folder_name" "${repos[@]}"
write_task_context "$folder_name" "$branch"
open_task "$folder_name" claude
