resolve_base_ref() {
  local repo_path="$1"
  local ref=""
  local candidate=""

  if ref=$(git -C "$repo_path" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "$ref"
    return 0
  fi

  for candidate in main master trunk; do
    if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$candidate" 2>/dev/null; then
      printf 'origin/%s\n' "$candidate"
      return 0
    fi
  done

  for candidate in main master trunk; do
    if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$candidate" 2>/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

validate_base_spec() {
  local spec="$1"

  case "$spec" in
    -*)
      die "--from needs a task or branch name, got the flag '$spec'"
      ;;
    ""|.|..|*\\*)
      die "invalid --from value '$spec'"
      ;;
    */*)
      # Only a branch can contain '/', so it is never a task folder lookup.
      validate_branch "$spec"
      ;;
    *)
      validate_worktree_folder_name "$spec"
      ;;
  esac
}

# The worktree for $repo inside task folder $folder, current layout or the
# older repo--branch-slug one.
task_repo_worktree() {
  local folder="$1"
  local repo="$2"
  local child=""

  for child in "$TASKS_DIR/$folder/$repo" "$TASKS_DIR/$folder/$repo"--*; do
    [[ -d "$child" ]] || continue
    is_worktree_root "$child" || continue
    printf '%s\n' "$child"
    return 0
  done

  return 1
}

# A base does not need a worktree: a plain local branch, a remote branch, a tag
# or a commit all work, since the new branch only needs a starting point.
resolve_base_committish() {
  local repo_path="$1"

  if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$BASE_SPEC" 2>/dev/null; then
    printf '%s\n' "$BASE_SPEC"
    return 0
  fi

  if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$BASE_SPEC" 2>/dev/null; then
    printf 'origin/%s\n' "$BASE_SPEC"
    return 0
  fi

  # Anything else git can resolve: origin/x spelled out, a tag, a SHA.
  if git -C "$repo_path" rev-parse --verify --quiet "$BASE_SPEC^{commit}" >/dev/null 2>&1; then
    printf '%s\n' "$BASE_SPEC"
    return 0
  fi

  return 1
}

# True when --from names something we can actually build on: a task folder, or
# something resolvable in at least one of the repos being set up.
base_spec_is_resolvable() {
  local repo=""

  case "$BASE_SPEC" in
    */*) ;;
    *) [[ -d "$TASKS_DIR/$BASE_SPEC" ]] && return 0 ;;
  esac

  for repo in "$@"; do
    if resolve_base_committish "$REPO_DIR/$repo" >/dev/null; then
      return 0
    fi
  done

  return 1
}

# Where a new branch for $repo should start: the branch of the task named by
# --from when that task covers this repo, else a branch of that name in the
# repo, else the repo's own base branch.
resolve_task_base_ref() {
  local repo="$1"
  local repo_path="$2"
  local base_wt=""
  local branch=""

  if [[ -z "$BASE_SPEC" ]]; then
    resolve_base_ref "$repo_path"
    return
  fi

  case "$BASE_SPEC" in
    */*) ;;
    *)
      if base_wt="$(task_repo_worktree "$BASE_SPEC" "$repo")"; then
        branch="$(git -C "$base_wt" branch --show-current 2>/dev/null || true)"
        if [[ -n "$branch" ]]; then
          if [[ -n "$(git -C "$base_wt" status --porcelain --untracked-files=no 2>/dev/null || true)" ]]; then
            warn "$repo: base task '$BASE_SPEC' has uncommitted changes; branching from its last commit"
          fi
          printf '%s\n' "$branch"
          return 0
        fi
      fi
      ;;
  esac

  if resolve_base_committish "$repo_path"; then
    return 0
  fi

  warn "$repo: nothing named '$BASE_SPEC' here; using the repo's base branch instead"
  resolve_base_ref "$repo_path"
}

is_registered_worktree_path() {
  local repo_path="$1"
  local wt_path="$2"

  git -C "$repo_path" worktree list --porcelain 2>/dev/null | grep -F -x "worktree $wt_path" >/dev/null 2>&1
}

in_tmux() {
  [[ -n "${TMUX:-}" ]]
}

tmux_enabled() {
  [[ -z "$IWORK_NO_TMUX" ]] || return 1

  # Detached and dedicated-session work can both be done without an attached
  # client, so they only need tmux to be installed, not to be running us.
  if [[ -n "$IWORK_DETACH" || -n "$IWORK_BIG" ]]; then
    command -v tmux >/dev/null 2>&1
    return
  fi

  in_tmux
}

# tmux rejects ':' and '.' in session names.
task_session_name() {
  local folder="$1"
  local safe="${folder//:/-}"

  safe="${safe//./-}"
  printf '%s-%s\n' "$TASKS_SESSION" "$safe"
}

# Prints "<window-id> <window-name>" for the window called $name in $session,
# ignoring any leading '*' / '!' status marker.
find_window_in_session() {
  local session="$1"
  local name="$2"
  local window_id=""
  local window_name=""

  while IFS=' ' read -r window_id window_name; do
    if [[ "${window_name#[*!]}" == "$name" ]]; then
      printf '%s %s\n' "$window_id" "$window_name"
      return 0
    fi
  done < <(tmux list-windows -t "=$session" -F '#{window_id} #{window_name}' 2>/dev/null)

  return 1
}

# A task's agent window lives either in its own session (--big) or in the
# shared one; check the dedicated session first.
find_task_window() {
  local folder="$1"
  local line=""

  if line="$(find_window_in_session "$(task_session_name "$folder")" "$folder")" ||
     line="$(find_window_in_session "$TASKS_SESSION" "$folder")"; then
    printf '%s\n' "${line%% *}"
    return 0
  fi

  return 1
}

# Returns non-zero when the window cannot be selected, so callers that have a
# fallback (the 'cd' shell wrapper) can take it.
switch_to_window() {
  local window_id="$1"
  local session=""

  session="$(tmux display-message -p -t "$window_id" '#{session_name}' 2>/dev/null || true)"

  if ! tmux select-window -t "$window_id" 2>/dev/null; then
    warn "could not select tmux window"
    return 1
  fi

  if [[ -n "$session" ]]; then
    tmux switch-client -t "=$session" 2>/dev/null || true
  fi
}

DEFAULT_CONTEXT_TEMPLATE='# Task: {{TASK}}

You are working in an iwork task directory. It contains git worktrees of
the repositories relevant to this task, all on branch `{{BRANCH}}`,
branched from {{BASE}}:

<!-- iwork:repos -->
{{REPOS}}
<!-- /iwork:repos -->

## Scope

- Stay within this task directory. Do not read, edit, or run commands in
  repositories outside the worktrees listed above — they are scoped here
  deliberately.
- Each subdirectory is a real git worktree; commit within it as normal.
- Each repo may have its own CLAUDE.md / AGENTS.md — read it before working
  in that repo and follow its conventions.'

seed_context_template() {
  local template_dir=""

  [[ -f "$CONTEXT_TEMPLATE" ]] && return 0

  template_dir="$(dirname "$CONTEXT_TEMPLATE")"
  if ! mkdir -p "$template_dir" 2>/dev/null; then
    warn "could not create template directory $template_dir"
    return 1
  fi
  if ! printf '%s\n' "$DEFAULT_CONTEXT_TEMPLATE" > "$CONTEXT_TEMPLATE" 2>/dev/null; then
    warn "could not write default template $CONTEXT_TEMPLATE"
    return 1
  fi
  return 0
}

write_task_context() {
  local folder="$1"
  local branch="$2"
  local folder_path="$TASKS_DIR/$folder"
  local template=""
  local repos_list=""
  local rendered=""
  local child=""
  local target=""
  local base_text=""

  [[ -n "$IWORK_NO_CONTEXT" ]] && return 0
  [[ -d "$folder_path" ]] || return 0

  seed_context_template || return 0

  template="$(cat "$CONTEXT_TEMPLATE" 2>/dev/null || true)"
  [[ -n "$template" ]] || { warn "task context template is empty: $CONTEXT_TEMPLATE"; return 0; }

  for child in "$folder_path"/*; do
    [[ -d "$child" ]] || continue
    if [[ -n "$repos_list" ]]; then
      repos_list="$repos_list
${child##*/}"
    else
      repos_list="${child##*/}"
    fi
  done

  if [[ -n "$BASE_SPEC" ]]; then
    base_text="\`$BASE_SPEC\` — this task is stacked on that work, so its
commits are already in the history here"
  else
    base_text="each repository's base branch"
  fi

  rendered="$template"
  rendered="${rendered//\{\{TASK\}\}/$folder}"
  rendered="${rendered//\{\{BRANCH\}\}/$branch}"
  rendered="${rendered//\{\{BASE\}\}/$base_text}"
  rendered="${rendered//\{\{REPOS\}\}/$repos_list}"

  # A stacked task is worth saying out loud even when the template predates
  # {{BASE}} — an agent that does not know the earlier work is already in the
  # history here is liable to build it a second time.
  if [[ -n "$BASE_SPEC" && "$template" != *'{{BASE}}'* ]]; then
    rendered="$rendered

## Base

These branches were created from \`$BASE_SPEC\`, so that work is already in the
history here. Build on it rather than reimplementing it, and keep this task's
commits on top."
  fi

  for target in "$folder_path/CLAUDE.md" "$folder_path/AGENTS.md"; do
    [[ -e "$target" ]] && continue
    printf '%s\n' "$rendered" > "$target" 2>/dev/null || warn "could not write $target"
  done
}

DEFAULT_PROJECT_TEMPLATE='## Project: {{PROJECT}}

{{GOAL}}

This task is one step in a longer effort spanning several tasks, repos and PRs.
{{SEED}}
**Run `iwork project show` first.** Before reading code, before answering, even
when the request looks self-contained. It prints the goal, the open todos, what
the sibling tasks are doing, and the decisions earlier tasks already made — so
you do not re-litigate a settled question or redo finished work. The git log
cannot tell you this: the reasoning was never committed.

`.project/` is a symlink to that shared memory, so it is reachable from here.
Read it through these commands anyway — `project show` is assembled and bounded,
while LOG.md grows without limit and most of it is not about your task:

- `iwork project show [-n N]` — goal, open todos, recent log, sibling tasks
- `iwork project grep <pattern>` — search the whole project memory
- `iwork project cat <path>` — read one file grep turned up, e.g. notes/api.md

**Never write to those files by hand — always use the commands below.** Agents
in sibling tasks are appending to the same files while you work. The commands
add one line atomically; an editing tool does read-modify-write and silently
drops whatever landed in between. LOG.md is append-only, and TODO.md ids are
referenced from other tasks, so rewriting either loses work that is not yours.

### Record as you go

Single-line appends, cheap to run. Do them mid-task rather than at the end: by
the end the reasoning is gone, and the reasoning is the part worth keeping.

- Picked one approach over another? `iwork decided "chose X over Y because Z"`
- Worked out *why* existing code is the way it is? `iwork decided "..."`
- Changed how something works? `iwork decided "..."` before the turn ends
- Hit something broken or missing that does not belong in this PR?
  `iwork todo "..."` — capture it and move on, do not fix it here
- Opened a PR? The URL is recorded for you. Use `iwork log --shipped "..."` only
  to add what the URL alone does not say.

`iwork` is a CLI on your PATH. `iwork project -h` lists every command above and
stays current if the tool grows new ones, so prefer it over this list going
stale. Task and tmux management — creating tasks, `add-repo`, `rm`, `park`,
`install-hooks` — belongs to the operator, not to you: those change or destroy
worktrees, so do not run them unless you were asked to directly.

PROJECT.md is curated by hand and is not yours to rewrite. If it has gone stale,
say so instead of fixing it.'

require_projects_dir() {
  if [[ -z "$PROJECTS_DIR" ]]; then
    die "IWORK_PROJECTS_DIR is not set and could not be derived. Add it to $IWORK_CONFIG_FILE:
  IWORK_PROJECTS_DIR=\"\$IWORK_REPO_DIR/projects\""
  fi
}

validate_project_name() {
  local project="$1"

  case "$project" in
    -*)
      # The name regex below allows '-', so without this '-p --from x' would
      # quietly create a project called '--from'.
      die "a project name is expected, got the flag '$project'"
      ;;
    ""|.|..|*/*|*\\*|*:* )
      die "project '$project' must be a single directory name under ${PROJECTS_DIR:-the projects directory}"
      ;;
    \**|!* )
      die "project '$project' must not start with '*' or '!'"
      ;;
  esac

  if [[ ! "$project" =~ ^[A-Za-z0-9._-]+$ ]]; then
    die "project '$project' contains unsupported characters"
  fi
}

project_path() {
  printf '%s\n' "$PROJECTS_DIR/$1"
}

# The on-disk spelling of a project name. On a case-insensitive filesystem
# (macOS APFS by default) 'Foo' and 'foo' are one directory, so without this a
# task could link to 'Foo', report its project as 'Foo', and then not appear in
# 'project show foo' — two names quietly sharing one set of files.
canonical_project_name() {
  local project="$1"
  local lower=""
  local existing=""
  local existing_lower=""

  lower="$(printf '%s' "$project" | tr '[:upper:]' '[:lower:]')"

  while IFS= read -r existing; do
    [[ -n "$existing" ]] || continue
    [[ "$existing" == "$project" ]] && { printf '%s\n' "$project"; return 0; }
    existing_lower="$(printf '%s' "$existing" | tr '[:upper:]' '[:lower:]')"
    if [[ "$existing_lower" == "$lower" ]]; then
      printf '%s\n' "$existing"
      return 0
    fi
  done < <(list_projects)

  printf '%s\n' "$project"
}

project_exists() {
  [[ -n "$PROJECTS_DIR" && -d "$PROJECTS_DIR/$1" ]]
}

list_projects() {
  local prefix="${1:-}"
  local path=""
  local name=""

  [[ -n "$PROJECTS_DIR" && -d "$PROJECTS_DIR" ]] || return 0

  for path in "$PROJECTS_DIR"/*; do
    [[ -d "$path" ]] || continue
    name="${path##*/}"

    if [[ "$name" == "$prefix"* ]]; then
      printf '%s\n' "$name"
    fi
  done | sort
}

# A project and a task must not share a name: they would compete for the same
# tmux window name, and the status hook would not know which directory it means.
assert_project_name_free() {
  local project="$1"

  if [[ -n "$TASKS_DIR" && -d "$TASKS_DIR/$project" ]]; then
    die "'$project' is already a task folder; a project cannot share a name with a task (rename one of them)"
  fi
}

seed_project_template() {
  local template_dir=""

  [[ -f "$PROJECT_TEMPLATE" ]] && return 0

  template_dir="$(dirname "$PROJECT_TEMPLATE")"
  if ! mkdir -p "$template_dir" 2>/dev/null; then
    warn "could not create template directory $template_dir"
    return 1
  fi
  if ! printf '%s\n' "$DEFAULT_PROJECT_TEMPLATE" > "$PROJECT_TEMPLATE" 2>/dev/null; then
    warn "could not write default template $PROJECT_TEMPLATE"
    return 1
  fi
  return 0
}

create_project() {
  local project="$1"
  local dir=""

  validate_project_name "$project"
  require_projects_dir
  assert_project_name_free "$project"

  dir="$PROJECTS_DIR/$project"
  mkdir -p "$dir/notes" || die "could not create $dir"

  if [[ ! -f "$dir/PROJECT.md" ]]; then
    cat > "$dir/PROJECT.md" <<EOF || die "could not write $dir/PROJECT.md"
# $project

One line on what this project is for — replace this.

## Where we are

_Nothing recorded yet._

## Constraints and decisions that stick

-
EOF
  fi

  if [[ ! -f "$dir/LOG.md" ]]; then
    cat > "$dir/LOG.md" <<EOF || die "could not write $dir/LOG.md"
# Log — $project

Append-only, one line per entry, written by \`iwork log\` / \`iwork decided\` and
by task lifecycle events. Do not rewrite past entries; add a new one.
EOF
  fi

  if [[ ! -f "$dir/TODO.md" ]]; then
    cat > "$dir/TODO.md" <<EOF || die "could not write $dir/TODO.md"
# Todo — $project

Captured with \`iwork todo\` from inside a task, so each line records where it
surfaced. Close with \`iwork done <id>\`, abandon with \`iwork drop <id>\`.
EOF
  fi

  if [[ ! -f "$dir/history.tsv" ]]; then
    printf '# timestamp\tevent\ttask\trepos\tref\tnote\n' > "$dir/history.tsv" ||
      die "could not write $dir/history.tsv"
  fi

  if [[ ! -f "$dir/notes/.keep" ]]; then
    : > "$dir/notes/.keep" 2>/dev/null || true
  fi
}

ensure_project() {
  local project="$1"

  validate_project_name "$project"
  require_projects_dir
  project="$(canonical_project_name "$project")"

  project_exists "$project" && return 0

  assert_project_name_free "$project"
  confirm_new_project "$project" || die "aborted"
  create_project "$project"
  echo "Created project '$project' at $PROJECTS_DIR/$project"
}

confirm_new_project() {
  local project="$1"
  local existing=""
  local name=""

  existing="$(list_projects)"

  echo "Project '$project' does not exist yet."
  if [[ -n "$existing" ]]; then
    echo "Existing projects:"
    while IFS= read -r name; do
      [[ -n "$name" ]] && echo "  $name"
    done <<< "$existing"
  fi

  confirm "Create project '$project'?"
}

project_goal() {
  local file=""
  local line=""

  file="$PROJECTS_DIR/$1/PROJECT.md"
  [[ -f "$file" ]] || return 0

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    case "$line" in \#*) continue ;; esac
    printf '%s\n' "$line"
    return 0
  done < "$file"
}

# The task folder we are standing in, if any: a direct child of TASKS_DIR on the
# way up from $PWD. -ef rather than string comparison, so a symlinked TMPDIR or
# tasks dir still matches.
task_root_from_cwd() {
  local dir="$PWD"
  local parent=""

  [[ -n "$TASKS_DIR" && -d "$TASKS_DIR" ]] || return 1

  while [[ -n "$dir" && "$dir" != "/" ]]; do
    parent="${dir%/*}"
    [[ -n "$parent" ]] || parent="/"

    if [[ -d "$parent" && "$parent" -ef "$TASKS_DIR" ]]; then
      printf '%s\n' "${dir##*/}"
      return 0
    fi

    dir="$parent"
  done

  return 1
}

# The task a command should act on: the one named, or the one we are standing
# in. Same inference 'iwork todo' already uses, so a task name only has to be
# spelled out when it is not the current one.
resolve_task_arg() {
  local given="${1:-}"
  local inferred=""

  if [[ -n "$given" ]]; then
    validate_worktree_folder_name "$given"
    printf '%s\n' "$given"
    return 0
  fi

  inferred="$(task_root_from_cwd || true)"
  if [[ -z "$inferred" ]]; then
    die "not inside an iwork task, so there is no current task to use; name one explicitly"
  fi

  printf '%s\n' "$inferred"
}

task_project_name() {
  local task="$1"
  local link="$TASKS_DIR/$task/.project"
  local target=""

  [[ -L "$link" ]] || return 1
  target="$(readlink "$link" 2>/dev/null)" || return 1
  target="${target%/}"
  [[ -n "$target" ]] || return 1

  printf '%s\n' "${target##*/}"
}

task_repos_csv() {
  local task="$1"
  local wt=""
  local csv=""

  while IFS= read -r wt; do
    [[ -n "$wt" ]] || continue
    csv="${csv:+$csv,}${wt##*/}"
  done < <(list_task_worktrees "$TASKS_DIR/$task")

  printf '%s\n' "$csv"
}

RESOLVED_PROJECT=""
RESOLVED_TASK=""

# Project resolution order: explicit flag, then IWORK_PROJECT, then the .project
# link of the task we are standing in. The last one is what lets an agent run
# 'iwork todo "..."' with no arguments at all.
resolve_project_context() {
  local explicit="${1:-}"

  require_config
  require_projects_dir

  RESOLVED_PROJECT=""
  RESOLVED_TASK="$(task_root_from_cwd || true)"

  # Order: explicit flag, then the task's own .project link, then IWORK_PROJECT.
  # The link must beat the env var — otherwise exporting IWORK_PROJECT once in a
  # shell profile silently misfiles every capture made from every other
  # project's tasks, which is exactly the mistake you cannot see happening.
  if [[ -n "$explicit" ]]; then
    validate_project_name "$explicit"
    RESOLVED_PROJECT="$(canonical_project_name "$explicit")"
  else
    if [[ -n "$RESOLVED_TASK" ]]; then
      RESOLVED_PROJECT="$(task_project_name "$RESOLVED_TASK" || true)"
    fi

    if [[ -z "$RESOLVED_PROJECT" && -n "${IWORK_PROJECT:-}" ]]; then
      validate_project_name "$IWORK_PROJECT"
      RESOLVED_PROJECT="$IWORK_PROJECT"
    fi

    if [[ -z "$RESOLVED_PROJECT" ]]; then
      if [[ -n "$RESOLVED_TASK" ]]; then
        die "task '$RESOLVED_TASK' is not attached to a project.
  Attach it:  iwork project add <project> $RESOLVED_TASK
  Or target one explicitly with -p <project>"
      fi
      die "not inside an iwork task; pass -p <project> or set IWORK_PROJECT"
    fi
  fi

  project_exists "$RESOLVED_PROJECT" ||
    die "no such project: $RESOLVED_PROJECT (see 'iwork project list')"
}

link_task_project() {
  local task="$1"
  local project="$2"
  local link="$TASKS_DIR/$task/.project"
  local existing=""

  if [[ -L "$link" ]]; then
    existing="$(task_project_name "$task" || true)"
    [[ "$existing" == "$project" ]] && return 0
    die "task '$task' is already attached to project '${existing:-unknown}'; a task belongs to one project.
  Detach it first:  iwork project rm ${existing:-<project>} $task"
  fi

  [[ -e "$link" ]] && die "$link already exists and is not a symlink"

  ln -s "$PROJECTS_DIR/$project" "$link" || die "could not create $link"
}

# Replaces the <!-- iwork:MARKER --> ... <!-- /iwork:MARKER --> block in $file
# with $content, appending it if absent and removing it when $content is empty.
# Everything outside the markers is preserved byte for byte, which is what lets
# one code path serve creation, retrofit, refresh and detach.
replace_marked_block() {
  local file="$1"
  local marker="$2"
  local content="$3"
  local open="<!-- iwork:$marker -->"
  local close="<!-- /iwork:$marker -->"
  local tmp="$file.iwork.$$"
  local line=""
  local inside=""
  local replaced=""

  [[ -f "$file" ]] || return 1
  : > "$tmp" 2>/dev/null || return 1

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$inside" && "$line" == "$open" ]]; then
      inside=1
      replaced=1
      continue
    fi
    if [[ -n "$inside" ]]; then
      if [[ "$line" == "$close" ]]; then
        inside=""
        [[ -n "$content" ]] && printf '%s\n%s\n%s\n' "$open" "$content" "$close" >> "$tmp"
      fi
      continue
    fi
    printf '%s\n' "$line" >> "$tmp"
  done < "$file"

  # An unterminated open marker means the rest of the file was inside the block.
  if [[ -n "$inside" && -n "$content" ]]; then
    printf '%s\n%s\n%s\n' "$open" "$content" "$close" >> "$tmp"
  fi

  if [[ -z "$replaced" && -n "$content" ]]; then
    printf '\n%s\n%s\n%s\n' "$open" "$content" "$close" >> "$tmp"
  fi

  mv "$tmp" "$file" 2>/dev/null || { rm -f "$tmp"; return 1; }
}

strip_marked_block() {
  replace_marked_block "$1" "$2" ""
}

render_project_block() {
  local project="$1"
  local task="$2"
  local branch="$3"
  local seed="${4:-}"
  local template=""
  local goal=""
  local rendered=""

  template="$(cat "$PROJECT_TEMPLATE" 2>/dev/null || true)"
  [[ -n "$template" ]] || return 1

  goal="$(project_goal "$project")"
  [[ -n "$seed" ]] && seed="
$seed
"

  rendered="$template"
  rendered="${rendered//\{\{PROJECT\}\}/$project}"
  rendered="${rendered//\{\{GOAL\}\}/$goal}"
  rendered="${rendered//\{\{TASK\}\}/$task}"
  rendered="${rendered//\{\{BRANCH\}\}/$branch}"
  rendered="${rendered//\{\{SEED\}\}/$seed}"

  printf '%s\n' "$rendered"
}

write_project_block() {
  local task="$1"
  local project="$2"
  local branch="$3"
  local seed="${4:-}"
  local content=""
  local target=""
  local wrote=""

  seed_project_template || return 0

  if ! content="$(render_project_block "$project" "$task" "$branch" "$seed")"; then
    warn "project context template is empty: $PROJECT_TEMPLATE"
    return 0
  fi

  for target in "$TASKS_DIR/$task/CLAUDE.md" "$TASKS_DIR/$task/AGENTS.md"; do
    [[ -f "$target" ]] || continue
    if replace_marked_block "$target" project "$content"; then
      wrote=1
    else
      warn "could not update $target"
    fi
  done

  if [[ -z "$wrote" ]]; then
    warn "no CLAUDE.md/AGENTS.md in task '$task'; the agent will not be told about project '$project'"
    warn "  (created with --no-context? drop the flag, or write the files yourself)"
  fi
}

# Regenerates the generated blocks in a task's context files. Called after any
# change to the task's shape, which is also the long-standing bug this fixes:
# add-repo used to leave the repo list in CLAUDE.md stale forever.
refresh_task_blocks() {
  local task="$1"
  local branch="$2"
  local folder_path="$TASKS_DIR/$task"
  local repos_list=""
  local child=""
  local target=""
  local project=""

  [[ -d "$folder_path" ]] || return 0

  for child in "$folder_path"/*; do
    [[ -d "$child" ]] || continue
    repos_list="${repos_list:+$repos_list
}${child##*/}"
  done

  for target in "$folder_path/CLAUDE.md" "$folder_path/AGENTS.md"; do
    [[ -f "$target" ]] || continue

    # A template seeded before the markers existed has nothing to refresh, and
    # is never re-seeded — so say so rather than silently leaving the repo list
    # wrong, which is the very bug the markers were added to fix.
    if ! grep -q "<!-- iwork:repos -->" "$target" 2>/dev/null; then
      warn "${target##*/} has no <!-- iwork:repos --> block, so its repo list is now stale"
      warn "  add the markers around {{REPOS}} in $CONTEXT_TEMPLATE to fix this for new tasks,"
      warn "  and edit ${target##*/} by hand for this one"
      continue
    fi

    replace_marked_block "$target" repos "$repos_list" || warn "could not refresh $target"
  done

  project="$(task_project_name "$task" || true)"
  if [[ -n "$project" ]] && project_exists "$project"; then
    write_project_block "$task" "$project" "$branch"
  fi
}

attach_task_to_project() {
  local task="$1"
  local project="$2"
  local branch="$3"
  local seed="${4:-}"
  local already=""

  validate_worktree_folder_name "$task"
  validate_project_name "$project"
  require_projects_dir
  [[ -d "$TASKS_DIR/$task" ]] || die "no such task: $task"

  # Before the link and the history row are written, so both record the same
  # spelling the directory actually has.
  project="$(canonical_project_name "$project")"

  # Refuse before ensure_project, not after: attaching an already-attached task
  # to a new name used to create that project and only then fail, leaving a
  # directory behind that nothing referenced.
  already="$(task_project_name "$task" || true)"
  if [[ -n "$already" && "$already" != "$project" ]]; then
    die "task '$task' is already attached to project '$already'; a task belongs to one project.
  Detach it first:  iwork project rm $already $task"
  fi

  ensure_project "$project"
  link_task_project "$task" "$project"
  write_project_block "$task" "$project" "$branch" "$seed"

  if [[ -z "$already" ]]; then
    append_history "$project" opened "$task" "$(task_repos_csv "$task")" "$branch" ""
    echo "Task '$task' joined project '$project'"
  else
    echo "Task '$task' is already in project '$project' (context refreshed)"
  fi
}

detach_task_from_project() {
  local project="$1"
  local task="$2"
  local attached=""
  local target=""

  validate_worktree_folder_name "$task"
  validate_project_name "$project"
  [[ -d "$TASKS_DIR/$task" ]] || die "no such task: $task"

  attached="$(task_project_name "$task" || true)"
  [[ -n "$attached" ]] || die "task '$task' is not attached to any project"
  [[ "$attached" == "$project" ]] ||
    die "task '$task' is attached to project '$attached', not '$project'"

  rm -f "$TASKS_DIR/$task/.project" || die "could not remove $TASKS_DIR/$task/.project"

  for target in "$TASKS_DIR/$task/CLAUDE.md" "$TASKS_DIR/$task/AGENTS.md"; do
    [[ -f "$target" ]] || continue
    strip_marked_block "$target" project || warn "could not update $target"
  done

  # Without this the task's last event stays 'opened' forever, so 'project show'
  # lists a detached task under "Past tasks" as though it were still running,
  # and re-attaching appends a second 'opened' with no close between them.
  append_history "$project" detached "$task" "" "" ""

  echo "Detached '$task' from project '$project'. Project memory was left intact."
}

delete_project() {
  local project="$1"
  local force="$2"
  local attached=""
  local task=""

  validate_project_name "$project"
  project_exists "$project" || die "no such project: $project"

  while IFS= read -r task; do
    [[ -n "$task" ]] || continue
    [[ "$(task_project_name "$task" || true)" == "$project" ]] && attached="${attached:+$attached }$task"
  done < <(list_worktree_folders)

  if [[ -n "$attached" ]]; then
    die "project '$project' still has tasks attached: $attached
  Detach them first, or remove those tasks."
  fi

  if [[ -z "$force" ]]; then
    die "refusing to delete the memory for '$project'; re-run with -f if you mean it"
  fi

  echo "This deletes $PROJECTS_DIR/$project and everything in it:"
  echo "  PROJECT.md, LOG.md, TODO.md, history.tsv, notes/"
  confirm "Proceed?" || die "aborted"

  rm -rf "${PROJECTS_DIR:?}/${project:?}" || die "could not remove $PROJECTS_DIR/$project"
  echo "Deleted project '$project'"
}

# --- capture -----------------------------------------------------------------

# One line, and bounded. project show prints these back and the SessionStart
# hook injects them as context on every session in the project, so an unbounded
# entry would pollute every future session with no way to take it back: LOG.md
# is append-only and hand-editing is off limits.
ENTRY_MAX_CHARS="${IWORK_ENTRY_MAX_CHARS:-800}"

oneline() {
  local text="$1"

  text="${text//$'\r'/ }"
  text="${text//$'\n'/ }"
  text="${text//$'\t'/ }"

  if (( ${#text} > ENTRY_MAX_CHARS )); then
    text="${text:0:$ENTRY_MAX_CHARS} […truncated]"
  fi

  printf '%s' "$text"
}

# Derived from the text, the clock and the pid rather than from scanning
# TODO.md: that is what keeps capture a pure append with no read and no lock.
#
# 32 bits, not 16: closed todos stay in the file and keep matching, so the id
# space never frees, and at 16 bits a project that accumulated a couple of
# hundred todos hit collisions — which made both of them unclosable.
new_todo_id() {
  local text="$1"
  local sum=""

  sum="$(printf '%s|%s|%s|%s' "$text" "$(date +%s)" "$$" "${RANDOM:-0}" |
    cksum | awk '{print $1}')"
  printf 't%08x' "$(( sum % 4294967296 ))"
}

validate_todo_id() {
  [[ "$1" =~ ^t[0-9a-f]{1,8}$ ]] || die "'$1' is not a todo id (expected something like t1a2f9c04)"
}

PROJECT_LOCK_DIR=""

# Only the rewrite paths take this. mkdir is the atomic primitive available
# everywhere; flock(1) is not on macOS.
project_lock() {
  local project="$1"
  local dir="$PROJECTS_DIR/$project/.lock"
  local waited=0
  local pid=""

  while ! mkdir "$dir" 2>/dev/null; do
    pid="$(cat "$dir/pid" 2>/dev/null || true)"

    # A killed agent leaves the lockdir behind; its pid is the tell.
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      rm -rf "$dir" 2>/dev/null || true
      continue
    fi

    waited=$((waited + 1))

    # No pid after a second: the holder died between mkdir and writing it.
    if [[ -z "$pid" ]] && (( waited > 10 )); then
      rm -rf "$dir" 2>/dev/null || true
      continue
    fi

    if (( waited > 40 )); then
      warn "could not acquire the lock for project '$project' after 4s"
      return 1
    fi

    sleep 0.1
  done

  printf '%s\n' "$$" > "$dir/pid" 2>/dev/null || true
  PROJECT_LOCK_DIR="$dir"
  trap 'project_unlock' EXIT
  return 0
}

project_unlock() {
  [[ -n "$PROJECT_LOCK_DIR" ]] || return 0
  rm -rf "$PROJECT_LOCK_DIR" 2>/dev/null || true
  PROJECT_LOCK_DIR=""
}

# Date alone was not enough: ten entries made on one day all read as that day,
# so there was no way to tell when any of them happened. Minute precision is
# plenty — both files are append-only, so position already gives exact ordering.
entry_stamp() {
  date '+%Y-%m-%d %H:%M'
}

# These warn and return non-zero rather than calling die: they are reached from
# hook paths, and a die() there exits the hook non-zero past every '|| true' the
# caller wrapped it in, which Claude Code reports as a broken hook. Callers that
# want a hard failure say so themselves.
append_log() {
  local project="$1"
  local task="$2"
  local kind="$3"
  local text="$4"

  text="$(oneline "$text")"
  [[ -n "$text" ]] || { warn "nothing to log"; return 1; }

  # One short line, one printf: O_APPEND makes this atomic, so parallel agents
  # cannot interleave and capture never waits on a lock.
  printf -- '- %s  %s  %s: %s\n' "$(entry_stamp)" "${task:-unknown}" "$kind" "$text" \
    >> "$PROJECTS_DIR/$project/LOG.md" || { warn "could not append to LOG.md"; return 1; }
}

append_todo() {
  local project="$1"
  local task="$2"
  local text="$3"
  local id=""

  text="$(oneline "$text")"
  [[ -n "$text" ]] || { warn "nothing to capture"; return 1; }

  id="$(new_todo_id "$text")"
  printf -- '- [ ] (%s) %s — from %s, %s\n' \
    "$id" "$text" "${task:-unknown}" "$(entry_stamp)" \
    >> "$PROJECTS_DIR/$project/TODO.md" ||
    { warn "could not append to TODO.md"; return 1; }

  printf '%s\n' "$id"
}

append_history() {
  local project="$1"
  local event="$2"
  local task="$3"
  # Not 'repos': that name is the global array the worktree code fills.
  local repos_csv="$4"
  local ref="$5"
  local note="$6"

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date +%Y-%m-%dT%H:%M:%S%z)" "$event" "$(oneline "$task")" \
    "$(oneline "$repos_csv")" "$(oneline "$ref")" "$(oneline "$note")" \
    >> "$PROJECTS_DIR/$project/history.tsv" || warn "could not append to history.tsv"
}

flip_todo() {
  local project="$1"
  local id="$2"
  local mark="$3"
  local nth="${4:-}"
  local file="$PROJECTS_DIR/$project/TODO.md"
  local matches=()
  local match=""
  local target=0
  local tmp=""
  local line=""
  local rest=""
  local verb=""
  local n=0

  [[ -f "$file" ]] || die "no TODO.md in project '$project'"
  validate_todo_id "$id"

  while IFS= read -r match; do
    [[ -n "$match" ]] && matches+=("$match")
  done < <(grep -n "^- \[.\] ($id)" "$file" 2>/dev/null || true)

  if (( ${#matches[@]} == 0 )); then
    while IFS= read -r match; do
      [[ -n "$match" ]] && matches+=("$match")
    done < <(grep -n "^- \[.\] (${id}[0-9a-f]*)" "$file" 2>/dev/null || true)
  fi

  (( ${#matches[@]} > 0 )) || die "no todo with id '$id' in project '$project'"

  if (( ${#matches[@]} > 1 )); then
    case "$mark" in
      x) verb="done" ;;
      *) verb="drop" ;;
    esac

    # "Use the full id" was useless advice when the id already was full, so
    # offer an index the user can actually act on.
    if [[ -z "$nth" ]]; then
      echo "id '$id' matches ${#matches[@]} todos:" >&2
      for match in "${matches[@]}"; do
        n=$((n + 1))
        printf '  %s. %s\n' "$n" "${match#*:}" >&2
      done
      die "pick one with: iwork $verb $id --nth <1-${#matches[@]}>"
    fi

    [[ "$nth" =~ ^[1-9][0-9]*$ ]] || die "--nth needs a number from 1 to ${#matches[@]}"
    (( nth <= ${#matches[@]} )) || die "--nth $nth is out of range (1-${#matches[@]})"
    target="${matches[$((nth - 1))]%%:*}"
  else
    [[ -z "$nth" ]] || die "--nth only applies when an id matches more than one todo"
    target="${matches[0]%%:*}"
  fi

  n=0

  project_lock "$project" || die "project '$project' is locked; nothing was changed"

  tmp="$file.iwork.$$"
  : > "$tmp" || { project_unlock; die "could not write $tmp"; }

  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    if (( n == target )); then
      rest="${line#*\]}"
      printf -- '- [%s]%s\n' "$mark" "$rest" >> "$tmp"
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$file"

  if ! mv "$tmp" "$file" 2>/dev/null; then
    rm -f "$tmp"
    project_unlock
    die "could not update $file"
  fi

  project_unlock
}

project_tasks_live() {
  local project="$1"
  local folder=""

  while IFS= read -r folder; do
    [[ -n "$folder" ]] || continue
    [[ "$(task_project_name "$folder" || true)" == "$project" ]] && printf '%s\n' "$folder"
  done < <(list_worktree_folders)
}

# Tasks known only from history.tsv: last event per task, in the order they
# first appear, minus the ones that still exist on disk. A task deleted outside
# iwork stops being live but must not stop being remembered.
project_history_tasks() {
  local project="$1"
  local dir="$PROJECTS_DIR/$project"
  local live=""
  local folder=""

  while IFS= read -r folder; do
    [[ -n "$folder" ]] && live="$live $folder "
  done < <(project_tasks_live "$project")

  awk -F'\t' -v live="$live" '
    /^#/ { next }
    NF >= 5 && $3 != "" {
      event[$3] = $2
      ref[$3] = $5
      if (!($3 in seen)) { seen[$3] = 1; order[++n] = $3 }
    }
    END {
      for (i = 1; i <= n; i++) {
        t = order[i]
        if (index(live, " " t " ") > 0) continue
        printf "%s\t%s\t%s\n", t, event[t], ref[t]
      }
    }
  ' "$dir/history.tsv" 2>/dev/null
}

project_show() {
  local project="$1"
  local dir="$PROJECTS_DIR/$project"
  local goal=""
  local line=""
  local status=""
  local found=""
  local total=0
  local since=0

  goal="$(project_goal "$project")"

  echo "Project: $project"
  echo "  $dir"
  if [[ -n "$goal" ]]; then
    echo ""
    echo "  $goal"
  fi

  echo ""
  echo "Tasks (live):"
  found=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    found=1
    status=""
    tmux_enabled && status="$(task_status "$line")"
    if [[ -n "$status" ]]; then
      printf '  %s  %s\n' "$line" "$status"
    else
      printf '  %s\n' "$line"
    fi
  done < <(project_tasks_live "$project")
  [[ -n "$found" ]] || echo "  (none)"

  echo ""
  echo "Open todos:"
  found=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    found=1
    printf '  %s\n' "${line#- \[ \] }"
  done < <(grep '^- \[ \] ' "$dir/TODO.md" 2>/dev/null || true)
  [[ -n "$found" ]] || echo "  (none)"

  total="$(grep -c '^- ' "$dir/LOG.md" 2>/dev/null || true)"
  total="${total:-0}"
  echo ""
  if (( total > SHOW_LOG_LINES )); then
    echo "Log (last $SHOW_LOG_LINES of $total):"
  else
    echo "Log:"
  fi
  found=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    found=1
    printf '  %s\n' "${line#- }"
  done < <(grep '^- ' "$dir/LOG.md" 2>/dev/null | tail -n "$SHOW_LOG_LINES" || true)
  [[ -n "$found" ]] || echo "  (nothing recorded yet)"

  echo ""
  echo "Past tasks:"
  found=""
  while IFS=$'\t' read -r line status rest; do
    [[ -n "$line" ]] || continue
    found=1
    printf '  %s  %s  %s\n' "$line" "$status" "$rest"
  done < <(project_history_tasks "$project" | tail -n "$SHOW_LOG_LINES")
  [[ -n "$found" ]] || echo "  (none yet)"
  echo "  full history: $dir/history.tsv"

  # Entries since the last checkpoint. Without a nudge, a long project quietly
  # pushes its early decisions out of the window this command prints.
  since="$(awk '/^- .*checkpoint:/ { n = 0; next } /^- / { n++ } END { print n + 0 }' \
    "$dir/LOG.md" 2>/dev/null || true)"
  since="${since:-0}"
  if (( since > CHECKPOINT_NUDGE_AFTER )); then
    echo ""
    echo "  Note: $since log entries since the last checkpoint. Consider condensing"
    echo "  the older ones into PROJECT.md's 'Where we are' so they stay visible here."
  fi
}

# The read counterpart to project_grep. Without it an agent that is told not to
# touch .project/ has no way to open a file grep just pointed it at.
project_cat() {
  local project="$1"
  local rel="$2"
  local target=""

  [[ -n "$rel" ]] || die "usage: iwork project cat <path-inside-the-project>"

  # /$rel/ makes both leading-slash and any '..' component a single glob test,
  # without rejecting an innocent name like 'v1..2.md'.
  case "/$rel/" in
    *//*|*/../*)
      die "path must be relative to the project directory and must not contain '..': $rel"
      ;;
  esac

  target="$PROJECTS_DIR/$project/$rel"
  [[ -f "$target" ]] || die "no such file in project '$project': $rel"

  # The '..' test above is not containment on its own: a symlink inside the
  # project reaches outside without one — as a directory (notes/etc -> /etc) or
  # as the file itself (notes/x.md -> /elsewhere). Follow the chain, then check
  # where it actually landed.
  local resolved="$target"
  local link=""
  local hops=0
  local dir_real=""
  local project_real=""

  while [[ -L "$resolved" ]]; do
    hops=$((hops + 1))
    (( hops <= 32 )) || die "too many symlinks resolving '$rel' in project '$project'"
    link="$(readlink "$resolved")" || die "cannot resolve '$rel' in project '$project'"
    case "$link" in
      /*) resolved="$link" ;;
      *) resolved="$(dirname "$resolved")/$link" ;;
    esac
  done

  dir_real="$(cd "$(dirname "$resolved")" 2>/dev/null && pwd -P)" ||
    die "cannot resolve '$rel' in project '$project'"
  project_real="$(cd "$PROJECTS_DIR/$project" && pwd -P)"

  case "$dir_real/" in
    "$project_real"/*) ;;
    *) die "'$rel' resolves outside project '$project' (via a symlink); refusing" ;;
  esac

  cat "$resolved"
}

project_grep() {
  local project="$1"
  local dir="$PROJECTS_DIR/$project"

  shift
  (( $# > 0 )) || die "usage: iwork project grep <pattern> [ripgrep-args...]"

  # cd into the real directory rather than going through the task's .project
  # link: that link is both hidden and a symlink, so recursive search from a
  # task root skips it twice over. This is the whole reason this verb exists.
  if command -v rg >/dev/null 2>&1; then
    ( cd "$dir" && rg --hidden --glob '!.lock' --glob '!.git' -n -- "$@" . )
  else
    ( cd "$dir" && grep -RIn --exclude-dir=.lock --exclude-dir=.git -- "$@" . )
  fi
}

open_task_window() {
  local folder="$1"
  local tool="$2"
  shift 2
  local folder_path="$TASKS_DIR/$folder"
  local window_id=""
  local pane_id=""
  local tool_cmd=""

  tmux_enabled || return 0
  [[ -d "$folder_path" ]] || return 0

  if window_id="$(find_task_window "$folder")"; then
    if [[ -n "$IWORK_DETACH" ]]; then
      echo "tmux window '$folder' is already open (not switching)"
      return 0
    fi
    switch_to_window "$window_id" || true
    return 0
  fi

  if tmux has-session -t "=$TASKS_SESSION" 2>/dev/null; then
    # -d keeps the new window from becoming the session's active window, which
    # would move the client if it is already viewing the tasks session.
    if ! IFS=' ' read -r window_id pane_id < <(tmux new-window ${IWORK_DETACH:+-d} -t "=$TASKS_SESSION" -n "$folder" -c "$folder_path" -P -F '#{window_id} #{pane_id}' 2>/dev/null); then
      warn "could not create tmux window '$folder'"
      return 0
    fi
  else
    if ! IFS=' ' read -r window_id pane_id < <(tmux new-session -d -s "$TASKS_SESSION" -n "$folder" -c "$folder_path" -P -F '#{window_id} #{pane_id}' 2>/dev/null); then
      warn "could not create tmux session '$TASKS_SESSION'"
      return 0
    fi
  fi

  tmux split-window -h -t "$pane_id" -c "$folder_path" 2>/dev/null || warn "could not split tmux window '$folder'"
  tmux select-pane -t "$pane_id" 2>/dev/null || true

  printf -v tool_cmd '%q ' "$tool" "$@"
  tmux send-keys -t "$pane_id" "$tool_cmd" Enter 2>/dev/null || warn "could not start $tool in tmux window '$folder'"

  if [[ -n "$IWORK_DETACH" ]]; then
    echo "Started $tool in detached tmux window '$folder' (session '$TASKS_SESSION')"
    echo "  attach with: iwork cd $folder"
    return 0
  fi

  switch_to_window "$window_id" || true
}

# One window per repo worktree: editor on the left, shell on the right, both
# rooted in the worktree. Idempotent, so add-repo can extend a live session.
add_repo_windows() {
  local folder="$1"
  local session="$2"
  local folder_path="$TASKS_DIR/$folder"
  local wt=""
  local name=""
  local pane_id=""
  local added=0

  while IFS= read -r wt; do
    [[ -n "$wt" ]] || continue
    name="${wt##*/}"

    find_window_in_session "$session" "$name" >/dev/null && continue

    if ! pane_id="$(tmux new-window -d -t "=$session" -n "$name" -c "$wt" -P -F '#{pane_id}' 2>/dev/null)"; then
      warn "could not create tmux window '$name'"
      continue
    fi

    tmux split-window -h -t "$pane_id" -c "$wt" 2>/dev/null || warn "could not split tmux window '$name'"
    tmux select-pane -t "$pane_id" 2>/dev/null || true
    # IWORK_EDITOR is a command line from the user's own config, so run it as
    # written with the worktree appended.
    tmux send-keys -t "$pane_id" "$IWORK_EDITOR ." Enter 2>/dev/null ||
      warn "could not start $IWORK_EDITOR in tmux window '$name'"
    added=$((added + 1))
  done < <(list_task_worktrees "$folder_path")

  printf '%s\n' "$added"
}

open_task_session() {
  local folder="$1"
  local tool="$2"
  shift 2
  local folder_path="$TASKS_DIR/$folder"
  local session=""
  local window_id=""
  local pane_id=""
  local tool_cmd=""
  local created=""
  local added=0
  local shared_line=""

  tmux_enabled || return 0
  [[ -d "$folder_path" ]] || return 0

  session="$(task_session_name "$folder")"

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    # The task may already be open as a plain window in the shared session;
    # starting a second agent for it in a new session would be a surprise.
    if shared_line="$(find_window_in_session "$TASKS_SESSION" "$folder")"; then
      warn "task '$folder' is already open in session '$TASKS_SESSION'; not starting a second agent there"
      warn "close that window first if you want '$folder' to have its own session"
      if [[ -z "$IWORK_DETACH" ]] && in_tmux; then
        switch_to_window "${shared_line%% *}" || true
      fi
      return 0
    fi

    # The agent window keeps the task name so the Claude status hooks still
    # recognise it (*task busy, !task waiting).
    if ! IFS=' ' read -r window_id pane_id < <(tmux new-session -d -s "$session" -n "$folder" -c "$folder_path" -P -F '#{window_id} #{pane_id}' 2>/dev/null); then
      warn "could not create tmux session '$session'"
      return 0
    fi
    created=1

    tmux split-window -h -t "$pane_id" -c "$folder_path" 2>/dev/null || warn "could not split tmux window '$folder'"
    tmux select-pane -t "$pane_id" 2>/dev/null || true

    printf -v tool_cmd '%q ' "$tool" "$@"
    tmux send-keys -t "$pane_id" "$tool_cmd" Enter 2>/dev/null || warn "could not start $tool in tmux window '$folder'"
  fi

  added="$(add_repo_windows "$folder" "$session")"

  if [[ -z "$created" ]]; then
    echo "tmux session '$session' already exists (added $added repo window(s))"
  else
    echo "tmux session '$session': '$folder' running $tool, plus $added repo window(s)"
  fi

  if [[ -n "$IWORK_DETACH" ]]; then
    echo "  attach with: tmux switch-client -t $session   (or: tmux attach -t $session)"
    return 0
  fi

  if ! in_tmux; then
    echo "  attach with: tmux attach -t $session"
    return 0
  fi

  if ! window_id="$(find_task_window "$folder")"; then
    return 0
  fi
  switch_to_window "$window_id" || true
}

open_task() {
  if [[ -n "$IWORK_BIG" ]]; then
    open_task_session "$@"
  else
    open_task_window "$@"
  fi
}

# add-repo into a task that already owns a session should get a window too.
extend_task_session() {
  local folder="$1"
  local session=""
  local added=0

  tmux_enabled || return 0
  session="$(task_session_name "$folder")"
  tmux has-session -t "=$session" 2>/dev/null || return 0

  added="$(add_repo_windows "$folder" "$session")"
  (( added > 0 )) && echo "Added $added window(s) to tmux session '$session'"
  return 0
}

HOOK_TASK=""
HOOK_PROJECT=""

# Which task and project the hook fired in, from its working directory. Silent
# and non-fatal throughout: a hook must never break a session, so every path out
# of here is a plain 'return 1' that the callers treat as "nothing to do".
hook_project_context() {
  HOOK_TASK=""
  HOOK_PROJECT=""

  [[ -n "$TASKS_DIR" && -n "$PROJECTS_DIR" ]] || return 1

  HOOK_TASK="$(task_root_from_cwd 2>/dev/null || true)"
  [[ -n "$HOOK_TASK" ]] || return 1

  HOOK_PROJECT="$(task_project_name "$HOOK_TASK" 2>/dev/null || true)"
  [[ -n "$HOOK_PROJECT" ]] || return 1

  project_exists "$HOOK_PROJECT" || return 1
  return 0
}

# Stdout becomes context, so the agent starts already knowing the project state
# instead of having to decide to go and look.
hook_session_start() {
  hook_project_context || return 0

  echo "iwork: this task belongs to project '$HOOK_PROJECT'. Its shared memory:"
  echo ""
  project_show "$HOOK_PROJECT" 2>/dev/null || true
  echo ""
  echo "Read it with 'iwork project show|grep|cat' rather than opening the files"
  echo "under .project/ — and never write to them by hand, because agents in"
  echo "sibling tasks are appending to the same files right now. Record as you go:"
  echo "  iwork decided \"<what you settled and why>\""
  echo "  iwork todo \"<needs doing, but not in this PR>\""
  echo "'iwork project -h' lists every command that is yours. Task management"
  echo "(rm, park, add-repo) is the operator's — do not run it uninvited."
}

# Fires exactly when the reasoning is about to be dropped, which is the one
# moment a reminder to write it down is unambiguously worth its noise.
hook_pre_compact() {
  hook_project_context || return 0

  echo "iwork: this context is about to be compacted. Anything you worked out in"
  echo "project '$HOOK_PROJECT' that is not in the log yet will be lost with it."
  echo "  iwork decided \"<what you settled and why>\""
  echo "  iwork todo \"<needs doing, but not in this PR>\""
  echo "Nothing worth keeping? Then record nothing — a padded log is worse."
}

# A PR URL is a fact, not a judgement call, so it does not need the agent to
# remember anything.
# Reads the Bash command and its output as separate fields. A substring test over
# the whole payload matched 'gh pr create' appearing in tool OUTPUT — so
# 'grep -rn "gh pr create" docs/' logged whatever PR link happened to be in the
# match, writing false history into an append-only file.
hook_pr_url_from_payload() {
  command -v python3 >/dev/null 2>&1 || return 1

  python3 -c '
import json, re, sys

try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)

cmd = (d.get("tool_input") or {}).get("command") or ""
# Only an actual invocation counts, not a mention of one. Allow a leading cd/&&
# chain, which is how these commands are usually written.
if not re.search(r"(^|[;&|]\s*)gh\s+pr\s+create(\s|$)", cmd):
    sys.exit(1)

resp = d.get("tool_response")
if not isinstance(resp, str):
    resp = json.dumps(resp) if resp is not None else ""

m = re.search(r"https://github\.com/[\w.-]+/[\w.-]+/pull/\d+", resp)
if not m:
    sys.exit(1)
print(m.group(0))
'
}

hook_post_tool_use() {
  local input="$1"
  local url=""

  url="$(printf '%s' "$input" | hook_pr_url_from_payload 2>/dev/null || true)"
  [[ -n "$url" ]] || return 0

  hook_project_context || return 0

  # The payload can be seen more than once; never log the same PR twice.
  if grep -qF "$url" "$PROJECTS_DIR/$HOOK_PROJECT/LOG.md" 2>/dev/null; then
    return 0
  fi

  append_log "$HOOK_PROJECT" "$HOOK_TASK" shipped "$url" 2>/dev/null || return 0
  echo "iwork: recorded $url in project '$HOOK_PROJECT'"
}

mark_task_window() {
  local event="$1"
  local window_name=""
  local base=""
  local marker=""

  [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || return 0
  [[ -n "$TASKS_DIR" ]] || return 0

  case "$event" in
    UserPromptSubmit)
      marker='*'
      ;;
    Stop|Notification)
      marker='!'
      ;;
    *)
      return 0
      ;;
  esac

  window_name="$(tmux display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null)" || return 0
  base="${window_name#[*!]}"
  [[ -n "$base" ]] || return 0
  if [[ ! -d "$TASKS_DIR/$base" ]]; then
    [[ -n "$PROJECTS_DIR" && -d "$PROJECTS_DIR/$base" ]] || return 0
  fi

  if [[ "$window_name" != "${marker}${base}" ]]; then
    tmux rename-window -t "$TMUX_PANE" "${marker}${base}" 2>/dev/null || true
  fi
}

handle_claude_hook() {
  local input=""
  local event=""

  input="$(cat 2>/dev/null || true)"
  event="$(printf '%s' "$input" |
    sed -n 's/.*"hook_event_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
    head -1 || true)"
  [[ -n "$event" ]] || exit 0

  case "$event" in
    SessionStart)
      hook_session_start || true
      exit 0
      ;;
    PreCompact)
      hook_pre_compact || true
      exit 0
      ;;
    PostToolUse)
      hook_post_tool_use "$input" || true
      exit 0
      ;;
  esac

  mark_task_window "$event" || true
  exit 0
}

run_init() {
  local repo_dir="" tasks_dir="" answer="" config_dir=""

  if ! { : </dev/tty; } 2>/dev/null; then
    die "iwork init needs an interactive terminal"
  fi

  if [[ -f "$IWORK_CONFIG_FILE" ]]; then
    printf 'Config already exists: %s\nOverwrite? [y/N] ' "$IWORK_CONFIG_FILE"
    IFS= read -r answer </dev/tty
    case "$answer" in
      y|Y) ;;
      *) die "aborted" ;;
    esac
  fi

  printf 'Directory that holds your repos (e.g. ~/dev/projects): '
  IFS= read -r repo_dir </dev/tty
  repo_dir="${repo_dir/#\~/$HOME}"
  [[ -n "$repo_dir" ]] || die "a repo directory is required"
  [[ -d "$repo_dir" ]] || die "not a directory: $repo_dir"
  repo_dir="$(cd "$repo_dir" && pwd)"

  printf 'Directory for task folders [%s/tasks]: ' "$repo_dir"
  IFS= read -r tasks_dir </dev/tty
  if [[ -n "$tasks_dir" ]]; then
    tasks_dir="${tasks_dir/#\~/$HOME}"
  fi

  config_dir="$(dirname "$IWORK_CONFIG_FILE")"
  mkdir -p "$config_dir" || die "could not create $config_dir"

  {
    echo '# iwork configuration. Plain shell, sourced by iwork.'
    echo '# Environment variables override values set here.'
    printf 'IWORK_REPO_DIR=%q\n' "$repo_dir"
    if [[ -n "$tasks_dir" ]]; then
      printf 'IWORK_TASKS_DIR=%q\n' "$tasks_dir"
    else
      echo '# IWORK_TASKS_DIR="$IWORK_REPO_DIR/tasks"'
    fi
    echo '# IWORK_TMUX_SESSION=tasks'
    echo '# IWORK_CONTEXT_TEMPLATE="$HOME/.config/iwork/task-context.md.tmpl"'
  } > "$IWORK_CONFIG_FILE" || die "could not write $IWORK_CONFIG_FILE"

  echo "Wrote $IWORK_CONFIG_FILE"
  echo "  repo dir:  $repo_dir"
  echo "  tasks dir: ${tasks_dir:-$repo_dir/tasks}"
}

install_claude_hooks() {
  local settings_path="$1"
  # Quoted, because the settings file stores a shell command line: an iwork
  # installed under a path containing a space produced a hook that failed with
  # 127 on every event.
  local hook_cmd=""
  printf -v hook_cmd '%q --hook' "$SELF_PATH"

  command -v python3 >/dev/null 2>&1 || die "install-hooks requires python3"

  python3 - "$settings_path" "$hook_cmd" <<'PY'
import json
import os
import sys

settings_path = sys.argv[1]
cmd = sys.argv[2]

# (event, matcher). The first three keep tmux window names in sync; the rest
# feed project memory to the agent and record PRs without being asked.
events = [
    ("UserPromptSubmit", None),
    ("Stop", None),
    ("Notification", None),
    ("SessionStart", None),
    ("PreCompact", None),
    ("PostToolUse", "Bash"),
]

data = {}
if os.path.exists(settings_path):
    with open(settings_path) as f:
        try:
            data = json.load(f)
        except ValueError as exc:
            # A raw JSONDecodeError traceback here reads like an iwork crash
            # rather than "your settings file is broken".
            sys.exit(
                f"{settings_path} is not valid JSON ({exc}).\n"
                "Fix or move it, then re-run; refusing to overwrite it."
            )
if not isinstance(data, dict):
    sys.exit(f"{settings_path} does not contain a JSON object; refusing to overwrite it.")

hooks = data.setdefault("hooks", {})
to_add = []
for ev, matcher in events:
    entries = hooks.setdefault(ev, [])
    present = any(
        h.get("command") == cmd
        for entry in entries
        for h in entry.get("hooks", [])
    )
    if not present:
        to_add.append((ev, matcher))

if not to_add:
    print(f"iwork hook already installed for all events in {settings_path}")
    sys.exit(0)

print(f"Will add to {settings_path}:")
for ev, matcher in to_add:
    where = f' (matcher: {matcher})' if matcher else ""
    print(f'  {ev}{where}: {{"type": "command", "command": "{cmd}"}}')

if os.environ.get("IWORK_ASSUME_YES") != "1":
    try:
        with open("/dev/tty") as tty:
            print("Proceed? [y/N] ", end="", flush=True)
            answer = tty.readline().strip().lower()
    except OSError:
        sys.exit("no TTY available for confirmation; aborting")
    if answer != "y":
        sys.exit("aborted")

for ev, matcher in to_add:
    entry = {"hooks": [{"type": "command", "command": cmd}]}
    if matcher:
        entry["matcher"] = matcher
    hooks[ev].append(entry)

settings_dir = os.path.dirname(settings_path)
if settings_dir:
    os.makedirs(settings_dir, exist_ok=True)
tmp_path = settings_path + ".tmp"
with open(tmp_path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
if os.path.exists(settings_path):
    os.chmod(tmp_path, os.stat(settings_path).st_mode & 0o777)
else:
    os.chmod(tmp_path, 0o600)
os.replace(tmp_path, settings_path)
print(f"Updated {settings_path}")
PY
}

PROJECT_FLAG=""

# Accepts -p/--project in any position, so both of these work:
#   iwork feat/x -r api web -p myproj
#   iwork feat/x -p myproj -r api web
parse_task_args() {
  local seen_r=""

  repos=()
  PROJECT_FLAG=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r)
        seen_r=1
        shift
        ;;
      -p|--project)
        [[ $# -ge 2 ]] || die "expected a project name after $1"
        PROJECT_FLAG="$2"
        validate_project_name "$PROJECT_FLAG"
        shift 2
        ;;
      --from)
        # Handled here rather than stripped before the parser, so --from, -p and
        # -r can appear in any order and there is one parser rather than two.
        [[ $# -ge 2 ]] || die "--from needs a task or branch name"
        BASE_SPEC="$2"
        validate_base_spec "$BASE_SPEC"
        shift 2
        ;;
      -*)
        die "unknown option '$1'"
        ;;
      *)
        [[ -n "$seen_r" ]] || die "expected -r <repos> after the branch name"
        repos+=("$1")
        shift
        ;;
    esac
  done

  [[ -n "$seen_r" ]] || die "expected -r <repos> after the branch name"
  (( ${#repos[@]} > 0 )) || die "specify at least one repo after -r"
}

# Scoped help, so an agent has somewhere to discover its own verbs without
# reading the full 'iwork -h', which is mostly operator material and advertises
# 'rm -f'. The three groups are the point: they say which commands are whose.
project_usage() {
  cat <<'EOF'
iwork project — the memory shared by every task of one longer-horizon effort.

Inside a task the project is inferred from the .project link, so none of these
need -p. Pass -p <project> to target one from anywhere else.

Reading — safe to run at any time:
  iwork project show [-n <count>] [<project>]
                                 goal, live tasks, open todos, recent log
  iwork project grep <pattern>   search the whole project memory
  iwork project cat <path>       print one file from it, e.g. notes/api.md
  iwork project list             every project

Recording — one atomic line each; use these instead of editing the files, which
sibling tasks are appending to while you work:
  iwork todo "<needs doing, but not in this PR>"
  iwork decided "<what you settled and why>"
  iwork log [--decision|--shipped|--note] "<what>"
  iwork done <todo-id>           close a captured todo
  iwork drop <todo-id>           abandon one
     add --nth <n> if an id somehow matches more than one todo

Managing — the operator's, not an agent's; these change or destroy tasks, so do
not run them unless you were asked to directly:
  iwork project add <project> [<task>]   attach a task that already exists
  iwork project rm [<project>] [<task>]  detach a task, keeping the memory
  iwork project delete [-f] <project>    delete a project and its memory

For task and tmux management (creating tasks, add-repo, rm, park, install-hooks)
see 'iwork -h'.
EOF
}

cmd_project() {
  local sub="${1:-}"
  local proj=""
  local task=""
  local branch=""
  local force=""
  local count=""
  local rc=0

  shift || true

  case "$sub" in
    list)
      require_config
      require_projects_dir
      list_projects
      ;;
    show)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -n)
            count="${2:-}"
            [[ "$count" =~ ^[1-9][0-9]*$ ]] || die "-n needs a positive number"
            shift 2
            ;;
          -p|--project)
            # Both help texts advertise -p here; only the positional worked.
            [[ $# -ge 2 ]] || die "expected a project name after $1"
            proj="$2"
            shift 2
            ;;
          -*) die "unknown option '$1'" ;;
          *)
            [[ -z "$proj" ]] || die "usage: iwork project show [-n <count>] [<project>]"
            proj="$1"
            shift
            ;;
        esac
      done
      resolve_project_context "$proj"
      [[ -n "$count" ]] && SHOW_LOG_LINES="$count"
      project_show "$RESOLVED_PROJECT"
      ;;
    cat)
      if [[ "${1:-}" == "-p" || "${1:-}" == "--project" ]]; then
        proj="${2:-}"
        [[ -n "$proj" ]] || die "expected a project name after $1"
        shift 2
      fi
      [[ $# -eq 1 ]] || die "usage: iwork project cat [-p <project>] <path-inside-the-project>"
      resolve_project_context "$proj"
      project_cat "$RESOLVED_PROJECT" "$1"
      ;;
    grep)
      if [[ "${1:-}" == "-p" || "${1:-}" == "--project" ]]; then
        proj="${2:-}"
        [[ -n "$proj" ]] || die "expected a project name after $1"
        shift 2
      fi
      resolve_project_context "$proj"
      project_grep "$RESOLVED_PROJECT" "$@" || rc=$?
      return "$rc"
      ;;
    add)
      (( $# >= 1 && $# <= 2 )) || die "usage: iwork project add <project> [<task>]"
      require_config
      require_projects_dir
      task="$(resolve_task_arg "${2:-}")"
      [[ -d "$TASKS_DIR/$task" ]] || die "no such task: $task"
      branch="$(detect_branch_from_worktree_folder "$task")"
      attach_task_to_project "$task" "$1" "$branch"
      ;;
    rm)
      (( $# <= 2 )) || die "usage: iwork project rm [<project>] [<task>]"
      require_config
      require_projects_dir
      # Both are inferable: the task from the directory, the project from its
      # own .project link, so a bare 'iwork project rm' detaches where you are.
      task="$(resolve_task_arg "${2:-}")"
      proj="${1:-}"
      if [[ -z "$proj" ]]; then
        proj="$(task_project_name "$task" || true)"
        [[ -n "$proj" ]] || die "task '$task' is not attached to any project"
      fi
      detach_task_from_project "$proj" "$task"
      ;;
    delete)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -f|--force) force=1; shift ;;
          -*) die "unknown option '$1'" ;;
          *)
            [[ -z "$proj" ]] || die "usage: iwork project delete [-f] <project>"
            proj="$1"
            shift
            ;;
        esac
      done
      [[ -n "$proj" ]] || die "usage: iwork project delete [-f] <project>"
      require_config
      require_projects_dir
      delete_project "$proj" "$force"
      ;;
    ""|-h|--help)
      project_usage
      ;;
    *)
      die "unknown 'iwork project' subcommand: $sub (run 'iwork project -h')"
      ;;
  esac
}

cmd_capture() {
  local verb="$1"
  local proj=""
  local kind=""
  local text=""
  local nth=""
  local nargs=0
  local id=""

  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--project)
        [[ $# -ge 2 ]] || die "expected a project name after $1"
        proj="$2"
        validate_project_name "$proj"
        shift 2
        ;;
      --nth)
        [[ $# -ge 2 ]] || die "--nth needs a number"
        nth="$2"
        shift 2
        ;;
      --decision) kind="decision"; shift ;;
      --shipped) kind="shipped"; shift ;;
      --note) kind="note"; shift ;;
      --)
        shift
        while [[ $# -gt 0 ]]; do
          text="${text:+$text }$1"
          nargs=$((nargs + 1))
          shift
        done
        ;;
      -*)
        die "unknown option '$1'"
        ;;
      *)
        text="${text:+$text }$1"
        nargs=$((nargs + 1))
        shift
        ;;
    esac
  done

  resolve_project_context "$proj"

  case "$verb" in
    todo)
      [[ -z "$kind" ]] || die "iwork todo takes no --decision/--shipped/--note"
      [[ -z "$nth" ]] || die "--nth applies only to done/drop"
      (( nargs > 0 )) || die "usage: iwork todo \"<what needs doing>\""
      id="$(append_todo "$RESOLVED_PROJECT" "$RESOLVED_TASK" "$text")" ||
        die "could not capture the todo"
      echo "Captured $id in project '$RESOLVED_PROJECT'"
      ;;
    log)
      [[ -z "$nth" ]] || die "--nth applies only to done/drop"
      (( nargs > 0 )) || die "usage: iwork log [--decision|--shipped|--note] \"<what>\""
      append_log "$RESOLVED_PROJECT" "$RESOLVED_TASK" "${kind:-note}" "$text" ||
        die "could not write to the project log"
      echo "Logged to project '$RESOLVED_PROJECT'"
      ;;
    decided)
      [[ -z "$kind" ]] || die "iwork decided is already --decision"
      [[ -z "$nth" ]] || die "--nth applies only to done/drop"
      (( nargs > 0 )) || die "usage: iwork decided \"<what and why>\""
      append_log "$RESOLVED_PROJECT" "$RESOLVED_TASK" decision "$text" ||
        die "could not write to the project log"
      echo "Recorded a decision in project '$RESOLVED_PROJECT'"
      ;;
    done)
      [[ -z "$kind" ]] || die "iwork done takes no --decision/--shipped/--note"
      (( nargs == 1 )) || die "usage: iwork done <todo-id> [--nth <n>]"
      flip_todo "$RESOLVED_PROJECT" "$text" x "$nth"
      echo "Closed $text in project '$RESOLVED_PROJECT'"
      ;;
    drop)
      [[ -z "$kind" ]] || die "iwork drop takes no --decision/--shipped/--note"
      (( nargs == 1 )) || die "usage: iwork drop <todo-id> [--nth <n>]"
      flip_todo "$RESOLVED_PROJECT" "$text" - "$nth"
      echo "Dropped $text in project '$RESOLVED_PROJECT'"
      ;;
  esac
}

if [[ $# -eq 0 ]]; then
  usage 0
fi

while [[ "${1:-}" == "--no-tmux" || "${1:-}" == "--no-context" || "${1:-}" == "--detach" || "${1:-}" == "--big" || "${1:-}" == "--from" ]]; do
  case "$1" in
    --no-tmux) IWORK_NO_TMUX=1 ;;
    --no-context) IWORK_NO_CONTEXT=1 ;;
    --detach) IWORK_DETACH=1 ;;
    --big) IWORK_BIG=1 ;;
    --from)
      shift
      [[ $# -gt 0 ]] || die "--from needs a task or branch name"
      BASE_SPEC="$1"
      validate_base_spec "$BASE_SPEC"
      ;;
  esac
  shift
  if [[ $# -eq 0 ]]; then
    usage 1
  fi
done

case "${1:-}" in
  -h|--help)
    usage 0
    ;;
  --completion)
    case "${2:-}" in
      bash)
        print_bash_completion
        exit 0
        ;;
      zsh)
        print_zsh_completion
        exit 0
        ;;
      *)
        die "expected 'bash' or 'zsh' after --completion"
        ;;
    esac
    ;;
  --complete-repos)
    require_config
    list_repos "${2:-}"
    exit 0
    ;;
  --complete-worktree-folders)
    require_config
    list_worktree_folders "${2:-}"
    exit 0
    ;;
  --complete-task-worktrees)
    require_config
    list_task_worktree_names "${2:-}" "${3:-}"
    exit 0
    ;;
  --complete-projects)
    require_config
    list_projects "${2:-}"
    exit 0
    ;;
  --resolve-worktree-folder)
    require_config
    resolve_worktree_folder "${2:-}"
    exit 0
    ;;
  --resolve-park-target-path)
    require_config
    resolve_park_target_path "${2:-}"
    exit 0
    ;;
  --switch-task-window)
    tmux_enabled || exit 1
    validate_worktree_folder_name "${2:-}"
    switch_window_id="$(find_task_window "${2:-}")" || exit 1
    switch_to_window "$switch_window_id" || exit 1
    exit 0
    ;;
  --hook)
    handle_claude_hook
    ;;
esac

if [[ "${1:-}" == "init" ]]; then
  if [[ $# -ne 1 ]]; then
    die "usage: iwork init"
  fi

  run_init
  exit 0
fi

if [[ "${1:-}" == "project" ]]; then
  shift
  cmd_project "$@"
  exit $?
fi

case "${1:-}" in
  todo|log|decided|done|drop)
    capture_verb="$1"
    shift
    cmd_capture "$capture_verb" "$@"
    exit 0
    ;;
esac

if [[ "${1:-}" == "list" && $# -eq 1 ]]; then
  require_config
  if tmux_enabled; then
    list_worktree_folders_with_status
  else
    list_worktree_folders
  fi
  exit 0
fi

if [[ "${1:-}" == "park" ]]; then
  shift
  park_folder=""
  park_project=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--project)
        [[ $# -ge 2 ]] || die "expected a project name after $1"
        park_project="$2"
        validate_project_name "$park_project"
        shift 2
        ;;
      -*)
        die "unknown option '$1'"
        ;;
      *)
        [[ -z "$park_folder" ]] || die "usage: iwork park <task> [-p <project>]"
        park_folder="$1"
        shift
        ;;
    esac
  done

  [[ -n "$park_folder" ]] || die "usage: iwork park <task> [-p <project>]"

  require_config
  # Before ensure_project, or an invalid task name leaves a freshly created and
  # entirely useless project directory behind.
  validate_worktree_folder_name "$park_folder"

  if [[ -n "$park_project" ]]; then
    require_projects_dir
    validate_project_name "$park_project"

    if project_exists "$park_folder"; then
      die "'$park_folder' is already a project; a task cannot share a name with a project"
    fi

    # park stashes and moves a real branch, so confirm before any of that.
    ensure_project "$park_project"
  fi

  park_current_repo "$park_folder" "$park_project"
  exit 0
fi

if [[ "${1:-}" == "install-hooks" ]]; then
  if [[ $# -gt 2 ]]; then
    die "usage: iwork install-hooks [settings-path]"
  fi

  install_claude_hooks "${2:-$HOME/.claude/settings.json}"
  exit 0
fi

if [[ "${1:-}" == "rm" ]]; then
  shift
  rm_force=""
  rm_current=""
  rm_positional=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force)
        rm_force=1
        shift
        ;;
      --current)
        rm_current=1
        shift
        ;;
      -r)
        break
        ;;
      *)
        rm_positional+=("$1")
        shift
        ;;
    esac
  done

  require_config

  # rm deletes worktrees, so inferring the task from the directory has to be
  # asked for. A bare 'iwork rm' meaning "this one" is one typo away from
  # destroying the task you are standing in, and -f skips the confirmation
  # that would otherwise catch it.
  if (( ${#rm_positional[@]} == 0 )); then
    [[ -n "$rm_current" ]] ||
      die "usage: iwork rm [-f] <task> [-r <repo1> [repo2 ...]]
  Use --current for the task you are standing in."
    folder_name="$(resolve_task_arg "")"
    echo "Using the current task: $folder_name"
  elif (( ${#rm_positional[@]} == 1 )); then
    [[ -z "$rm_current" ]] || die "pass a task name or --current, not both"
    folder_name="${rm_positional[0]}"
    validate_worktree_folder_name "$folder_name"
  else
    die "usage: iwork rm [-f] [--current | <task>] [-r <repo1> [repo2 ...]]"
  fi

  repos=()
  if [[ $# -gt 0 ]]; then
    parse_repos_flag "expected -r <repos> after task name" "$@"
  fi

  remove_worktrees "$folder_name" "$rm_force" "${repos[@]+${repos[@]}}"
  exit 0
fi

if [[ "${1:-}" == "add-repo" ]]; then
  shift
  require_config

  # A leading flag means the task name was left out, so use the current one.
  case "${1:-}" in
    ""|-*)
      folder_name="$(resolve_task_arg "")"
      ;;
    *)
      folder_name="$(resolve_task_arg "$1")"
      shift
      ;;
  esac

  if [[ "${1:-}" == "--from" ]]; then
    shift
    [[ $# -gt 0 ]] || die "--from needs a task or branch name"
    BASE_SPEC="$1"
    validate_base_spec "$BASE_SPEC"
    shift
  fi

  parse_repos_flag "expected -r <repos> after folder name" "$@"

  branch="$(detect_branch_from_worktree_folder "$folder_name")"

  create_worktrees "$branch" "$folder_name" "${repos[@]}"
  refresh_task_blocks "$folder_name" "$branch"
  extend_task_session "$folder_name"
  exit 0
fi

if [[ "${1:-}" == "cd" && "${2:-}" != "-r" ]]; then
  if [[ $# -ne 2 ]]; then
    die "usage: iwork cd <task>"
  fi

  die "'iwork cd' must be run through sourced shell integration. Run: source <(iwork --completion bash) or source <(iwork --completion zsh)"
fi

if [[ "${1:-}" == "claude" && "${2:-}" != "-r" ]]; then
  if [[ $# -lt 2 ]]; then
    die "usage: iwork claude <task> [claude-args...]"
  fi

  run_tool_in_worktree claude "$2" "${@:3}"
fi

if [[ "${1:-}" == "codex" && "${2:-}" != "-r" ]]; then
  if [[ $# -lt 2 ]]; then
    die "usage: iwork codex <task> [codex-args...]"
  fi

  run_tool_in_worktree codex "$2" "${@:3}"
fi

branch="$1"
shift

require_config
validate_branch "$branch"

parse_task_args "$@"

# Folder name: replace / with -
folder_name="${branch//\//-}"

# Fail before creating anything: a task and a project that share a name would
# compete for the same tmux window, and the status hook could not tell them
# apart.
if [[ -n "$PROJECT_FLAG" ]]; then
  require_projects_dir
  validate_project_name "$PROJECT_FLAG"

  if project_exists "$folder_name"; then
    die "'$folder_name' is already a project; a task cannot share a name with a project"
  fi

  # Prompt and create up front: aborting here must leave nothing behind.
  ensure_project "$PROJECT_FLAG"
fi

create_worktrees "$branch" "$folder_name" "${repos[@]}"
write_task_context "$folder_name" "$branch"

if [[ -n "$PROJECT_FLAG" ]]; then
  attach_task_to_project "$folder_name" "$PROJECT_FLAG" "$branch"
fi

open_task "$folder_name" claude
